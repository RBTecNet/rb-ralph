#!/usr/bin/env bash
set -euo pipefail

resolve_real_path() {
  local source="$1" directory target
  while [ -L "$source" ]; do
    directory="$(cd -P "$(dirname "$source")" && pwd)"
    target="$(readlink "$source")"
    if [[ "$target" == /* ]]; then source="$target"; else source="$directory/$target"; fi
  done
  directory="$(cd -P "$(dirname "$source")" && pwd)"
  printf '%s/%s\n' "$directory" "$(basename "$source")"
}

