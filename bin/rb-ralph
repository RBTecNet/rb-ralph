print_brand() {
  cat <<'BRAND'
█▀█ █▄▄   █▀█ ▄▀█ █░░ █▀█ █░█           ╭─╮          ╭─╮
█▀▄ █▄█   █▀▄ █▀█ █▄▄ █▀▀ █▀█         ╭─╯ ╰──────────╯ ╰─╮
     AUTONOMOUS CONTROL PLANE         │     ◕      ◕     │
                                      ╰──╮  ╭──────╮  ╭──╯
                                         ╰──┤ ▪  ▪ ├──╯
                                            ╰──◡◡──╯          RALPH · capivara de plantão
BRAND
}

# Cosmetic-only startup animation. Any failure is swallowed so a missing helper,
# an unusual terminal, or a Ctrl-C never changes how the run itself behaves.
play_splash() {
  [ "${RB_RALPH_SPLASH_SHOWN:-0}" != "1" ] || return 0
  [ -t 1 ] || return 0
  [ -f "$SPLASH_HELPER" ] || return 0
  command -v node >/dev/null 2>&1 || return 0
  RB_RALPH_SPLASH=1 node "$SPLASH_HELPER" --version "$RB_RALPH_VERSION" || true
  export RB_RALPH_SPLASH_SHOWN=1
}

usage() {
  print_brand
  printf '\n'
  cat <<'USAGE'
Usage:
  rb-ralph [options]
  rb-ralph --wizard
  rb-ralph --login
  rb-ralph provider list|test [options]
  rb-ralph profile list|show <name>|delete <name>|path

Quick start:
  # Start the interactive command builder
  rb-ralph

  # Reuse a saved execution strategy; explicit flags override the profile
  rb-ralph --profile my-team --project /path/to/project --plan <artifact-id>

  # Install for the current user, then ensure ~/.local/bin is on PATH
  ./rb-ralph.sh --install --prefix "$HOME/.local"

  # Inspect a project without creating execution state
  rb-ralph --project /path/to/project --list
  rb-ralph --project /path/to/project --plan <artifact-id> --dry-run

  # Consume plans generated by another compatible harness
  rb-ralph --project /path/to/project --artifacts-dir .spec --list

  # Execute with Codex as executor and inherited manager
  rb-ralph --project /path/to/project --plan <artifact-id> --provider codex --dashboard

  # Watch the newest observable run from another terminal
  rb-ralph-watch --project /path/to/project

  # Use a different manager explicitly
  rb-ralph --project . --agent-provider claude --agent-model sonnet --agent-effort high \
    --manager-provider codex --manager-model gpt-5.6-sol --manager-effort xhigh

  # Select different models exposed through OpenCode
  rb-ralph --project . --provider opencode \
    --agent-model deepseek/deepseek-chat --manager-model anthropic/claude-opus-4-1

  # Use one custom adapter command for both independent calls
  rb-ralph --project . --agent-cmd /path/to/adapter

  # Configure and use native APIs without routing through another model CLI
  rb-ralph --login
  rb-ralph provider list
  rb-ralph provider test
  rb-ralph provider test --provider deepseek --model deepseek-v4-pro \
    --credential pessoal
  rb-ralph --project . --provider deepseek --model deepseek-v4-pro \
    --credential pessoal --yolo --dashboard

The executor is primary. Unless --manager-provider or --manager-cmd is given,
the manager inherits the executor's provider/command and model configuration.
Executor and manager are always separate ephemeral calls; no chat session is
shared. Run `rb-ralph --help` from any directory after installation.
Token counts come from provider telemetry. Costs are provider-reported when
available or estimated only with --pricing-file; unavailable values stay clear.
The RB Ralph executor defaults to YOLO: its provider permission checks and
sandbox are bypassed. G3 managers always receive protected/read-only authority.
Use --protected explicitly when the executor must also be constrained.
CLI providers: codex, claude, opencode. Direct API providers: openai,
anthropic, gemini, deepseek, minimax, openrouter. Direct API executors require
an explicit model and --yolo; their managers remain read-only.

Options:
  --wizard              Start the interactive command builder
  --login               Configure shared direct-API credentials interactively
  --profile <name>       Load a built-in or user execution profile
  --project <path>       Project root (default: current directory)
  --plan <id-or-path>    Execution-plan artifact ID or manifest path
  --artifacts-dir <dir>  Artifact/fragment root (default: .rb; alias: --fragments-dir)
  --core-cli <path>      RB Harness contract CLI (highest discovery precedence)
  --agent-cmd <command>  Executable that reads an implementation prompt on stdin
  --manager-cmd <cmd>    Executable that reads a review prompt on stdin
  --provider <name>      Shared CLI or direct API provider
  --agent-provider <n>   Executor provider (CLI or direct API)
  --manager-provider <n> Manager provider (CLI or direct API)
  --model <id>           Shared model for executor and manager
  --agent-model <id>     Executor model; manager inherits with the same adapter
  --manager-model <id>   Explicit manager model override
  --effort <level>       Shared reasoning effort for executor and manager
  --agent-effort <level> Executor effort; manager inherits with the same adapter
  --manager-effort <lvl> Explicit manager reasoning-effort override
  --credential <ref>     Shared saved direct-API credential ID or label
  --agent-credential <r> Executor saved credential override
  --manager-credential <r> Manager saved credential override
  --max-attempts <n>     No-progress attempts before strategy recovery (default: 3)
  --max-total-attempts N Hard phase safety cap per invocation (default: 12; 0 disables)
  --max-strategy-resets N Recovery escalations before pausing (default: 1)
  --manager-retries <n>  Same-evidence manager retries for provider/protocol errors (default: 3)
  --manager-retry-wait N Seconds between manager retries (default: 5)
  --agent-timeout <n>   Executor wall-clock limit in seconds (default: 3600; 0 disables)
  --agent-idle-timeout N Executor output-idle limit in seconds (default: 300; 0 disables)
  --agent-first-output-timeout N Executor first-output limit (default: 300; 0 disables)
  --manager-timeout <n> Manager wall-clock limit in seconds (default: 900; 0 disables)
  --manager-idle-timeout N Manager output-idle limit in seconds (default: 180; 0 disables)
  --manager-first-output-timeout N Manager first-output limit (default: 180; 0 disables)
  --manager-audit <mode> exhaustive or legacy (default: exhaustive)
  --manager-review <mode>
                         delivery or code (default: delivery). delivery accepts
                         a phase once the executor delivered what the fragment
                         asked for; code also audits the changed source for
                         defects the criteria did not name
  --execution-unit <m>  task or phase; fresh call boundary (default: task)
  --validation-mode <m>  run or manager (default: run)
  --validation-timeout N Per-command timeout in seconds (default: 900; 0 disables)
  --parallel <n>         Maximum independent task agents (default: 1)
  --max-prompt-bytes <n> Reject larger prompts (default: 262144; 0 disables)
  --rate-limit-wait <n>  Fallback wait in seconds (default: 60)
  --max-limit-waits <n>  Maximum provider-limit waits per phase (default: 20)
  --max-limit-wait <n>   Cap one provider-requested wait (default: 3600 seconds)
  --isolation <mode>     shared or worktree; parallel execution requires worktree
  --no-agent-context     Do not pre-load task scope, phase context, and project
                         tree into the executor prompt (it is on by default)
  --agent-context-bytes <n>
                         Byte budget for that pre-loaded context (default: 49152)
  Context activity limits are configured with RB_RALPH_CONTEXT_SOFT_COMMAND_LIMIT,
  RB_RALPH_CONTEXT_SOFT_OUTPUT_BYTES, RB_RALPH_CONTEXT_HARD_COMMAND_LIMIT, and
  RB_RALPH_CONTEXT_HARD_OUTPUT_BYTES. Soft limits only warn; hard limits default
  to 0 (disabled) and pause recoverably when explicitly enabled.
  --memory-url <url>     Optional RB Memory Streamable HTTP MCP URL
  --memory-mode <mode>   off, required, or best-effort (default: required with URL)
  --memory-token-env <n> Bearer-token environment variable (default: RB_MEMORY_TOKEN)
  --memory-cli <path>    RB Memory CLI used as the MCP client
  --pricing-file <path>  Per-model token prices used for cost estimates
  --operations <path>    rb-operational/v1 contract (default: auto-discover OPERATIONS.json)
  --final-audit          Run independent clean-room operational acceptance (default)
  --no-final-audit       Explicitly skip the final operational acceptance phase
  --yolo                 Bypass provider permissions/sandbox (default)
  --protected            Enable each provider's protected role defaults
  --splash               Play the launch splash animation and exit
  --no-splash            Skip the launch splash for this invocation
  --dashboard, --tui     Show the live terminal dashboard during execution
  --no-dashboard         Disable a dashboard enabled by a profile
  --watch                Watch the latest run; equivalent to rb-ralph-watch
  --dry-run              Validate and show the selected phase schedule
  --list                 List ready execution plans and exit
  -V, --ver, --version   Show the installed RB Ralph version and exit
  -h, --help             Show this help

Environment equivalents:
  RB_RALPH_HOME, RB_RALPH_CORE_CLI, RB_RALPH_ARTIFACTS_DIR,
  RB_RALPH_PROFILES_FILE,
  RB_RALPH_AGENT_CMD, RB_RALPH_MANAGER_CMD,
  RB_RALPH_AGENT_PROVIDER, RB_RALPH_MANAGER_PROVIDER,
  RB_RALPH_MODEL, RB_RALPH_AGENT_MODEL, RB_RALPH_MANAGER_MODEL,
  RB_RALPH_EFFORT, RB_RALPH_AGENT_EFFORT, RB_RALPH_MANAGER_EFFORT,
  RB_RALPH_CREDENTIAL, RB_RALPH_AGENT_CREDENTIAL, RB_RALPH_MANAGER_CREDENTIAL,
  RB_RALPH_MAX_ATTEMPTS, RB_RALPH_MAX_TOTAL_ATTEMPTS,
  RB_RALPH_MAX_STRATEGY_RESETS, RB_RALPH_MAX_MANAGER_RETRIES,
  RB_RALPH_MANAGER_RETRY_WAIT, RB_RALPH_MAX_INCOMPLETE_RETRIES,
  RB_RALPH_AGENT_TIMEOUT,
  RB_RALPH_AGENT_IDLE_TIMEOUT, RB_RALPH_MANAGER_TIMEOUT,
  RB_RALPH_AGENT_FIRST_OUTPUT_TIMEOUT, RB_RALPH_MANAGER_IDLE_TIMEOUT,
  RB_RALPH_MANAGER_FIRST_OUTPUT_TIMEOUT, RB_RALPH_MANAGER_AUDIT_MODE,
  RB_RALPH_MANAGER_REVIEW,
  RB_RALPH_EXECUTION_UNIT, RB_RALPH_VALIDATION_MODE,
  RB_RALPH_VALIDATION_TIMEOUT, RB_RALPH_PARALLEL,
  RB_RALPH_MAX_PROMPT_BYTES, RB_RALPH_RATE_LIMIT_WAIT,
  RB_RALPH_MAX_RATE_LIMIT_WAITS, RB_RALPH_MAX_RATE_LIMIT_WAIT,
  RB_RALPH_CONTEXT_SOFT_COMMAND_LIMIT, RB_RALPH_CONTEXT_SOFT_OUTPUT_BYTES,
  RB_RALPH_CONTEXT_HARD_COMMAND_LIMIT, RB_RALPH_CONTEXT_HARD_OUTPUT_BYTES,
  RB_RALPH_ISOLATION, RB_RALPH_MEMORY_MCP_URL, RB_RALPH_MEMORY_MODE,
  RB_RALPH_MEMORY_TOKEN_ENV, RB_RALPH_MEMORY_CLI, RB_RALPH_PRICING_FILE,
  RB_RALPH_FINAL_AUDIT, RB_RALPH_OPERATIONAL_CONTRACT,
  RB_RALPH_SPLASH (0 or 1), RB_RALPH_SPLASH_MS,
  RB_RALPH_PERMISSION_MODE (yolo or protected; default: yolo)

Provider command protocol:
  Commands run from the project root, receive the prompt on stdin, and receive
  RB_RALPH_ROLE, RB_RALPH_PROJECT_ROOT, RB_RALPH_PLAN_PATH,
  RB_RALPH_PHASE_ID and RB_RALPH_ATTEMPT. Task agents also receive
  RB_RALPH_TASK_ID. Executors receive RB_RALPH_AGENT_EVIDENCE_DIR, an isolated
  submission directory; orchestrator-owned logs under .rb/runs are never
  exposed as writable executor output.
  Every call receives RB_RALPH_TELEMETRY_FILE for an optional
  rb-ralph-usage/v1 record, RB_RALPH_MODEL and RB_RALPH_EFFORT for the current
  call, both resolved role model/effort values, plus RB_RALPH_PERMISSION_MODE
  and RB_RALPH_YOLO.
  Custom adapters must honor protected mode or fail clearly if unsupported.
  Manager adapters also receive RB_RALPH_VALIDATION_LOG,
  RB_RALPH_EVIDENCE_INDEX, RB_RALPH_CHANGED_PATHS_FILE, RB_RALPH_AGENT_EXIT_CODE, and
  RB_RALPH_PHASE_TITLE. Custom manager adapters must have read access to the
  project and these evidence files.

Manager output protocol:
  RB_RALPH_AUDIT_STATUS: COMPLETE
  RB_RALPH_CRITERION: <required-id> | <status> | <evidence>
  RB_RALPH_FINDING: <criterion-ids> | <boundary> | <expected> | <observed> | <evidence>
  RB_RALPH_DECISION: COMPLETE | RETRY | BLOCKED
  RB_RALPH_REASON: <short reason>
USAGE
}

print_version() {
  printf 'RB Ralph %s\n' "$RB_RALPH_VERSION"
}

die() {
  if [ "${DASHBOARD_ACTIVE:-0}" -eq 1 ]; then
    DASHBOARD_ACTIVITY="$*"
    DASHBOARD_REASON="$*"
    dashboard_finish failed >/dev/null 2>&1 || true
    wait_dashboard
  fi
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

log() {
  if [ "$DASHBOARD_ACTIVE" -eq 1 ]; then
    printf '[rb-ralph] %s\n' "$*" >> "$DASHBOARD_LOG"
  else
    printf '[rb-ralph] %s\n' "$*"
  fi
}

memory_cli_call() {
  if [[ "$MEMORY_CLI" == *.js ]]; then
    node "$MEMORY_CLI" "$@"
  else
    "$MEMORY_CLI" "$@"
  fi
}

memory_failure() {
  local message="$1"
  if [ "$MEMORY_MODE" = "required" ]; then
    die "$message"
  fi
  log "memory best-effort warning: $message"
  return 0
}

sync_memory_bootstrap() {
  [ "$MEMORY_MODE" != "off" ] || return 0
  local temporary="$MEMORY_CONTEXT_FILE.tmp.$$"
  if memory_cli_call remote-bootstrap "$MEMORY_PROJECT_ID" \
    --url "$MEMORY_MCP_URL" --token-env "$MEMORY_TOKEN_ENV" \
    --project-name "$MEMORY_PROJECT_NAME" --limit 20 --content-budget 32000 \
    > "$temporary"; then
    mv "$temporary" "$MEMORY_CONTEXT_FILE"
    log "memory context loaded for project=$MEMORY_PROJECT_ID"
  else
    rm -f "$temporary"
    memory_failure "could not bootstrap RB Memory project $MEMORY_PROJECT_ID"
  fi
}

sync_memory_checkpoint() {
  local checkpoint_file="$1" checkpoint_result="$2" phase="$3" phase_title="$4" completion_reason="$5" validation_log="$6"
  [ "$MEMORY_MODE" != "off" ] || return 0
  [ ! -s "$checkpoint_result" ] || return 0
  RB_MEMORY_PROJECT_ID="$MEMORY_PROJECT_ID" RB_MEMORY_PHASE_ID="$phase" \
  RB_MEMORY_PHASE_TITLE="$phase_title" RB_MEMORY_COMPLETION_REASON="$completion_reason" \
  RB_MEMORY_RUN_ID="$RUN_ID" RB_MEMORY_VALIDATION_LOG="$validation_log" \
    node -e '
      const value = {
        projectId: process.env.RB_MEMORY_PROJECT_ID,
        objective: `Complete ${process.env.RB_MEMORY_PHASE_ID}: ${process.env.RB_MEMORY_PHASE_TITLE}`,
        completed: [process.env.RB_MEMORY_COMPLETION_REASON],
        nextSteps: ["Continue with the next pending phase in the validated execution plan, or perform final review when none remain."],
        blockers: [],
        changedPaths: [],
        validations: process.env.RB_MEMORY_VALIDATION_LOG ? [process.env.RB_MEMORY_VALIDATION_LOG] : [],
        scope: `execution/${process.env.RB_MEMORY_RUN_ID}/${process.env.RB_MEMORY_PHASE_ID}`,
        source: { actor: "rb-ralph", client: "rb-ralph", runId: process.env.RB_MEMORY_RUN_ID }
      };
      process.stdout.write(JSON.stringify(value));
    ' > "$checkpoint_file"
  if memory_cli_call remote-checkpoint "$checkpoint_file" \
    --url "$MEMORY_MCP_URL" --token-env "$MEMORY_TOKEN_ENV" > "$checkpoint_result"; then
    log "$phase checkpoint stored in RB Memory"
  else
    rm -f "$checkpoint_result"
    memory_failure "could not store RB Memory checkpoint for $phase"
  fi
}

resolve_command() {
  local value="$1" label="$2"
  [ -n "$value" ] || die "$label is required for execution"
  if [[ "$value" == */* ]]; then
    [ -x "$value" ] || die "$label is not executable: $value"
  else
    command -v "$value" >/dev/null 2>&1 || die "$label was not found on PATH: $value"
  fi
}

core_cli_call() {
  if [[ "$CORE_CLI" == *.js || "$CORE_CLI" == *.cjs || "$CORE_CLI" == *.mjs ]]; then
    node "$CORE_CLI" "$@"
  else
    "$CORE_CLI" "$@"
  fi
}

resolve_core_cli() {
  local candidate source
  if [ -n "$CORE_CLI_OPTION" ]; then
    candidate="$CORE_CLI_OPTION"
    source="--core-cli"
  elif [ -n "$CORE_CLI_ENV" ]; then
    candidate="$CORE_CLI_ENV"
    source="RB_RALPH_CORE_CLI"
  elif [ -f "$PACKAGED_CORE_CLI" ]; then
    candidate="$PACKAGED_CORE_CLI"
    source="packaged installation"
  elif [ -x "$PACKAGED_CORE_EXECUTABLE" ]; then
    candidate="$PACKAGED_CORE_EXECUTABLE"
    source="packaged installation"
  elif command -v rb-harness >/dev/null 2>&1; then
    candidate="$(command -v rb-harness)"
    source="PATH"
  else
    die "RB Harness contract CLI was not found. Use --core-cli <path>, set RB_RALPH_CORE_CLI, reinstall RB Ralph with its packaged core, or put rb-harness on PATH"
  fi

  if [[ "$candidate" == */* && "$candidate" != /* ]]; then
    candidate="$INVOCATION_DIR/$candidate"
  fi
  if [[ "$candidate" == *.js || "$candidate" == *.cjs || "$candidate" == *.mjs ]]; then
    [ -f "$candidate" ] || die "RB Harness contract CLI selected by $source does not exist: $candidate"
    command -v node >/dev/null 2>&1 || die "Node.js is required to run RB Harness contract CLI: $candidate"
  elif [[ "$candidate" == */* ]]; then
    [ -x "$candidate" ] || die "RB Harness contract CLI selected by $source is not executable: $candidate"
  else
    command -v "$candidate" >/dev/null 2>&1 || die "RB Harness contract CLI selected by $source was not found on PATH: $candidate"
    candidate="$(command -v "$candidate")"
  fi
  CORE_CLI="$candidate"
}

is_direct_provider() {
  case "$1" in
    openai|anthropic|gemini|deepseek|minimax|openrouter) return 0 ;;
    *) return 1 ;;
  esac
}

provider_command() {
  case "$1" in
    codex|claude|opencode) printf '%s/adapters/%s.sh\n' "$RB_RALPH_HOME" "$1" ;;
    openai|anthropic|gemini|deepseek|minimax|openrouter) printf '%s/adapters/api.sh\n' "$RB_RALPH_HOME" ;;
    *) die "Unsupported provider '$1'; use codex, claude, opencode, openai, anthropic, gemini, deepseek, minimax, openrouter, or a custom adapter command" ;;
  esac
}

provider_configured_model() {
  local provider="$1" role="$2"
  case "$provider:$role" in
    codex:agent) printf '%s' "${RB_RALPH_CODEX_AGENT_MODEL:-${RB_RALPH_CODEX_MODEL:-}}" ;;
    codex:manager) printf '%s' "${RB_RALPH_CODEX_MANAGER_MODEL:-${RB_RALPH_CODEX_MODEL:-}}" ;;
    claude:agent) printf '%s' "${RB_RALPH_CLAUDE_AGENT_MODEL:-${RB_RALPH_CLAUDE_MODEL:-}}" ;;
    claude:manager) printf '%s' "${RB_RALPH_CLAUDE_MANAGER_MODEL:-${RB_RALPH_CLAUDE_MODEL:-}}" ;;
    opencode:agent) printf '%s' "${RB_RALPH_OPENCODE_AGENT_MODEL:-${RB_RALPH_OPENCODE_MODEL:-}}" ;;
    opencode:manager) printf '%s' "${RB_RALPH_OPENCODE_MANAGER_MODEL:-${RB_RALPH_OPENCODE_MODEL:-}}" ;;
  esac
}

provider_configured_effort() {
  local provider="$1" role="$2"
  case "$provider:$role" in
    codex:agent) printf '%s' "${RB_RALPH_CODEX_AGENT_EFFORT:-${RB_RALPH_CODEX_EFFORT:-}}" ;;
    codex:manager) printf '%s' "${RB_RALPH_CODEX_MANAGER_EFFORT:-${RB_RALPH_CODEX_EFFORT:-}}" ;;
    claude:agent) printf '%s' "${RB_RALPH_CLAUDE_AGENT_EFFORT:-${RB_RALPH_CLAUDE_EFFORT:-}}" ;;
    claude:manager) printf '%s' "${RB_RALPH_CLAUDE_MANAGER_EFFORT:-${RB_RALPH_CLAUDE_EFFORT:-}}" ;;
    opencode:agent) printf '%s' "${RB_RALPH_OPENCODE_AGENT_EFFORT:-${RB_RALPH_OPENCODE_EFFORT:-}}" ;;
    opencode:manager) printf '%s' "${RB_RALPH_OPENCODE_MANAGER_EFFORT:-${RB_RALPH_OPENCODE_EFFORT:-}}" ;;
  esac
}

validate_effort() {
  local role="$1" value="$2"
  [ -z "$value" ] || [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || \
    die "$role effort must be a provider-supported token containing only letters, numbers, dot, underscore, or hyphen"
}

preflight_provider() {
  local provider="$1" role="$2" binary=""
  case "$provider" in
    codex) binary="${RB_RALPH_CODEX_BIN:-codex}" ;;
    claude) binary="${RB_RALPH_CLAUDE_BIN:-claude}" ;;
    opencode) binary="${RB_RALPH_OPENCODE_BIN:-opencode}" ;;
    openai|anthropic|gemini|deepseek|minimax|openrouter)
      [ -n "$CORE_CLI" ] || die "$role direct API provider requires the packaged RB Harness core"
      return 0
      ;;
    "") return 0 ;;
  esac
  resolve_command "$binary" "$role $provider CLI"
}

configure_credentials() {
  local manager_explicit=0 same_adapter=0
  AGENT_CREDENTIAL="$ENV_AGENT_CREDENTIAL"
  MANAGER_CREDENTIAL="$ENV_MANAGER_CREDENTIAL"
  [ -z "$MANAGER_CREDENTIAL" ] || manager_explicit=1
  if [ -n "$ENV_SHARED_CREDENTIAL" ]; then
    AGENT_CREDENTIAL="$ENV_SHARED_CREDENTIAL"
    MANAGER_CREDENTIAL="$ENV_SHARED_CREDENTIAL"
    manager_explicit=1
  fi
  if [ "$CLI_SHARED_CREDENTIAL_SET" -eq 1 ]; then
    AGENT_CREDENTIAL="$CLI_SHARED_CREDENTIAL"
    MANAGER_CREDENTIAL="$CLI_SHARED_CREDENTIAL"
    manager_explicit=1
  fi
  [ "$CLI_AGENT_CREDENTIAL_SET" -eq 0 ] || AGENT_CREDENTIAL="$CLI_AGENT_CREDENTIAL"
  if [ "$CLI_MANAGER_CREDENTIAL_SET" -eq 1 ]; then
    MANAGER_CREDENTIAL="$CLI_MANAGER_CREDENTIAL"
    manager_explicit=1
  fi
  if [ -n "$AGENT_PROVIDER" ] && [ "$AGENT_PROVIDER" = "$MANAGER_PROVIDER" ]; then
    same_adapter=1
  elif [ -z "$AGENT_PROVIDER" ] && [ -z "$MANAGER_PROVIDER" ] && [ "$AGENT_CMD" = "$MANAGER_CMD" ]; then
    same_adapter=1
  fi
  if [ "$manager_explicit" -eq 0 ] && [ "$same_adapter" -eq 1 ]; then MANAGER_CREDENTIAL="$AGENT_CREDENTIAL"; fi
  if ! is_direct_provider "$AGENT_PROVIDER" && [ -n "$AGENT_CREDENTIAL" ]; then
    die "executor --credential is valid only with a direct API provider"
  fi
  if ! is_direct_provider "$MANAGER_PROVIDER" && [ -n "$MANAGER_CREDENTIAL" ]; then
    die "manager --credential is valid only with a direct API provider"
  fi
}

configure_models() {
  local manager_explicit=0 same_adapter=0
  AGENT_MODEL="$(provider_configured_model "$AGENT_PROVIDER" agent)"
  MANAGER_MODEL="$(provider_configured_model "$MANAGER_PROVIDER" manager)"
  [ -z "$MANAGER_MODEL" ] || manager_explicit=1

  if [ -n "$ENV_SHARED_MODEL" ]; then
    AGENT_MODEL="$ENV_SHARED_MODEL"
    MANAGER_MODEL="$ENV_SHARED_MODEL"
    manager_explicit=1
  fi
  [ -z "$ENV_AGENT_MODEL" ] || AGENT_MODEL="$ENV_AGENT_MODEL"
  if [ -n "$ENV_MANAGER_MODEL" ]; then
    MANAGER_MODEL="$ENV_MANAGER_MODEL"
    manager_explicit=1
  fi
  if [ "$CLI_SHARED_MODEL_SET" -eq 1 ]; then
    AGENT_MODEL="$CLI_SHARED_MODEL"
    MANAGER_MODEL="$CLI_SHARED_MODEL"
    manager_explicit=1
  fi
  [ "$CLI_AGENT_MODEL_SET" -eq 0 ] || AGENT_MODEL="$CLI_AGENT_MODEL"
  if [ "$CLI_MANAGER_MODEL_SET" -eq 1 ]; then
    MANAGER_MODEL="$CLI_MANAGER_MODEL"
    manager_explicit=1
  fi

  if [ -n "$AGENT_PROVIDER" ] && [ "$AGENT_PROVIDER" = "$MANAGER_PROVIDER" ]; then
    same_adapter=1
  elif [ -z "$AGENT_PROVIDER" ] && [ -z "$MANAGER_PROVIDER" ] && [ "$AGENT_CMD" = "$MANAGER_CMD" ]; then
    same_adapter=1
  fi
  if [ "$manager_explicit" -eq 0 ] && [ "$same_adapter" -eq 1 ]; then
    MANAGER_MODEL="$AGENT_MODEL"
  fi
}

configure_efforts() {
  local manager_explicit=0 same_adapter=0
  AGENT_EFFORT="$(provider_configured_effort "$AGENT_PROVIDER" agent)"
  MANAGER_EFFORT="$(provider_configured_effort "$MANAGER_PROVIDER" manager)"
  [ -z "$MANAGER_EFFORT" ] || manager_explicit=1

  if [ -n "$ENV_SHARED_EFFORT" ]; then
    AGENT_EFFORT="$ENV_SHARED_EFFORT"
    MANAGER_EFFORT="$ENV_SHARED_EFFORT"
    manager_explicit=1
  fi
  [ -z "$ENV_AGENT_EFFORT" ] || AGENT_EFFORT="$ENV_AGENT_EFFORT"
  if [ -n "$ENV_MANAGER_EFFORT" ]; then
    MANAGER_EFFORT="$ENV_MANAGER_EFFORT"
    manager_explicit=1
  fi
  if [ "$CLI_SHARED_EFFORT_SET" -eq 1 ]; then
    AGENT_EFFORT="$CLI_SHARED_EFFORT"
    MANAGER_EFFORT="$CLI_SHARED_EFFORT"
    manager_explicit=1
  fi
  [ "$CLI_AGENT_EFFORT_SET" -eq 0 ] || AGENT_EFFORT="$CLI_AGENT_EFFORT"
  if [ "$CLI_MANAGER_EFFORT_SET" -eq 1 ]; then
    MANAGER_EFFORT="$CLI_MANAGER_EFFORT"
    manager_explicit=1
  fi

  if [ -n "$AGENT_PROVIDER" ] && [ "$AGENT_PROVIDER" = "$MANAGER_PROVIDER" ]; then
    same_adapter=1
  elif [ -z "$AGENT_PROVIDER" ] && [ -z "$MANAGER_PROVIDER" ] && [ "$AGENT_CMD" = "$MANAGER_CMD" ]; then
    same_adapter=1
  fi
  if [ "$manager_explicit" -eq 0 ] && [ "$same_adapter" -eq 1 ]; then
    MANAGER_EFFORT="$AGENT_EFFORT"
  fi
  validate_effort executor "$AGENT_EFFORT"
  validate_effort manager "$MANAGER_EFFORT"
}

configure_roles() {
  [ "$CLI_AGENT_PROVIDER_SET" -eq 0 ] || [ "$CLI_AGENT_CMD_SET" -eq 0 ] || \
    die "Choose --agent-provider or --agent-cmd, not both"
  [ "$CLI_MANAGER_PROVIDER_SET" -eq 0 ] || [ "$CLI_MANAGER_CMD_SET" -eq 0 ] || \
    die "Choose --manager-provider or --manager-cmd, not both"
  [ -z "$ENV_AGENT_PROVIDER" ] || [ -z "$ENV_AGENT_CMD" ] || \
    die "Choose RB_RALPH_AGENT_PROVIDER or RB_RALPH_AGENT_CMD, not both"
  [ -z "$ENV_MANAGER_PROVIDER" ] || [ -z "$ENV_MANAGER_CMD" ] || \
    die "Choose RB_RALPH_MANAGER_PROVIDER or RB_RALPH_MANAGER_CMD, not both"

  AGENT_PROVIDER="$ENV_AGENT_PROVIDER"
  AGENT_CMD="$ENV_AGENT_CMD"
  MANAGER_PROVIDER="$ENV_MANAGER_PROVIDER"
  MANAGER_CMD="$ENV_MANAGER_CMD"

  if [ "$SHARED_PROVIDER_SET" -eq 1 ]; then
    AGENT_PROVIDER="$SHARED_PROVIDER"
    AGENT_CMD=""
    MANAGER_PROVIDER="$SHARED_PROVIDER"
    MANAGER_CMD=""
  fi
  if [ "$CLI_AGENT_PROVIDER_SET" -eq 1 ]; then
    AGENT_PROVIDER="$CLI_AGENT_PROVIDER"
    AGENT_CMD=""
  elif [ "$CLI_AGENT_CMD_SET" -eq 1 ]; then
    AGENT_CMD="$CLI_AGENT_CMD"
    AGENT_PROVIDER=""
  fi
  if [ "$CLI_MANAGER_PROVIDER_SET" -eq 1 ]; then
    MANAGER_PROVIDER="$CLI_MANAGER_PROVIDER"
    MANAGER_CMD=""
  elif [ "$CLI_MANAGER_CMD_SET" -eq 1 ]; then
    MANAGER_CMD="$CLI_MANAGER_CMD"
    MANAGER_PROVIDER=""
  fi

  if [ -z "$AGENT_PROVIDER" ] && [ -z "$AGENT_CMD" ]; then
    if [ -n "$MANAGER_PROVIDER" ] || [ -n "$MANAGER_CMD" ]; then
      die "Manager configuration requires a primary executor; set --agent-provider, --agent-cmd, or --provider"
    fi
    die "agent command is required for execution; set --agent-provider, --agent-cmd, or --provider"
  fi

  if [ -z "$MANAGER_PROVIDER" ] && [ -z "$MANAGER_CMD" ]; then
    MANAGER_PROVIDER="$AGENT_PROVIDER"
    MANAGER_CMD="$AGENT_CMD"
    MANAGER_INHERITS_AGENT=1
  elif [ "$CLI_MANAGER_PROVIDER_SET" -eq 0 ] && [ "$CLI_MANAGER_CMD_SET" -eq 0 ] \
    && [ -z "$ENV_MANAGER_PROVIDER" ] && [ -z "$ENV_MANAGER_CMD" ]; then
    MANAGER_INHERITS_AGENT=1
  fi

  [ -z "$AGENT_PROVIDER" ] || [ -z "$AGENT_CMD" ] || die "Choose provider or cmd for the agent, not both"
  [ -z "$MANAGER_PROVIDER" ] || [ -z "$MANAGER_CMD" ] || die "Choose provider or cmd for the manager, not both"

  if [ -n "$AGENT_PROVIDER" ]; then AGENT_CMD="$(provider_command "$AGENT_PROVIDER")"; fi
  if [ -n "$MANAGER_PROVIDER" ]; then MANAGER_CMD="$(provider_command "$MANAGER_PROVIDER")"; fi
  resolve_command "$AGENT_CMD" "agent command"
  resolve_command "$MANAGER_CMD" "manager command"
  configure_models
  configure_efforts
  configure_credentials
  if is_direct_provider "$AGENT_PROVIDER" && [ -z "$AGENT_MODEL" ]; then
    die "direct API executor $AGENT_PROVIDER requires --agent-model or --model"
  fi
  if is_direct_provider "$MANAGER_PROVIDER" && [ -z "$MANAGER_MODEL" ]; then
    die "direct API manager $MANAGER_PROVIDER requires --manager-model or --model"
  fi
  if is_direct_provider "$AGENT_PROVIDER" && [ "$PERMISSION_MODE" = "protected" ]; then
    die "direct API executors cannot provide an OS sandbox in --protected mode; use --yolo or a sandboxed codex/claude/opencode CLI provider"
  fi
  if [ -z "$MANAGER_PROVIDER" ]; then
    [ "${RB_RALPH_CUSTOM_MANAGER_CAPABILITY:-}" = "observational-v1" ] \
      || die "custom manager adapters cannot establish Ralph's mandatory observational protected capability; set RB_RALPH_CUSTOM_MANAGER_CAPABILITY=observational-v1 only for an adapter that enforces read-only operation, or use a built-in/direct API manager"
  fi
  preflight_provider "$AGENT_PROVIDER" executor
  preflight_provider "$MANAGER_PROVIDER" manager
}

record_event() {
  local phase="$1" attempt="$2" status="$3" reason="$4"
  reason="${reason//$'\t'/ }"
  reason="${reason//$'\n'/ }"
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$phase" "$attempt" "$status" "$reason" >> "$EVENTS_FILE"
}

record_finding() {
  local phase="$1" attempt="$2" reason="$3" fingerprint="$4" finding_id suffix=1 base_id
  reason="${reason//$'\t'/ }"
  reason="${reason//$'\n'/ }"
  if awk -F '\t' -v phase="$phase" -v reason="$reason" \
    '$2 == phase && $4 == "open" && $5 == reason { found=1 } END { exit(found ? 0 : 1) }' \
    "$FINDINGS_FILE"; then
    return 0
  fi
  base_id="F-${phase}-A$(printf '%03d' "$attempt")"
  finding_id="$base_id"
  while grep -Fq "${finding_id}"$'\t' "$FINDINGS_FILE"; do
    suffix=$((suffix + 1))
    finding_id="${base_id}-$(printf '%02d' "$suffix")"
  done
  printf '%s\t%s\t%s\topen\t%s\t%s\t\t\t\t\t%s\t%s\t%s\n' \
    "$finding_id" "$phase" "$attempt" "$reason" "$fingerprint" \
    "$reason" "$fingerprint" "$attempt" >> "$FINDINGS_FILE"
}

record_manager_findings() {
  local phase="$1" attempt="$2" report="$3" evidence_fingerprint="$4" fallback="$5"
  local report_decision=""
  if [ -s "$report" ]; then
    report_decision="$(node -e 'const r=JSON.parse(require("node:fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(r.decision??"")' "$report")"
  fi
  if [ "$report_decision" = "RETRY" ] && [ "$(node -e 'const r=JSON.parse(require("node:fs").readFileSync(process.argv[1],"utf8"));process.stdout.write((r.expected??[]).length ? "1" : "0")' "$report")" = "1" ]; then
    node "$MANAGER_AUDIT_HELPER" reconcile "$FINDINGS_FILE" "$report" \
      "$phase" "$attempt" "$evidence_fingerprint" >/dev/null \
      || die "$phase could not reconcile the exhaustive manager finding batch"
  else
    record_finding "$phase" "$attempt" "$fallback" "$evidence_fingerprint"
  fi
}

open_findings() {
  local phase="$1"
  [ -f "$FINDINGS_FILE" ] || return 0
  awk -F '\t' -v phase="$phase" \
    '$2 == phase && $4 == "open" {
      latest=($13 == "" ? $3 : $13); reason=($11 == "" ? $5 : $11)
      if (latest == $3) printf "- %s (attempt %s): %s\n", $1, $3, reason
      else printf "- %s (attempt %s, last seen %s): %s\n", $1, $3, latest, reason
    }' \
    "$FINDINGS_FILE"
}

resolve_findings() {
  local phase="$1" attempt="$2" fingerprint="$3" temporary
  [ -f "$FINDINGS_FILE" ] || return 0
  temporary="${FINDINGS_FILE}.tmp-$$"
  awk -F '\t' -v OFS='\t' -v phase="$phase" -v attempt="$attempt" -v fingerprint="$fingerprint" '
    NR == 1 { print; next }
    $2 == phase && $4 == "open" { $4="resolved"; $7=attempt; $8=fingerprint }
    { print }
  ' "$FINDINGS_FILE" > "$temporary"
  mv "$temporary" "$FINDINGS_FILE"
}

evidence_fingerprint() {
  node -e '
    const fs=require("node:fs"), crypto=require("node:crypto");
    const [changesPath, validationPath, root] = process.argv.slice(1);
    const changes=JSON.parse(fs.readFileSync(changesPath, "utf8"));
    const h=crypto.createHash("sha256");
    for (const kind of ["added", "modified", "deleted"]) {
      for (const path of [...(changes[kind] ?? [])].sort()) {
        h.update(`${kind}:${path}\0`);
        if (kind !== "deleted") {
          try { h.update(fs.readFileSync(require("node:path").resolve(root, path))); }
          catch { h.update("<unavailable>"); }
        }
      }
    }
    const validation=fs.readFileSync(validationPath, "utf8")
      .replace(/^phase=.*$/m, "phase=<normalized> attempt=<normalized> mode=<normalized>");
    h.update(validation);
    process.stdout.write(h.digest("hex"));
  ' "$@"
}

open_finding_has_same_evidence() {
  local phase="$1" fingerprint="$2"
  awk -F '\t' -v phase="$phase" -v fingerprint="$fingerprint" '
    $2 == phase && $4 == "open" && $6 == fingerprint { found=1 }
    END { exit(found ? 0 : 1) }
  ' "$FINDINGS_FILE"
}

manager_failure_summary() {
  local log_file="$1" exit_code="$2" provider="$3" model="$4"
  local label log_reference go_model
  label="$(dashboard_role_label "$provider" "$MANAGER_CMD" "$model" "$MANAGER_EFFORT")"
  log_reference="${log_file#"$PROJECT/"}"

  if grep -Fq 'RB_RALPH_PROCESS_STATUS: TIMEOUT' "$log_file"; then
    local timeout_kind timeout_limit
    timeout_kind="$(sed -n 's/^RB_RALPH_TIMEOUT_KIND:[[:space:]]*//p' "$log_file" | tail -n 1)"
    timeout_limit="$(sed -n 's/^RB_RALPH_TIMEOUT_LIMIT_SECONDS:[[:space:]]*//p' "$log_file" | tail -n 1)"
    printf '%s' "gerente $label excedeu o timeout ${timeout_kind:-configurado} de ${timeout_limit:-?}s (exit=$exit_code); a árvore do provider foi encerrada e a mesma evidência será revisada novamente; log=$log_reference"
  elif grep -Eiq 'insufficient balance|insufficient credits|credit balance.*(low|empty)|payment required' "$log_file"; then
    if [ "$provider" = "opencode" ] && [[ "$model" == opencode/* ]]; then
      go_model="opencode-go/${model#opencode/}"
      printf '%s' "gerente $label falhou (exit=$exit_code): saldo insuficiente no OpenCode Zen; este modelo usa o provider Zen. Para usar a assinatura Go, conecte 'OpenCode Go' com /connect e selecione --manager-model $go_model; log=$log_reference"
    elif [ "$provider" = "opencode" ] && [[ "$model" == opencode-go/* ]]; then
      printf '%s' "gerente $label falhou (exit=$exit_code): saldo ou limite indisponível no OpenCode Go; confirme em 'opencode auth list' que OpenCode Go está conectado e verifique os limites/workspace da assinatura; log=$log_reference"
    else
      printf '%s' "gerente $label falhou (exit=$exit_code): saldo/créditos insuficientes no provider; verifique faturamento e limites da conta; log=$log_reference"
    fi
  elif grep -Eiq 'OpenCode CLI not found|command not found.*opencode|opencode: (not found|No such file)' "$log_file"; then
    printf '%s' "gerente $label falhou (exit=$exit_code): executável OpenCode não encontrado no PATH; recarregue o shell ou defina RB_RALPH_OPENCODE_BIN com o caminho absoluto; log=$log_reference"
  elif grep -Eiq 'Provider not found|unknown provider' "$log_file"; then
    printf '%s' "gerente $label falhou (exit=$exit_code): provider não encontrado ou não conectado; execute /connect no OpenCode e confirme com 'opencode auth list' e 'opencode models'; log=$log_reference"
  elif grep -Eiq 'model.*(not found|unknown|invalid|unavailable)|unknown model|ProviderModelNotFound' "$log_file"; then
    printf '%s' "gerente $label falhou (exit=$exit_code): modelo não encontrado ou indisponível; use o identificador completo exibido por 'opencode models', no formato provider/model; log=$log_reference"
  elif grep -Eiq 'unauthori[sz]ed|authentication failed|invalid api key|invalid token|(^|[^0-9])401([^0-9]|$)' "$log_file"; then
    printf '%s' "gerente $label falhou (exit=$exit_code): autenticação rejeitada pelo provider; reconecte a conta e confira a credencial configurada; log=$log_reference"
  elif grep -Eiq 'forbidden|permission denied|(^|[^0-9])403([^0-9]|$)' "$log_file"; then
    printf '%s' "gerente $label falhou (exit=$exit_code): acesso negado pelo provider; confira permissões, assinatura, workspace e disponibilidade do modelo; log=$log_reference"
  elif grep -Eiq 'timed? out|timeout|deadline exceeded' "$log_file"; then
    printf '%s' "gerente $label falhou (exit=$exit_code): chamada ao provider expirou; verifique conectividade/serviço e tente novamente; log=$log_reference"
  else
    printf '%s' "gerente $label falhou (exit=$exit_code) sem uma decisão válida; consulte o log completo em $log_reference"
  fi
}

last_phase_status() {
  local phase="$1"
  [ -f "$EVENTS_FILE" ] || return 0
  awk -F '\t' -v phase="$phase" '$2 == phase { status=$4 } END { if (status != "") print status }' "$EVENTS_FILE"
}

last_phase_reason() {
  local phase="$1"
  [ -f "$EVENTS_FILE" ] || return 0
  awk -F '\t' -v phase="$phase" '$2 == phase && $4 == "COMPLETE" { reason=$5 } END { if (reason != "") print reason }' "$EVENTS_FILE"
}

next_phase_attempt() {
  local phase="$1"
  node -e '
    const fs=require("node:fs"), path=require("node:path");
    const [eventsPath,stateDirectory,phase]=process.argv.slice(1);
    let maximum=0;
    for (const line of fs.readFileSync(eventsPath,"utf8").split(/\r?\n/)) {
      const fields=line.split("\t");
      if (fields[1] === phase && /^\d+$/.test(fields[2] ?? "")) maximum=Math.max(maximum,Number(fields[2]));
    }
    const escaped=phase.replace(/[.*+?^${}()|[\]\\]/g,"\\$&");
    const pattern=new RegExp(`^${escaped}(?:-.+)?-attempt-(\\d+)(?:-|\\.)`);
    for (const directory of ["prompts","logs","evidence"]) {
      let names=[];
      try { names=fs.readdirSync(path.join(stateDirectory,directory)); } catch {}
      for (const name of names) {
        const match=pattern.exec(name);
        if (match) maximum=Math.max(maximum,Number(match[1]));
      }
    }
    process.stdout.write(String(maximum+1));
  ' "$EVENTS_FILE" "$STATE_DIR" "$phase"
}

last_phase_retry_reason() {
  local phase="$1"
  awk -F '\t' -v phase="$phase" '
    $2 == phase && $4 == "RETRY" { reason=$5 }
    END { if (reason != "") print reason }
  ' "$EVENTS_FILE"
}

evidence_change_count() {
  local path="$1"
  node -e '
    const fs = require("node:fs");
    const value = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    process.stdout.write(String(
      (value.added?.length ?? 0) + (value.modified?.length ?? 0) + (value.deleted?.length ?? 0)
    ));
  ' "$path"
}

attempt_display() {
  local current="$1" stalled="$2"
  if [ "$MAX_TOTAL_ATTEMPTS" -gt 0 ]; then
    printf 'A%s · R%s/%s · S%s/%s' "$current" "${phase_run_attempts:-0}" "$MAX_TOTAL_ATTEMPTS" "$stalled" "$MAX_ATTEMPTS"
  else
    printf 'A%s · R%s/unlimited · S%s/%s' "$current" "${phase_run_attempts:-0}" "$stalled" "$MAX_ATTEMPTS"
  fi
}

run_attempt_display() {
  local current="$1"
  if [ "$MAX_TOTAL_ATTEMPTS" -gt 0 ]; then
    printf '%s/%s' "$current" "$MAX_TOTAL_ATTEMPTS"
  else
    printf '%s/unlimited' "$current"
  fi
}

manager_failure_is_terminal() {
  local path="$1"
  grep -Eiq \
    'insufficient balance|insufficient credits|payment required|OpenCode CLI not found|command not found|Provider not found|unknown provider|model.*(not found|unknown|invalid|unavailable)|unknown model|ProviderModelNotFound|unauthori[sz]ed|authentication failed|invalid api key|invalid token|forbidden|permission denied|(^|[^0-9])(401|403)([^0-9]|$)' \
    "$path"
}

manager_failure_is_transient() {
  local path="$1"
  grep -Eiq \
    'timed? out|timeout|deadline exceeded|network error|connection (reset|refused|lost)|socket hang up|fetch failed|service unavailable|overloaded|internal server error|(^|[^0-9])(429|500|502|503|504|524)([^0-9]|$)' \
    "$path"
}

record_context_compaction_signal() {
  local path="$1" role="$2" current_phase="$3" current_attempt="$4"
  [ -f "$path" ] || return 0
  if grep -Eiq 'context[_ .-]?compact(ed|ion)|compacting context' "$path"; then
    record_event "$current_phase" "$current_attempt" "CONTEXT_COMPACTION" \
      "$role provider reported context compaction; correctness remains bound to deterministic artifacts"
    log "$current_phase $role context-compaction signal observed in ${path#"$PROJECT/"}"
  fi
}

manager_finding_batch_fingerprint() {
  local report="$1"
  [ -f "$report" ] || return 0
  node -e '
    const fs = require("node:fs");
    const crypto = require("node:crypto");
    let value;
    try { value = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); } catch { process.exit(0); }
    const keys = (value.findings ?? []).map((finding) => String(finding.key ?? "")).filter(Boolean).sort();
    if (keys.length) process.stdout.write(crypto.createHash("sha256").update(JSON.stringify(keys)).digest("hex"));
  ' "$report"
}

write_agent_prompt() {
  local output="$1" content="$2" task_id="$3" execution_root="$4"
  {
    printf 'RB_RALPH_ROLE: implementation-agent\n'
    printf 'PROJECT_ROOT: %s\nPLAN_PATH: %s\nPHASE_ID: %s\n' "$execution_root" "$PLAN_PATH" "$phase_id"
    [ -z "$task_id" ] || printf 'TASK_ID: %s\n' "$task_id"
    printf 'ATTEMPT: %s (stalled=%s/%s, hard-cap=%s)\n\n' \
      "$attempt" "$stalled_attempts" "$MAX_ATTEMPTS" \
      "$(if [ "$MAX_TOTAL_ATTEMPTS" -eq 0 ]; then printf unlimited; else printf '%s' "$MAX_TOTAL_ATTEMPTS"; fi)"
    if [ -n "$task_id" ]; then
      printf '%s\n' 'Implement only the task below in this fresh execution context. The validated task extract is the work-item authority.'
    else
      printf '%s\n' 'Implement only the phase below in this fresh execution context. The validated phase extract is the work-item authority.'
    fi
    printf '%s\n' \
      'Open referenced context or raw evidence only for a concrete unresolved criterion. Prefer exact files and relevant sections; do not reread whole plans, transcripts, or successful logs by default.' \
      'Use rg to locate a symbol or exact criterion before opening another file. Read bounded line ranges around the match; do not print whole directories or broad files by default.' \
      'Never print complete lockfiles, generated bundles, prior provider logs, execution snapshots, or previous run transcripts. Limit find/rg results and refine any query whose result is broad.' \
      'Do not repeat a read whose output is already present in this fresh call context. Every broad read must name the still-unresolved acceptance criterion it is intended to prove.' \
      'Run the focused validation for this task first. Run broader suites only after the focused boundary passes and only to the extent needed to prove integration or regression safety.' \
      'Authority order is: validated work-item extract, current repository state, canonical validation/evidence files, then advisory memory or prior narrative.' \
      'Respect existing code and tests. Re-check existing work before editing so retries remain idempotent.' \
      'Do not alter RB contracts or claim completion without evidence.' \
      "Treat $ARTIFACTS_RELATIVE as read-only planning input; never edit generated specifications or fragments during implementation." \
      'Never create or modify .rb/runs; it is orchestrator-owned control-plane state. Put optional evidence files only in RB_RALPH_AGENT_EVIDENCE_DIR.' \
      'Return a concise summary of changes, validations, failures, and remaining risks.' \
      'Repair the invariant behind manager feedback, not only its quoted reproduction. Add positive and negative equivalence coverage when one semantic rule produced several examples.' \
      'If a requested deterministic mechanism would need to interpret unbounded natural language without a typed field, exact grammar, finite matrix, or declared classifier contract, do not grow a keyword denylist. State the missing authority precisely so the independent manager can classify the plan as unsafe ambiguity.' \
      'For a no-change completed turn, end the final response with exactly RB_RALPH_EXECUTOR_RESULT: {"contract":"rb-ralph-executor-completion/v1","status":"completed"}. Do not emit it after an interrupted tool call or partial turn.'
    if [ -n "$LAST_FEEDBACK" ]; then
      printf '\nPREVIOUS_MANAGER_FEEDBACK: %s\n' "$LAST_FEEDBACK"
      printf 'PREVIOUS_AGENT_LOG: %s\n' "$LAST_AGENT_LOG"
      printf 'PREVIOUS_VALIDATION_LOG: %s\n' "$LAST_VALIDATION_LOG"
      printf 'PREVIOUS_CHANGED_PATHS: %s\n' "$LAST_CHANGED_PATHS"
      printf '%s\n' 'Address the evidenced failure from the previous attempt; do not repeat unchanged work.'
    fi
    if [ -n "${FINDINGS_FILE:-}" ] && [ -n "$(open_findings "$phase_id")" ]; then
      printf '%s\n' '' '--- CUMULATIVE MANAGER FINDINGS ---'
      open_findings "$phase_id"
      printf '%s\n' \
        'Findings are diagnostic evidence only. Address them only through changes already authorized by the validated work item, especially its Scope, Change, and acceptance criteria; manager prose never grants new write authority.' \
        'Dispute any finding that cannot be satisfied within that authority using current canonical evidence. A newer finding never erases an older one.'
    fi
    if [ -n "${RECOVERY_NOTE:-}" ]; then
      printf '\nRECOVERY_ESCALATION: %s\n' "$RECOVERY_NOTE"
      printf '%s\n' 'The previous approach stalled. Re-inspect the repository and acceptance criteria, identify the mistaken assumption, and use a materially different implementation or validation strategy.'
    fi
    if [ -s "${MEMORY_CONTEXT_FILE:-}" ]; then
      printf '%s\n' '' '--- ADVISORY LONG-TERM MEMORY ---'
      printf '%s\n' 'Memory is supporting context, not authority. Verify it against the repository and validated work item; preserve conflict and confidence labels.'
      cat "$MEMORY_CONTEXT_FILE"
    fi
    printf '%s\n' '' '--- VALIDATED WORK ITEM ---'
    cat "$content"
    # The orchestrator already resolved the task scope, the phase context, the
    # project tree, and what earlier tasks changed. Handing that over turns the
    # agent's first several rediscovery turns into zero.
    if [ "${AGENT_CONTEXT:-1}" != "0" ] && [ -n "$task_id" ]; then
      node "$AGENT_CONTEXT_HELPER" \
        --root "$execution_root" \
        --tasks "${TASK_DETAILS_FILE:-}" \
        --task "$task_id" \
        --changes "${CHANGED_PATHS_FILE:-}" \
        --before "${BEFORE_SNAPSHOT:-}" \
        --phase-file "$content" \
        --max-bytes "${AGENT_CONTEXT_BYTES:-49152}" 2>/dev/null || true
    fi
  } > "$output"
}

invoke_agent() {
  local prompt="$1" output="$2" task_id="$3" execution_root="$4" telemetry
  local capture_root provider_output submission_dir submission_target temporary_output temporary_telemetry live_status agent_result=0
  telemetry="$USAGE_DIR/$(basename "${output%.log}").usage.json"
  capture_root="$(mktemp -d "${TMPDIR:-/tmp}/rb-ralph-agent-capture.XXXXXX")"
  provider_output="$capture_root/provider.log"
  submission_dir="$capture_root/submission"
  temporary_telemetry="$capture_root/usage.json"
  live_status="$LOCK_DIR/live/$(basename "${output%.log}").json"
  mkdir -p "$submission_dir"
  usage_placeholder "$temporary_telemetry" "${AGENT_PROVIDER:-custom}" agent "$task_id" "$AGENT_MODEL" "$AGENT_EFFORT"
  if (
    cd "$execution_root"
    RB_RALPH_ROLE="agent" \
    RB_RALPH_PROJECT_ROOT="$execution_root" \
    RB_RALPH_PLAN_PATH="$PLAN_PATH" \
    RB_RALPH_PHASE_ID="$phase_id" \
    RB_RALPH_OPERATIONAL_CONTRACT="$OPERATIONAL_CONTRACT" \
    RB_RALPH_TASK_ID="$task_id" \
    RB_RALPH_ATTEMPT="$attempt" \
    RB_RALPH_AGENT_EVIDENCE_DIR="$submission_dir" \
    RB_RALPH_TELEMETRY_FILE="$temporary_telemetry" \
    RB_RALPH_DIRECT_API_CORE="$CORE_CLI" \
    RB_RALPH_PROVIDER="$AGENT_PROVIDER" \
    RB_RALPH_CREDENTIAL="$AGENT_CREDENTIAL" \
    RB_RALPH_ARTIFACTS_DIR="$ARTIFACTS_RELATIVE" \
    RB_RALPH_MODEL="$AGENT_MODEL" \
    RB_RALPH_AGENT_MODEL="$AGENT_MODEL" \
    RB_RALPH_MANAGER_MODEL="$MANAGER_MODEL" \
    RB_RALPH_EFFORT="$AGENT_EFFORT" \
    RB_RALPH_AGENT_EFFORT="$AGENT_EFFORT" \
    RB_RALPH_MANAGER_EFFORT="$MANAGER_EFFORT" \
    RB_RALPH_PERMISSION_MODE="$PERMISSION_MODE" \
    RB_RALPH_YOLO="$(if [ "$PERMISSION_MODE" = yolo ]; then printf 1; else printf 0; fi)" \
    node "$PROCESS_SUPERVISOR" \
      --input "$prompt" --output "$provider_output" \
      --idle-timeout "$AGENT_IDLE_TIMEOUT" --first-output-timeout "$AGENT_FIRST_OUTPUT_TIMEOUT" \
      --timeout "$AGENT_TIMEOUT" --status "$live_status" \
      --soft-command-limit "$CONTEXT_SOFT_COMMAND_LIMIT" \
      --soft-output-bytes "$CONTEXT_SOFT_OUTPUT_BYTES" \
      --hard-command-limit "$CONTEXT_HARD_COMMAND_LIMIT" \
      --hard-output-bytes "$CONTEXT_HARD_OUTPUT_BYTES" \
      --label executor -- "$AGENT_CMD"
  ); then
    agent_result=0
  else
    agent_result=$?
  fi
  temporary_output="${output}.tmp-$$-$RANDOM"
  RB_RALPH_REDACT_CREDENTIALS="${AGENT_CREDENTIAL}${TSV_SEPARATOR}${MANAGER_CREDENTIAL}" \
    node "$EVIDENCE_SANITIZER" redact "$provider_output" "$temporary_output" \
      "${RB_RALPH_EVIDENCE_ENV:-},${MEMORY_TOKEN_ENV:-}" "$OPERATIONAL_CONTRACT"
  mv "$temporary_output" "$output"
  record_control_receipt "$output"
  # Tokens alone hide the shape of a call: a task at 1.5M input tokens may be
  # genuinely large, or an agent looping on rediscovery. The command count is
  # what separates them, so record it beside the run instead of leaving it
  # buried in a megabyte of provider log.
  # One file per call, like usage/: a shared append-only file would be modified
  # after the control-plane snapshot on a provider-availability retry, and the
  # orchestrator would then read its own bookkeeping as forged prior evidence.
  mkdir -p "$STATE_DIR/activity"
  node "$AGENT_ACTIVITY_HELPER" "$output" "$phase_id/${task_id:-phase}-attempt-$attempt" \
    "$STATE_DIR/activity/$(basename "${output%.log}").tsv" 2>/dev/null || true
  record_control_receipt "$STATE_DIR/activity/$(basename "${output%.log}").tsv"
  if [ -f "$temporary_telemetry" ]; then
    mkdir -p "$(dirname "$telemetry")"
    mv "$temporary_telemetry" "$telemetry"
    record_control_receipt "$telemetry"
  fi
  record_context_efficiency "$prompt" "$output" "$telemetry"
  record_control_receipt "$CONTEXT_EFFICIENCY_DIR/$(basename "${output%.log}").json"
  if find "$submission_dir" -mindepth 1 -print -quit | grep -q .; then
    submission_target="$STATE_DIR/evidence/$(basename "${output%.log}")-agent-submission"
    RB_RALPH_REDACT_CREDENTIALS="${AGENT_CREDENTIAL}${TSV_SEPARATOR}${MANAGER_CREDENTIAL}" \
      node "$EVIDENCE_SANITIZER" copy-tree "$submission_dir" "$submission_target" \
        "${RB_RALPH_EVIDENCE_ENV:-},${MEMORY_TOKEN_ENV:-}" "$OPERATIONAL_CONTRACT"
    if ! record_control_tree_receipts "$submission_target"; then
      agent_result=1
      printf '\nRB_RALPH_CONTROL_PLANE_VIOLATION: provider submission contains a non-canonical file type\n' >> "$output"
      record_control_receipt "$output"
    fi
    node "$EVIDENCE_PROVENANCE_HELPER" "${submission_target}-provenance.json" \
      "${submission_target#"$PROJECT/"}" provider-submitted untrusted
    record_control_receipt "${submission_target}-provenance.json"
  fi
  case "$capture_root" in
    "${TMPDIR:-/tmp}"/rb-ralph-agent-capture.*) rm -rf -- "$capture_root" ;;
  esac
  return "$agent_result"
}

invoke_manager() {
  local prompt="$1" output="$2" telemetry="$3"
  local capture_root provider_output temporary_output temporary_telemetry live_status manager_result=0
  capture_root="$(mktemp -d "${TMPDIR:-/tmp}/rb-ralph-manager-capture.XXXXXX")"
  provider_output="$capture_root/provider.log"
  temporary_telemetry="$capture_root/usage.json"
  live_status="$LOCK_DIR/live/$(basename "${output%.log}").json"
  usage_placeholder "$temporary_telemetry" "${MANAGER_PROVIDER:-custom}" manager "" "$MANAGER_MODEL" "$MANAGER_EFFORT"
  if (
    cd "$PROJECT"
    RB_RALPH_ROLE="manager" \
    RB_RALPH_PROJECT_ROOT="$PROJECT" \
    RB_RALPH_PLAN_PATH="$PLAN_PATH" \
    RB_RALPH_PHASE_ID="$phase_id" \
    RB_RALPH_PHASE_TITLE="$title" \
    RB_RALPH_OPERATIONAL_CONTRACT="$OPERATIONAL_CONTRACT" \
    RB_RALPH_ATTEMPT="$attempt" \
    RB_RALPH_MANAGER_RETRY="$manager_try" \
    RB_RALPH_AGENT_LOG="$AGENT_LOG" \
    RB_RALPH_VALIDATION_LOG="$VALIDATION_LOG" \
    RB_RALPH_EVIDENCE_INDEX="$EVIDENCE_INDEX_FILE" \
    RB_RALPH_CHANGED_PATHS_FILE="$CHANGED_PATHS_FILE" \
    RB_RALPH_AGENT_EXIT_CODE="$agent_rc" \
    RB_RALPH_TELEMETRY_FILE="$temporary_telemetry" \
    RB_RALPH_DIRECT_API_CORE="$CORE_CLI" \
    RB_RALPH_PROVIDER="$MANAGER_PROVIDER" \
    RB_RALPH_CREDENTIAL="$MANAGER_CREDENTIAL" \
    RB_RALPH_ARTIFACTS_DIR="$ARTIFACTS_RELATIVE" \
    RB_RALPH_MODEL="$MANAGER_MODEL" \
    RB_RALPH_AGENT_MODEL="$AGENT_MODEL" \
    RB_RALPH_MANAGER_MODEL="$MANAGER_MODEL" \
    RB_RALPH_EFFORT="$MANAGER_EFFORT" \
    RB_RALPH_AGENT_EFFORT="$AGENT_EFFORT" \
    RB_RALPH_MANAGER_EFFORT="$MANAGER_EFFORT" \
    RB_RALPH_PERMISSION_MODE="protected" \
    RB_RALPH_YOLO="0" \
    node "$PROCESS_SUPERVISOR" \
      --input "$prompt" --output "$provider_output" \
      --idle-timeout "$MANAGER_IDLE_TIMEOUT" --first-output-timeout "$MANAGER_FIRST_OUTPUT_TIMEOUT" \
      --timeout "$MANAGER_TIMEOUT" --status "$live_status" \
      --soft-command-limit "$CONTEXT_SOFT_COMMAND_LIMIT" \
      --soft-output-bytes "$CONTEXT_SOFT_OUTPUT_BYTES" \
      --hard-command-limit "$CONTEXT_HARD_COMMAND_LIMIT" \
      --hard-output-bytes "$CONTEXT_HARD_OUTPUT_BYTES" \
      --label manager -- "$MANAGER_CMD"
  ); then
    manager_result=0
  else
    manager_result=$?
  fi
  temporary_output="${output}.tmp-$$-$RANDOM"
  RB_RALPH_REDACT_CREDENTIALS="${AGENT_CREDENTIAL}${TSV_SEPARATOR}${MANAGER_CREDENTIAL}" \
    node "$EVIDENCE_SANITIZER" redact "$provider_output" "$temporary_output" \
      "${RB_RALPH_EVIDENCE_ENV:-},${MEMORY_TOKEN_ENV:-}" "$OPERATIONAL_CONTRACT"
  mv "$temporary_output" "$output"
  record_control_receipt "$output"
  node "$EVIDENCE_PROVENANCE_HELPER" "$STATE_DIR/evidence/$(basename "${output%.log}")-provenance.json" \
    "${output#"$PROJECT/"}" manager-narrative provider-asserted
  record_control_receipt "$STATE_DIR/evidence/$(basename "${output%.log}")-provenance.json"
  if [ -f "$temporary_telemetry" ]; then
    mkdir -p "$(dirname "$telemetry")"
    mv "$temporary_telemetry" "$telemetry"
    record_control_receipt "$telemetry"
  fi
  record_context_efficiency "$prompt" "$output" "$telemetry"
  record_control_receipt "$CONTEXT_EFFICIENCY_DIR/$(basename "${output%.log}").json"
  case "$capture_root" in
    "${TMPDIR:-/tmp}"/rb-ralph-manager-capture.*) rm -rf -- "$capture_root" ;;
  esac
  return "$manager_result"
}

git_snapshot_commit() {
  local index_file tree commit
  index_file="$(mktemp)"
  rm -f "$index_file"
  GIT_INDEX_FILE="$index_file" git -C "$PROJECT" read-tree HEAD
  GIT_INDEX_FILE="$index_file" git -C "$PROJECT" add -A -- . ':(exclude).rb/runs'
  if [ -d "$PROJECT/.rb" ]; then
    GIT_INDEX_FILE="$index_file" git -C "$PROJECT" add -f -A -- .rb ':(exclude).rb/runs'
  fi
  if [ "$ARTIFACTS_RELATIVE" != ".rb" ]; then
    GIT_INDEX_FILE="$index_file" git -C "$PROJECT" add -f -A -- "$ARTIFACTS_RELATIVE"
  fi
  tree="$(GIT_INDEX_FILE="$index_file" git -C "$PROJECT" write-tree)"
  commit="$(
    printf 'RB Ralph execution snapshot\n' | \
      GIT_AUTHOR_NAME='RB Ralph' GIT_AUTHOR_EMAIL='rb-ralph@localhost' \
      GIT_COMMITTER_NAME='RB Ralph' GIT_COMMITTER_EMAIL='rb-ralph@localhost' \
      git -C "$PROJECT" commit-tree "$tree" -p HEAD
  )"
  rm -f "$index_file"
  printf '%s\n' "$commit"
}

create_execution_worktree() {
  local snapshot="$1" path="$2"
  git -C "$PROJECT" worktree add --quiet --detach "$path" "$snapshot"
  ACTIVE_WORKTREES+=("$path")
}

dashboard_clean() {
  local value="$1"
  value="${value//$'\t'/ }"
  value="${value//$'\n'/ }"
  value="${value//$'\r'/ }"
  printf '%s' "$value"
}

dashboard_role_label() {
  local provider="$1" command="$2" model="${3:-}" effort="${4:-}" label details=""
  if [ -n "$provider" ]; then label="$provider"; else label="$(basename "$command")"; fi
  if [ -n "$model" ]; then details="$model"; fi
  if [ -n "$effort" ]; then
    [ -z "$details" ] || details+="; "
    details+="effort=$effort"
  fi
  if [ -n "$details" ]; then printf '%s[%s]' "$label" "$details"; else printf '%s' "$label"; fi
}

dashboard_find_phase_index() {
  local requested_id="$1" index
  DASHBOARD_PHASE_INDEX=-1
  index=0
  while [ "$index" -lt "${#DASHBOARD_PHASE_IDS[@]}" ]; do
    if [ "${DASHBOARD_PHASE_IDS[$index]}" = "$requested_id" ]; then
      DASHBOARD_PHASE_INDEX="$index"
      return 0
    fi
    index=$((index + 1))
  done
  return 1
}

dashboard_ensure_phase_index() {
  local requested_id="$1" index
  if dashboard_find_phase_index "$requested_id"; then return 0; fi
  index="${#DASHBOARD_PHASE_IDS[@]}"
  DASHBOARD_PHASE_IDS[$index]="$requested_id"
  DASHBOARD_PHASE_STATUS[$index]="pending"
  DASHBOARD_PHASE_ATTEMPT[$index]="0"
  DASHBOARD_PHASE_GATES[$index]="pending pending pending pending"
  DASHBOARD_PHASE_INDEX="$index"
}

dashboard_write_live() {
  [ -n "${DASHBOARD_LIVE_FILE:-}" ] || return 0
  local temporary="$DASHBOARD_LIVE_FILE.tmp.$$" id index
  {
    printf 'META\tstatus\t%s\n' "$DASHBOARD_STATUS"
    printf 'META\texecution_id\t%s\n' "$DASHBOARD_EXECUTION_ID"
    printf 'META\tstarted\t%s\n' "$DASHBOARD_STARTED"
    printf 'META\tended\t%s\n' "$DASHBOARD_ENDED"
    printf 'META\tpid\t%s\n' "$$"
    printf 'META\tphase\t%s\n' "$(dashboard_clean "$DASHBOARD_PHASE")"
    printf 'META\tattempt\t%s\n' "$(dashboard_clean "$DASHBOARD_ATTEMPT")"
    printf 'META\tactivity\t%s\n' "$(dashboard_clean "$DASHBOARD_ACTIVITY")"
    printf 'META\treason\t%s\n' "$(dashboard_clean "$DASHBOARD_REASON")"
    printf 'META\tfindings\t%s\n' "$(dashboard_clean "$DASHBOARD_FINDINGS")"
    index=0
    while [ "$index" -lt "${#DASHBOARD_PHASE_IDS[@]}" ]; do
      id="${DASHBOARD_PHASE_IDS[$index]}"
      printf 'PHASE\t%s\t%s\t%s\t%s\n' "$id" "${DASHBOARD_PHASE_STATUS[$index]}" \
        "${DASHBOARD_PHASE_ATTEMPT[$index]:-0}" "${DASHBOARD_PHASE_GATES[$index]:-pending pending pending pending}"
      index=$((index + 1))
    done
  } > "$temporary"
  mv "$temporary" "$DASHBOARD_LIVE_FILE"
}

dashboard_refresh_findings() {
  [ -f "${FINDINGS_FILE:-}" ] || return 0
  DASHBOARD_FINDINGS="$(awk -F '\t' -v phase="${phase_id:-}" -v attempt="${attempt:-0}" '
    NR == 1 || (phase != "" && $2 != phase) { next }
    { total += 1; if ($4 == "open") open += 1; if ($4 == "resolved") resolved += 1; if ($3 == attempt) fresh += 1 }
    END { printf "total=%d open=%d resolved=%d new=%d", total, open, resolved, fresh }
  ' "$FINDINGS_FILE")"
  dashboard_write_live
}

refresh_usage_summary() {
  [ -n "${USAGE_DIR:-}" ] || return 0
  local arguments=("$USAGE_DIR" "$USAGE_SUMMARY_FILE")
  [ -z "$PRICING_FILE" ] || arguments+=("$PRICING_FILE")
  node "$USAGE_HELPER" "${arguments[@]}" || log "usage telemetry summary could not be refreshed"
  node "$CONTEXT_EFFICIENCY_HELPER" summary \
    "$CONTEXT_EFFICIENCY_DIR" "$CONTEXT_EFFICIENCY_SUMMARY_FILE" \
    || log "context efficiency summary could not be refreshed"
}

record_context_efficiency() {
  local prompt="$1" provider_log="$2" telemetry="$3" target
  [ -f "$prompt" ] && [ -f "$provider_log" ] && [ -f "$telemetry" ] || return 0
  mkdir -p "$CONTEXT_EFFICIENCY_DIR"
  target="$CONTEXT_EFFICIENCY_DIR/$(basename "${provider_log%.log}").json"
  node "$CONTEXT_EFFICIENCY_HELPER" record "$prompt" "$provider_log" "$telemetry" "$target" \
    || log "context efficiency record could not be published for $(basename "$provider_log")"
}

usage_placeholder() {
  local path="$1" provider="$2" role="$3" task_id="${4:-}" model="${5:-unknown}" effort="${6:-default}"
  RB_RALPH_ROLE="$role" RB_RALPH_PHASE_ID="$phase_id" RB_RALPH_TASK_ID="$task_id" \
    RB_RALPH_ATTEMPT="$attempt" \
    node "$TELEMETRY_HELPER" placeholder "$path" "${provider:-custom}" "${model:-unknown}" "${effort:-default}"
}

dashboard_state_init() {
  DASHBOARD_PLAN_FILE="$STATE_DIR/dashboard-plan.tsv"
  DASHBOARD_LIVE_FILE="$STATE_DIR/dashboard-live.tsv"
  DASHBOARD_LOG="$STATE_DIR/logs/dashboard-runner.log"
  DASHBOARD_STARTED="$(date +%s)"
  DASHBOARD_EXECUTION_ID="${DASHBOARD_STARTED}-$$"
  USAGE_DIR="$STATE_DIR/usage/$DASHBOARD_EXECUTION_ID"
  USAGE_SUMMARY_FILE="$STATE_DIR/usage-summary.tsv"
  CONTEXT_EFFICIENCY_DIR="$STATE_DIR/context-efficiency/$DASHBOARD_EXECUTION_ID"
  CONTEXT_EFFICIENCY_SUMMARY_FILE="$STATE_DIR/context-efficiency-summary.tsv"
  mkdir -p "$USAGE_DIR" "$CONTEXT_EFFICIENCY_DIR"
  local temporary="$DASHBOARD_PLAN_FILE.tmp.$$" row task_row
  local dash_phase_id dash_number dash_task_count dash_pending dash_depends dash_title
  local dash_task_id dash_done dash_parallel dash_task_depends dash_task_title dash_status dash_index
  {
    printf 'META\tplan\t%s\n' "$(dashboard_clean "$PLAN_ID")"
    printf 'META\tproject\t%s\n' "$(dashboard_clean "$(basename "$PROJECT")")"
    printf 'META\tversion\t%s\n' "$(dashboard_clean "$RB_RALPH_VERSION")"
    printf 'META\texecution_id\t%s\n' "$DASHBOARD_EXECUTION_ID"
    printf 'META\troles\t%s executor / %s manager\n' \
      "$(dashboard_role_label "$AGENT_PROVIDER" "$AGENT_CMD" "$AGENT_MODEL" "$AGENT_EFFORT")" \
      "$(dashboard_role_label "$MANAGER_PROVIDER" "$MANAGER_CMD" "$MANAGER_MODEL" "$MANAGER_EFFORT")"
    printf 'META\tagent_model\t%s\n' "$(dashboard_clean "$AGENT_MODEL")"
    printf 'META\tmanager_model\t%s\n' "$(dashboard_clean "$MANAGER_MODEL")"
    printf 'META\tagent_effort\t%s\n' "$(dashboard_clean "$AGENT_EFFORT")"
    printf 'META\tmanager_effort\t%s\n' "$(dashboard_clean "$MANAGER_EFFORT")"
    printf 'META\tpermissions\t%s\n' "$PERMISSION_MODE"
    printf 'META\tagent_idle_timeout\t%s\n' "$AGENT_IDLE_TIMEOUT"
    printf 'META\tmanager_idle_timeout\t%s\n' "$MANAGER_IDLE_TIMEOUT"
    while IFS= read -r row; do
      IFS="$TSV_SEPARATOR" read -r dash_phase_id dash_number dash_task_count dash_pending dash_depends dash_title \
        <<< "${row//$'\t'/$TSV_SEPARATOR}"
      [ "$dash_phase_id" = "phase_id" ] && continue
      if [ "$dash_pending" -eq 0 ]; then dash_status="document-complete"; else dash_status="pending"; fi
      dash_index="${#DASHBOARD_PHASE_IDS[@]}"
      DASHBOARD_PHASE_IDS[$dash_index]="$dash_phase_id"
      DASHBOARD_PHASE_STATUS[$dash_index]="$dash_status"
      DASHBOARD_PHASE_ATTEMPT[$dash_index]="0"
      if [ "$dash_status" = "document-complete" ]; then
        DASHBOARD_PHASE_GATES[$dash_index]="skip skip skip skip"
      else
        DASHBOARD_PHASE_GATES[$dash_index]="pending pending pending pending"
      fi
      printf 'PHASE\t%s\t%s\t%s\n' "$dash_phase_id" "$dash_status" "$(dashboard_clean "$dash_title")"
      if [ "$dash_phase_id" = "$FINAL_PHASE_ID" ]; then
        printf 'TASK\t%s\t%s\t%s\t%s\n' "$dash_phase_id" "RBT-FINAL" "pending" \
          "Clean-room product acceptance"
        continue
      fi
      while IFS= read -r task_row; do
        IFS="$TSV_SEPARATOR" read -r dash_task_id dash_done dash_parallel dash_task_depends dash_task_title \
          <<< "${task_row//$'\t'/$TSV_SEPARATOR}"
        [ "$dash_task_id" = "task_id" ] && continue
        if [ "$dash_done" = "true" ]; then dash_status="complete"; else dash_status="pending"; fi
        printf 'TASK\t%s\t%s\t%s\t%s\n' "$dash_phase_id" "$dash_task_id" "$dash_status" \
          "$(dashboard_clean "$dash_task_title")"
      done <<< "$(core_cli_call contract tasks "$PLAN_ABSOLUTE" --phase "$dash_phase_id" --format tsv)"
    done <<< "$PHASES"
  } > "$temporary"
  mv "$temporary" "$DASHBOARD_PLAN_FILE"
  DASHBOARD_STATUS="running"
  DASHBOARD_ENDED=""
  DASHBOARD_ACTIVITY="preparing execution"
  DASHBOARD_REASON=""
  refresh_usage_summary
  dashboard_write_live
}

dashboard_set_phase() {
  local id="$1" status="$2" activity="$3" attempt_value="${4:-}" phase_index
  dashboard_ensure_phase_index "$id"
  phase_index="$DASHBOARD_PHASE_INDEX"
  DASHBOARD_PHASE_STATUS[$phase_index]="$status"
  DASHBOARD_PHASE="$id"
  DASHBOARD_ATTEMPT="$attempt_value"
  [ -z "$attempt_value" ] || DASHBOARD_PHASE_ATTEMPT[$phase_index]="$attempt_value"
  DASHBOARD_ACTIVITY="$activity"
  case "$status" in
    blocked|failed|paused|retry) DASHBOARD_REASON="$activity" ;;
    running) DASHBOARD_REASON="" ;;
  esac
  dashboard_write_live
}

dashboard_reset_gates() {
  local id="$1" phase_index
  dashboard_ensure_phase_index "$id"
  phase_index="$DASHBOARD_PHASE_INDEX"
  DASHBOARD_PHASE_GATES[$phase_index]="pending pending pending pending"
  dashboard_write_live
}

dashboard_gate() {
  local id="$1" index="$2" value="$3" activity="${4:-}" phase_index
  local -a gates
  dashboard_ensure_phase_index "$id"
  phase_index="$DASHBOARD_PHASE_INDEX"
  read -r -a gates <<< "${DASHBOARD_PHASE_GATES[$phase_index]:-pending pending pending pending}"
  gates[$index]="$value"
  DASHBOARD_PHASE_GATES[$phase_index]="${gates[*]}"
  [ -z "$activity" ] || DASHBOARD_ACTIVITY="$activity"
  dashboard_write_live
}

dashboard_finish() {
  local status="$1"
  [ -n "${DASHBOARD_LIVE_FILE:-}" ] || return 0
  DASHBOARD_STATUS="$status"
  DASHBOARD_ENDED="$(date +%s)"
  refresh_usage_summary
  dashboard_write_live
}

start_dashboard() {
  [ "$DASHBOARD" -eq 1 ] || return 0
  if [ ! -t 1 ]; then
    log "dashboard requested without a TTY; observable state remains available through rb-ralph-watch"
    return 0
  fi
  [ -x "$DASHBOARD_CLI" ] || die "RB Ralph dashboard not found: $DASHBOARD_CLI; reinstall the complete package"
  : > "$DASHBOARD_LOG"
  "$DASHBOARD_CLI" --embedded --project "$PROJECT" --run "$RUN_ID" &
  DASHBOARD_PID=$!
  DASHBOARD_ACTIVE=1
}

stop_dashboard() {
  [ -n "$DASHBOARD_PID" ] || return 0
  kill "$DASHBOARD_PID" >/dev/null 2>&1 || true
  wait "$DASHBOARD_PID" >/dev/null 2>&1 || true
  DASHBOARD_PID=""
  DASHBOARD_ACTIVE=0
}

wait_dashboard() {
  [ -n "$DASHBOARD_PID" ] || return 0
  wait "$DASHBOARD_PID" >/dev/null 2>&1 || true
  DASHBOARD_PID=""
  DASHBOARD_ACTIVE=0
}

cleanup_attempt_worktrees() {
  local path root="$1"
  shift
  for path in "$@"; do
    if [ -d "$path" ]; then
      git -C "$PROJECT" worktree remove --force "$path" >/dev/null 2>&1 || true
    fi
  done
  case "$root" in
    "${TMPDIR:-/tmp}"/rb-ralph-worktrees.*)
      rm -rf -- "$root"
      ;;
  esac
}

cleanup_runtime() {
  local path root exit_code=$?
  for path in "${ACTIVE_WORKTREES[@]+"${ACTIVE_WORKTREES[@]}"}"; do
    if [ -d "$path" ]; then
      git -C "$PROJECT" worktree remove --force "$path" >/dev/null 2>&1 || true
    fi
  done
  for root in "${ACTIVE_TEMP_ROOTS[@]+"${ACTIVE_TEMP_ROOTS[@]}"}"; do
    case "$root" in
      "${TMPDIR:-/tmp}"/rb-ralph-worktrees.*|"${TMPDIR:-/tmp}"/rb-ralph-fragments.*|"${TMPDIR:-/tmp}"/rb-ralph-control-receipts.*)
        [ ! -d "$root" ] || rm -rf -- "$root"
        ;;
    esac
  done
  if [ "${DASHBOARD_STATUS:-}" = "running" ]; then dashboard_finish failed || true; fi
  stop_dashboard
  if [ -n "${LOCK_DIR:-}" ] && [ -d "$LOCK_DIR/live" ]; then
    rm -f -- "$LOCK_DIR/live/"* 2>/dev/null || true
    rmdir "$LOCK_DIR/live" 2>/dev/null || true
  fi
  [ -z "${LOCK_DIR:-}" ] || rm -f -- "$LOCK_DIR/owner.pid" 2>/dev/null || true
  [ -z "${LOCK_DIR:-}" ] || rmdir "$LOCK_DIR" 2>/dev/null || true
  return "$exit_code"
}

cleanup_discovery_temp() {
  case "${DISCOVERY_TEMP_ROOT:-}" in
    "${TMPDIR:-/tmp}"/rb-ralph-fragments.*)
      [ ! -d "$DISCOVERY_TEMP_ROOT" ] || rm -rf -- "$DISCOVERY_TEMP_ROOT"
      ;;
  esac
  DISCOVERY_TEMP_ROOT=""
}

pid_is_running() {
  local pid="${1:-}"
  case "$pid" in
    ""|*[!0-9]*) return 1 ;;
  esac
  [ "$pid" != "$$" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

pid_is_ralph_owner() {
  local pid="${1:-}" command
  pid_is_running "$pid" || return 1
  command="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  case "$command" in
    *rb-ralph*) return 0 ;;
    *) return 1 ;;
  esac
}

lock_has_active_process() {
  local pid status_file state command
  if [ -r "$LOCK_DIR/owner.pid" ]; then
    IFS= read -r pid < "$LOCK_DIR/owner.pid" || true
    pid_is_ralph_owner "$pid" && return 0
  fi

  if [ -r "$STATE_DIR/dashboard-live.tsv" ]; then
    state="$(awk -F '\t' '$1 == "META" && $2 == "status" { value=$3 } END { print value }' "$STATE_DIR/dashboard-live.tsv")"
    pid="$(awk -F '\t' '$1 == "META" && $2 == "pid" { value=$3 } END { print value }' "$STATE_DIR/dashboard-live.tsv")"
    [ "$state" != "running" ] || ! pid_is_ralph_owner "$pid" || return 0
  fi

  for status_file in "$LOCK_DIR/live/"*.json; do
    [ -f "$status_file" ] || continue
    grep -Eq '"state":"(running|starting)"' "$status_file" || continue
    pid="$(sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' "$status_file" | head -n 1)"
    pid_is_running "$pid" && return 0
  done

  while IFS= read -r command; do
    [ -n "$command" ] || continue
    pid="${command%% *}"
    command="${command#* }"
    [ "$pid" != "$$" ] || continue
    case "$command" in
      *"$RUN_ID"*) pid_is_running "$pid" && return 0 ;;
    esac
  done <<EOF
$(ps -ax -o pid= -o command= 2>/dev/null | sed 's/^[[:space:]]*//')
EOF
  return 1
}

discard_stale_lock_backup() {
  local stale_lock="$1"
  if [ -d "$stale_lock/live" ]; then
    rm -f -- "$stale_lock/live/"* 2>/dev/null || true
    rmdir "$stale_lock/live" 2>/dev/null || true
  fi
  rm -f -- "$stale_lock/owner.pid" 2>/dev/null || true
  if ! rmdir "$stale_lock" 2>/dev/null; then
    log "stale lock backup retained for inspection: ${stale_lock#"$PROJECT/"}"
  fi
}

write_lock_owner() {
  if ! printf '%s\n' "$$" > "$LOCK_DIR/owner.pid"; then
    rmdir "$LOCK_DIR" 2>/dev/null || true
    die "Could not record run lock owner: $RUN_ID"
  fi
}

acquire_run_lock() {
  local stale_lock
  if mkdir "$LOCK_DIR" 2>/dev/null; then
    write_lock_owner
    return 0
  fi

  # A competing invocation may have created the directory immediately before
  # writing owner.pid. Give that narrow startup window one bounded recheck.
  sleep 1
  if lock_has_active_process; then
    die "Run is already locked by an active process: $RUN_ID"
  fi

  stale_lock="$STATE_DIR/.lock.stale.$$"
  [ ! -e "$stale_lock" ] || die "Could not quarantine stale run lock: $stale_lock already exists"
  if ! mv -- "$LOCK_DIR" "$stale_lock" 2>/dev/null; then
    die "Run lock changed while checking staleness; retry: $RUN_ID"
  fi
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    die "Another process acquired the run while its stale lock was being recovered: $RUN_ID"
  fi
  write_lock_owner
  discard_stale_lock_backup "$stale_lock"
  log "recovered stale run lock with no active execution processes: $RUN_ID"
}

changes_touch_protected_artifacts() {
  local changed_path
  while IFS= read -r changed_path; do
    case "$changed_path" in
      .rb/*|"$ARTIFACTS_RELATIVE"/*) return 0 ;;
    esac
  done
  return 1
}

record_control_receipt() {
  local target="$1"
  [ -n "${CONTROL_RECEIPT_DIR:-}" ] || return 0
  [ -f "$target" ] || return 0
  node "$CONTROL_PLANE_HELPER" receipt "$STATE_DIR" "$target" "$CONTROL_RECEIPT_DIR"
}

record_control_tree_receipts() {
  local target="$1"
  [ -n "${CONTROL_RECEIPT_DIR:-}" ] || return 0
  [ -d "$target" ] || return 0
  node "$CONTROL_PLANE_HELPER" receipt-tree "$STATE_DIR" "$target" "$CONTROL_RECEIPT_DIR"
}

mark_authority_compromised() {
  local reason="$1" marker temporary
  for marker in "$STATE_DIR/AUTHORITY-COMPROMISED" "$PROJECT/.rb/runs/AUTHORITY-COMPROMISED"; do
    temporary="${marker}.tmp-$$"
    {
      printf 'RB Ralph refused further execution because provider activity violated sealed authority.\n'
      printf 'reason=%s\n' "$reason"
      printf 'recovery=inspect and restore the project/run state, then remove both authority-compromise markers explicitly\n'
    } > "$temporary"
    mv "$temporary" "$marker"
  done
}

integrate_worktree_changes() {
  local snapshot="$1" temp_root="$2" patch_dir="$3"
  shift 3
  local task_id task_root task_patch task_authority_report task_authority_rc integration combined changed changed_path task_overlap
  local changed_path_index changed_path_owner_index existing_owner
  local integration_failed=0
  local -a changed_paths=()
  local -a changed_path_owners=()
  mkdir -p "$patch_dir"
  integration="$temp_root/integration"
  create_execution_worktree "$snapshot" "$integration"

  while [ "$#" -ge 2 ]; do
    task_id="$1"
    task_root="$2"
    shift 2
    git -C "$task_root" add -N -- . >/dev/null 2>&1 || true
    changed="$(git -C "$task_root" diff --name-only "$snapshot")"
    task_authority_report="$patch_dir/$task_id-write-authority.json"
    task_authority_rc=0
    printf '%s\n' "$changed" | node "$VALIDATION_CACHE_HELPER" authorize-paths \
      "$TASK_DETAILS_FILE" "$ARTIFACTS_RELATIVE" "$task_id" > "$task_authority_report" \
      || task_authority_rc=$?
    if [ "$task_authority_rc" -eq 3 ]; then
      printf 'Task %s attempted a protected or out-of-Scope change.\n' "$task_id" >> "$AGENT_LOG"
      cat "$task_authority_report" >> "$AGENT_LOG"
      integration_failed=1
      INTEGRATION_AUTHORITY_VIOLATION=1
      continue
    elif [ "$task_authority_rc" -ne 0 ]; then
      printf 'Task %s write-authority verification failed.\n' "$task_id" >> "$AGENT_LOG"
      integration_failed=1
      continue
    fi
    task_overlap=0
    while IFS= read -r changed_path; do
      [ -n "$changed_path" ] || continue
      existing_owner=""
      changed_path_index=0
      while [ "$changed_path_index" -lt "${#changed_paths[@]}" ]; do
        if [ "${changed_paths[$changed_path_index]}" = "$changed_path" ]; then
          existing_owner="${changed_path_owners[$changed_path_index]}"
          break
        fi
        changed_path_index=$((changed_path_index + 1))
      done
      if [ -n "$existing_owner" ]; then
        printf 'Tasks %s and %s both modify %s; parallel path overlap is prohibited.\n' \
          "$existing_owner" "$task_id" "$changed_path" >> "$AGENT_LOG"
        integration_failed=1
        task_overlap=1
      else
        changed_path_owner_index="${#changed_paths[@]}"
        changed_paths[$changed_path_owner_index]="$changed_path"
        changed_path_owners[$changed_path_owner_index]="$task_id"
      fi
    done <<< "$changed"
    task_patch="$patch_dir/$task_id.patch"
    git -C "$task_root" diff --binary "$snapshot" > "$task_patch"
    [ -s "$task_patch" ] || continue
    [ "$task_overlap" -eq 0 ] || continue
    if ! git -C "$integration" apply --check "$task_patch" || ! git -C "$integration" apply "$task_patch"; then
      printf 'Task %s patch conflicts during isolated integration.\n' "$task_id" >> "$AGENT_LOG"
      integration_failed=1
    fi
  done

  git -C "$integration" add -N -- . >/dev/null 2>&1 || true
  combined="$patch_dir/combined.patch"
  git -C "$integration" diff --binary "$snapshot" > "$combined"
  if [ "$integration_failed" -eq 0 ] && [ -s "$combined" ]; then
    if ! git -C "$PROJECT" apply --check "$combined" || ! git -C "$PROJECT" apply "$combined"; then
      printf 'Combined patch no longer applies to the primary working tree.\n' >> "$AGENT_LOG"
      integration_failed=1
    fi
  fi
  return "$integration_failed"
}

ensure_prompt_budget() {
  local path="$1" label="$2" size
  [ "$MAX_PROMPT_BYTES" -gt 0 ] || return 0
  size="$(wc -c < "$path")"
  if [ "$size" -gt "$MAX_PROMPT_BYTES" ]; then
    die "$label prompt is $size bytes, exceeding --max-prompt-bytes=$MAX_PROMPT_BYTES"
  fi
}

provider_rate_limited() {
  local exit_code="$2"
  [ "$exit_code" -eq 75 ]
}

provider_wait_seconds() {
  local path="$1" requested
  requested="$(sed -n 's/^RB_RALPH_RETRY_AFTER:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$path" | tail -n 1)"
  [ -n "$requested" ] || requested="$RATE_LIMIT_WAIT"
  if [ "$requested" -gt "$MAX_RATE_LIMIT_WAIT" ]; then
    requested="$MAX_RATE_LIMIT_WAIT"
  fi
  printf '%s\n' "$requested"
}

reset_task_call_outputs() {
  local phase_submission
  # The prompt is an output of the call, not durable prior evidence. It was
  # once byte-stable, so rewriting it in place was invisible; now that it
  # carries pre-loaded repository context it legitimately differs between two
  # invocations of the same logical attempt, and leaving the stale one behind
  # would make the control-plane snapshot read the orchestrator's own
  # bookkeeping as forged evidence. This applies to a phase call as much as to
  # a task call, so it runs before the execution-unit check.
  rm -f -- "$AGENT_PROMPT" "$AGENT_LOG" \
    "$USAGE_DIR/$(basename "${AGENT_LOG%.log}").usage.json" \
    "$STATE_DIR/activity/$(basename "${AGENT_LOG%.log}").tsv" \
    "$CONTEXT_EFFICIENCY_DIR/$(basename "${AGENT_LOG%.log}").json"
  phase_submission="$STATE_DIR/evidence/$(basename "${AGENT_LOG%.log}")-agent-submission"
  [ ! -d "$phase_submission" ] || rm -rf -- "$phase_submission"
  [ "$EXECUTION_UNIT" = "task" ] || return 0
  local current_task task_log task_usage task_submission task_prompt task_activity task_boundary
  rm -f -- "$AGENT_LOG"
  for current_task in "${PENDING_TASK_IDS[@]+"${PENDING_TASK_IDS[@]}"}"; do
    task_log="$STATE_DIR/logs/$phase_id-$current_task-attempt-$attempt-agent.log"
    task_usage="$USAGE_DIR/$phase_id-$current_task-attempt-$attempt-agent.usage.json"
    task_submission="$STATE_DIR/evidence/$phase_id-$current_task-attempt-$attempt-agent-submission"
    # The prompt is an output of the call, not durable prior evidence. It was
    # once byte-stable, so rewriting it in place was invisible; now that it
    # carries pre-loaded repository context it legitimately differs between two
    # reinvocations of the same logical attempt, and leaving the old one in
    # place would make the control-plane snapshot read that as forged evidence.
    task_prompt="$STATE_DIR/prompts/$phase_id-$current_task-attempt-$attempt-agent.txt"
    task_activity="$STATE_DIR/activity/$phase_id-$current_task-attempt-$attempt-agent.tsv"
    task_boundary="$STATE_DIR/evidence/$phase_id-$current_task-attempt-$attempt-write-boundary-before.json"
    rm -f -- "$task_log" "$task_usage" "$task_prompt" "$task_activity" \
      "$task_boundary" \
      "$CONTEXT_EFFICIENCY_DIR/$(basename "${task_log%.log}").json"
    [ ! -d "$task_submission" ] || rm -rf -- "$task_submission"
  done
}

configure_pending_tasks() {
  local selection="${1:-*}" task_row task_done task_parallel task_title pending_set dependency_id
  PENDING_TASK_IDS=()
  PENDING_TASK_DEPS=()
  all_pending_parallel=1
  while IFS= read -r task_row; do
    IFS="$TSV_SEPARATOR" read -r task_id task_done task_parallel task_depends task_title \
      <<< "${task_row//$'\t'/$TSV_SEPARATOR}"
    [ "$task_id" = "task_id" ] && continue
    [ "$task_done" = "false" ] || continue
    if [ "$selection" != "*" ] && [[ ",$selection," != *",$task_id,"* ]]; then continue; fi
    PENDING_TASK_IDS+=("$task_id")
    PENDING_TASK_DEPS+=("$task_depends")
    [ "$task_parallel" = "true" ] || all_pending_parallel=0
  done <<< "$TASKS"

  pending_set=","
  for task_id in "${PENDING_TASK_IDS[@]+"${PENDING_TASK_IDS[@]}"}"; do pending_set+="$task_id,"; done
  for task_depends in "${PENDING_TASK_DEPS[@]+"${PENDING_TASK_DEPS[@]}"}"; do
    IFS=',' read -r -a dependency_ids <<< "$task_depends"
    for dependency_id in "${dependency_ids[@]+"${dependency_ids[@]}"}"; do
      [ -z "$dependency_id" ] && continue
      if [[ "$pending_set" == *",$dependency_id,"* ]]; then all_pending_parallel=0; fi
    done
  done
  use_parallel=0
  if [ "$PARALLEL_LIMIT" -gt 1 ] && [ "${#PENDING_TASK_IDS[@]}" -gt 1 ] && [ "$all_pending_parallel" -eq 1 ]; then
    use_parallel=1
  fi
  if [ "$use_parallel" -eq 1 ] && [ "$ISOLATION" != "worktree" ]; then
    die "$phase_id has parallel-safe tasks, but parallel execution requires --isolation worktree to prevent agent interference"
  fi
}

localize_retry_tasks() {
  local report="$1" selection_file selection_csv selection_rc=0
  selection_file="$STATE_DIR/evidence/$phase_id-attempt-$attempt-retry-selection.json"
  if [ -s "$report" ]; then
    node "$MANAGER_AUDIT_HELPER" retry-selection "$TASK_DETAILS_FILE" "$report" > "$selection_file" \
      || selection_rc=$?
  else
    selection_rc=3
    printf '%s\n' '{"contract":"rb-ralph-retry-selection/v1","localized":false,"fallback":true,"taskIds":[],"criteria":[],"reason":"manager report has no structured task IDs"}' > "$selection_file"
  fi
  if [ "$selection_rc" -eq 0 ]; then
    selection_csv="$(node -e 'const r=JSON.parse(require("node:fs").readFileSync(process.argv[1],"utf8"));process.stdout.write((r.taskIds??[]).join(","))' "$selection_file")"
  else
    selection_csv=""
  fi
  if [ -n "$selection_csv" ]; then
    configure_pending_tasks "$selection_csv"
    record_event "$phase_id" "$attempt" "RETRY_SCOPE_LOCALIZED" \
      "next executor task closure=$selection_csv; selection=${selection_file#"$PROJECT/"}"
    log "$phase_id localized retry to task closure: $selection_csv"
  else
    configure_pending_tasks "*"
    record_event "$phase_id" "$attempt" "RETRY_SCOPE_FALLBACK" \
      "structured finding lacked a deterministic task mapping; conservatively repeating declared pending tasks; selection=${selection_file#"$PROJECT/"}"
    log "$phase_id retry scope fallback: manager finding did not identify a deterministic task closure"
  fi
}

resolve_artifacts_directory() {
  local candidate="$ARTIFACTS_DIR_INPUT"
  [ -n "$candidate" ] || die "--artifacts-dir must not be empty"
  if [[ "$candidate" != /* ]]; then candidate="$PROJECT/$candidate"; fi
  [ -d "$candidate" ] || die "Artifact/fragment directory does not exist: $ARTIFACTS_DIR_INPUT"
  [ ! -L "$candidate" ] || die "Artifact/fragment directory must not be a symbolic link: $ARTIFACTS_DIR_INPUT"
  ARTIFACTS_DIR="$(cd "$candidate" && pwd -P)"
  case "$ARTIFACTS_DIR" in
    "$PROJECT") die "Artifact/fragment directory must be a child of the project, not the project root" ;;
    "$PROJECT"/*) ;;
    *) die "Artifact/fragment directory must be inside the project: $ARTIFACTS_DIR_INPUT" ;;
  esac
  ARTIFACTS_RELATIVE="${ARTIFACTS_DIR#"$PROJECT/"}"
}

physical_artifact_path() {
  local logical_path="$1"
  case "$logical_path" in
    .rb/*) printf '%s/%s\n' "$ARTIFACTS_RELATIVE" "${logical_path#.rb/}" ;;
    "$ARTIFACTS_RELATIVE"/*) printf '%s\n' "$logical_path" ;;
    *) die "Artifact path escapes the selected artifact directory: $logical_path" ;;
  esac
}

require_profile_helper() {
  [ -f "$PROFILE_HELPER" ] || die "RB Ralph profile helper not found: $PROFILE_HELPER; reinstall the complete package"
  command -v node >/dev/null 2>&1 || die "Node.js is required for RB Ralph profiles and the interactive wizard"
}

run_profile_command() {
  require_profile_helper
  local operation="${2:-list}"
  case "$operation" in
    list)
      { [ "$#" -eq 1 ] || [ "$#" -eq 2 ]; } || die "Usage: rb-ralph profile list"
      node "$PROFILE_HELPER" list
      ;;
    show|delete)
      [ "$#" -eq 3 ] || die "Usage: rb-ralph profile $operation <name>"
      node "$PROFILE_HELPER" "$operation" "$3"
      ;;
    path)
      [ "$#" -eq 2 ] || die "Usage: rb-ralph profile path"
      node "$PROFILE_HELPER" path
      ;;
    *) die "Unknown profile command: $operation (use list, show, delete, or path)" ;;
  esac
}

PROFILE_LOADED_ARGS=()
load_profile_arguments() {
  local name="$1" output argument
  require_profile_helper
  if ! output="$(node "$PROFILE_HELPER" args "$name")"; then
    die "Could not load RB Ralph profile '$name'"
  fi
  PROFILE_LOADED_ARGS=()
  while IFS= read -r argument; do
    [ -z "$argument" ] || PROFILE_LOADED_ARGS+=("$argument")
  done <<< "$output"
}

argument_list_has() {
  local wanted="$1" current
  shift
  for current in "$@"; do
    [ "$current" != "$wanted" ] || return 0
  done
  return 1
}

expand_profile_arguments() {
  local profile_name="" current profile_flag value index skip_value
  local original_args=("$@") remaining_args=() merged_args=()
  index=0
  while [ "$index" -lt "${#original_args[@]}" ]; do
    current="${original_args[$index]}"
    if [ "$current" = "--profile" ]; then
      [ $((index + 1)) -lt "${#original_args[@]}" ] || die "--profile requires a name"
      [ -z "$profile_name" ] || die "--profile may only be provided once"
      profile_name="${original_args[$((index + 1))]}"
      index=$((index + 2))
      continue
    fi
    remaining_args+=("$current")
    index=$((index + 1))
  done
  [ -n "$profile_name" ] || { set -- "${remaining_args[@]}"; EXPANDED_ARGS=("$@"); return 0; }

  load_profile_arguments "$profile_name"
  index=0
  while [ "$index" -lt "${#PROFILE_LOADED_ARGS[@]}" ]; do
    profile_flag="${PROFILE_LOADED_ARGS[$index]}"
    value=""
    skip_value=0
    case "$profile_flag" in
      --final-audit|--no-final-audit|--dashboard|--no-dashboard|--yolo|--protected) ;;
      *)
        [ $((index + 1)) -lt "${#PROFILE_LOADED_ARGS[@]}" ] || die "Profile '$profile_name' emitted an incomplete option: $profile_flag"
        value="${PROFILE_LOADED_ARGS[$((index + 1))]}"
        skip_value=1
        ;;
    esac

    case "$profile_flag" in
      --agent-provider|--agent-cmd)
        if argument_list_has --provider "${remaining_args[@]}" ||
           argument_list_has --agent-provider "${remaining_args[@]}" ||
           argument_list_has --agent-cmd "${remaining_args[@]}"; then
          index=$((index + skip_value + 1)); continue
        fi
        ;;
      --manager-provider|--manager-cmd)
        if argument_list_has --provider "${remaining_args[@]}" ||
           argument_list_has --manager-provider "${remaining_args[@]}" ||
           argument_list_has --manager-cmd "${remaining_args[@]}"; then
          index=$((index + skip_value + 1)); continue
        fi
        ;;
      --agent-model)
        if argument_list_has --model "${remaining_args[@]}" || argument_list_has --agent-model "${remaining_args[@]}"; then
          index=$((index + skip_value + 1)); continue
        fi
        ;;
      --manager-model)
        if argument_list_has --model "${remaining_args[@]}" || argument_list_has --manager-model "${remaining_args[@]}"; then
          index=$((index + skip_value + 1)); continue
        fi
        ;;
      --agent-effort)
        if argument_list_has --effort "${remaining_args[@]}" || argument_list_has --agent-effort "${remaining_args[@]}"; then
          index=$((index + skip_value + 1)); continue
        fi
        ;;
      --manager-effort)
        if argument_list_has --effort "${remaining_args[@]}" || argument_list_has --manager-effort "${remaining_args[@]}"; then
          index=$((index + skip_value + 1)); continue
        fi
        ;;
      --agent-credential)
        if argument_list_has --credential "${remaining_args[@]}" || argument_list_has --agent-credential "${remaining_args[@]}"; then
          index=$((index + skip_value + 1)); continue
        fi
        ;;
      --manager-credential)
        if argument_list_has --credential "${remaining_args[@]}" || argument_list_has --manager-credential "${remaining_args[@]}"; then
          index=$((index + skip_value + 1)); continue
        fi
        ;;
    esac
    merged_args+=("$profile_flag")
    [ "$skip_value" -eq 0 ] || merged_args+=("$value")
    index=$((index + skip_value + 1))
  done
  EXPANDED_ARGS=("${merged_args[@]}" "${remaining_args[@]}")
}

WIZARD_REPLY=""
WIZARD_PROFILE_ARGS=()
WIZARD_RUN_ARGS=()

wizard_read() {
  local prompt="$1" default_value="${2:-}" entered
  if [ -n "$default_value" ]; then
    printf '%s [%s]: ' "$prompt" "$default_value" >&2
  else
    printf '%s: ' "$prompt" >&2
  fi
  if ! IFS= read -r entered; then
    printf '\nWizard cancelled: input stream ended.\n' >&2
    exit 130
  fi
  [ -n "$entered" ] || entered="$default_value"
  WIZARD_REPLY="$entered"
}

wizard_choice() {
  local prompt="$1" default_value="$2" allowed="$3" candidate item valid
  while true; do
    wizard_read "$prompt" "$default_value"
    candidate="$WIZARD_REPLY"
    valid=0
    for item in $allowed; do
      [ "$candidate" != "$item" ] || valid=1
    done
    if [ "$valid" -eq 1 ]; then WIZARD_REPLY="$candidate"; return 0; fi
    printf 'Escolha uma destas opções: %s\n' "$allowed" >&2
  done
}

wizard_args_have() {
  argument_list_has "$1" "${WIZARD_PROFILE_ARGS[@]+"${WIZARD_PROFILE_ARGS[@]}"}"
}

wizard_append_value() {
  WIZARD_PROFILE_ARGS+=("$1" "$2")
}

wizard_append_role() {
  local role="$1" label provider command model effort credential
  if [ "$role" = "agent" ]; then label="executor"; else label="gerente"; fi
  wizard_choice "Provider do $label (codex/claude/opencode/openai/anthropic/gemini/deepseek/minimax/openrouter/custom)" "codex" "codex claude opencode openai anthropic gemini deepseek minimax openrouter custom"
  provider="$WIZARD_REPLY"
  if [ "$provider" = "custom" ]; then
    wizard_read "Comando do adapter do $label" ""
    command="$WIZARD_REPLY"
    [ -n "$command" ] || { printf 'O comando do adapter não pode ficar vazio.\n' >&2; return 1; }
    wizard_append_value "--${role}-cmd" "$command"
  else
    wizard_append_value "--${role}-provider" "$provider"
  fi
  wizard_read "Modelo do $label (vazio usa o padrão do provider)" ""
  model="$WIZARD_REPLY"
  if is_direct_provider "$provider" && [ -z "$model" ]; then
    printf 'Providers de API direta exigem o ID explícito do modelo.\n' >&2
    return 1
  fi
  [ -z "$model" ] || wizard_append_value "--${role}-model" "$model"
  wizard_read "Effort do $label (vazio usa o padrão do provider)" ""
  effort="$WIZARD_REPLY"
  [ -z "$effort" ] || wizard_append_value "--${role}-effort" "$effort"
  if is_direct_provider "$provider"; then
    wizard_read "Credencial salva do $label (ID/rótulo; vazio usa a padrão)" ""
    credential="$WIZARD_REPLY"
    [ -z "$credential" ] || wizard_append_value "--${role}-credential" "$credential"
    printf '  Dica: rb-ralph --login configura o cofre compartilhado.\n'
  fi
}

wizard_print_command() {
  local argument
  printf '\nComando montado:\n  '
  printf '%q' "$SCRIPT_PATH"
  for argument in "${WIZARD_RUN_ARGS[@]}"; do printf ' %q' "$argument"; done
  printf '\n\n'
}

wizard_save_profile() {
  local name="$1" argument
  {
    for argument in "${WIZARD_PROFILE_ARGS[@]}"; do printf '%s\n' "$argument"; done
  } | node "$PROFILE_HELPER" save-args "$name"
}

wizard_once() {
  local project artifacts default_artifacts list_file row id path hash index selection
  local selected_plan profile_name origin description advanced answer parallel isolation action
  local plan_ids=() plan_paths=() profile_names=()

  printf '\nRB Ralph · execução assistida\n'
  printf 'O wizard apenas monta opções validadas; credenciais nunca são gravadas em perfis.\n\n'
  wizard_read "Pasta do projeto" "$INVOCATION_DIR"
  project="$WIZARD_REPLY"
  case "$project" in
    "~") project="$HOME" ;;
    "~/"*) project="$HOME/${project#~/}" ;;
  esac
  [ -d "$project" ] || { printf 'A pasta do projeto não existe: %s\n' "$project" >&2; return 10; }
  project="$(cd "$project" && pwd -P)"

  default_artifacts=".rb"
  [ ! -d "$project/.rb" ] || default_artifacts=".rb"
  if [ ! -d "$project/.rb" ] && [ -d "$project/.spec" ]; then default_artifacts=".spec"; fi
  wizard_read "Pasta dos artefatos/fragmentos (relativa ao projeto)" "$default_artifacts"
  artifacts="$WIZARD_REPLY"
  [ -d "$project/$artifacts" ] || { printf 'A pasta de artefatos não existe dentro do projeto: %s\n' "$artifacts" >&2; return 10; }

  list_file="$(mktemp "${TMPDIR:-/tmp}/rb-ralph-wizard.XXXXXX")"
  if ! "$SCRIPT_PATH" --project "$project" --artifacts-dir "$artifacts" --list --no-splash > "$list_file"; then
    rm -f -- "$list_file"
    printf 'Não foi possível descobrir planos prontos. Ajuste o projeto ou a pasta de artefatos.\n' >&2
    return 10
  fi
  while IFS= read -r row; do
    IFS="$TSV_SEPARATOR" read -r id path hash <<< "${row//$'\t'/$TSV_SEPARATOR}"
    [ "$id" != "artifact_id" ] || continue
    [ -n "$id" ] || continue
    plan_ids+=("$id")
    plan_paths+=("$path")
  done < "$list_file"
  rm -f -- "$list_file"
  [ "${#plan_ids[@]}" -gt 0 ] || { printf 'Nenhum plano rb-execution/v1 pronto foi encontrado.\n' >&2; return 10; }
  if [ "${#plan_ids[@]}" -eq 1 ]; then
    selected_plan="${plan_ids[0]}"
    printf 'Plano encontrado: %s (%s)\n' "$selected_plan" "${plan_paths[0]}"
  else
    printf '\nPlanos prontos:\n'
    index=0
    while [ "$index" -lt "${#plan_ids[@]}" ]; do
      printf '  %s) %s  [%s]\n' "$((index + 1))" "${plan_ids[$index]}" "${plan_paths[$index]}"
      index=$((index + 1))
    done
    while true; do
      wizard_read "Número do plano" "1"
      selection="$WIZARD_REPLY"
      if [[ "$selection" =~ ^[1-9][0-9]*$ ]] && [ "$selection" -le "${#plan_ids[@]}" ]; then break; fi
      printf 'Selecione um número entre 1 e %s.\n' "${#plan_ids[@]}" >&2
    done
    selected_plan="${plan_ids[$((selection - 1))]}"
  fi

  printf '\nPerfis disponíveis:\n'
  index=0
  while IFS="$TSV_SEPARATOR" read -r profile_name origin description; do
    [ "$profile_name" != "name" ] || continue
    [ -n "$profile_name" ] || continue
    profile_names+=("$profile_name")
    printf '  - %-12s %-8s %s\n' "$profile_name" "$origin" "$description"
  done <<< "$(node "$PROFILE_HELPER" list | tr '\t' "$TSV_SEPARATOR")"
  printf '  - manual       configure tudo agora\n'
  while true; do
    wizard_read "Perfil" "balanced"
    profile_name="$WIZARD_REPLY"
    [ "$profile_name" = "manual" ] && break
    if argument_list_has "$profile_name" "${profile_names[@]}"; then break; fi
    printf 'Perfil desconhecido: %s\n' "$profile_name" >&2
  done
  WIZARD_PROFILE_ARGS=()
  if [ "$profile_name" != "manual" ]; then
    load_profile_arguments "$profile_name"
    WIZARD_PROFILE_ARGS=("${PROFILE_LOADED_ARGS[@]}")
  fi

  if ! wizard_args_have --agent-provider && ! wizard_args_have --agent-cmd; then
    wizard_append_role agent || return 10
  fi
  if ! wizard_args_have --manager-provider && ! wizard_args_have --manager-cmd; then
    wizard_choice "Gerente usa o mesmo provider/comando do executor? (s/n)" "s" "s n"
    if [ "$WIZARD_REPLY" = "n" ]; then wizard_append_role manager || return 10; fi
  fi

  wizard_choice "Personalizar controles avançados? (s/n)" "n" "s n"
  advanced="$WIZARD_REPLY"
  if [ "$advanced" = "s" ]; then
    wizard_choice "Unidade de execução (task/phase)" "task" "task phase"
    wizard_append_value --execution-unit "$WIZARD_REPLY"
    wizard_choice "Auditoria do gerente (exhaustive/legacy)" "exhaustive" "exhaustive legacy"
    wizard_append_value --manager-audit "$WIZARD_REPLY"
    wizard_choice "Revisão do gerente (delivery/code)" "delivery" "delivery code"
    wizard_append_value --manager-review "$WIZARD_REPLY"
    wizard_choice "Auditoria final? (s/n)" "s" "s n"
    if [ "$WIZARD_REPLY" = "s" ]; then WIZARD_PROFILE_ARGS+=(--final-audit); else WIZARD_PROFILE_ARGS+=(--no-final-audit); fi
    wizard_choice "Dashboard? (s/n)" "s" "s n"
    if [ "$WIZARD_REPLY" = "s" ]; then WIZARD_PROFILE_ARGS+=(--dashboard); else WIZARD_PROFILE_ARGS+=(--no-dashboard); fi
    wizard_choice "Permissões (yolo/protected)" "yolo" "yolo protected"
    if [ "$WIZARD_REPLY" = "yolo" ]; then WIZARD_PROFILE_ARGS+=(--yolo); else WIZARD_PROFILE_ARGS+=(--protected); fi
    while true; do
      wizard_read "Quantidade máxima de agentes paralelos" "1"
      parallel="$WIZARD_REPLY"
      [[ "$parallel" =~ ^[1-9][0-9]*$ ]] && break
      printf 'Informe um inteiro positivo.\n' >&2
    done
    wizard_append_value --parallel "$parallel"
    if [ "$parallel" -gt 1 ]; then isolation="worktree"; else isolation="shared"; fi
    wizard_choice "Isolamento (shared/worktree)" "$isolation" "shared worktree"
    isolation="$WIZARD_REPLY"
    if [ "$parallel" -gt 1 ] && [ "$isolation" != "worktree" ]; then
      printf 'Execução paralela exige isolamento worktree; ajustado automaticamente.\n' >&2
      isolation="worktree"
    fi
    wizard_append_value --isolation "$isolation"
    wizard_read "Timeout da primeira saída do executor em segundos (0 desativa)" "300"
    [[ "$WIZARD_REPLY" =~ ^[0-9]+$ ]] || { printf 'Timeout inválido.\n' >&2; return 10; }
    wizard_append_value --agent-first-output-timeout "$WIZARD_REPLY"
    wizard_read "Timeout da primeira saída do gerente em segundos (0 desativa)" "180"
    [[ "$WIZARD_REPLY" =~ ^[0-9]+$ ]] || { printf 'Timeout inválido.\n' >&2; return 10; }
    wizard_append_value --manager-first-output-timeout "$WIZARD_REPLY"
  fi

  WIZARD_RUN_ARGS=(--project "$project" --artifacts-dir "$artifacts" --plan "$selected_plan")
  WIZARD_RUN_ARGS+=("${WIZARD_PROFILE_ARGS[@]}")
  wizard_print_command
  wizard_choice "Ação: executar/salvar/mostrar/reiniciar/cancelar" "executar" "executar salvar mostrar reiniciar cancelar"
  action="$WIZARD_REPLY"
  case "$action" in
    executar)
      exec "$SCRIPT_PATH" "${WIZARD_RUN_ARGS[@]}"
      ;;
    salvar)
      wizard_read "Nome do perfil ([a-z0-9-])" "meu-perfil"
      wizard_save_profile "$WIZARD_REPLY"
      exec "$SCRIPT_PATH" "${WIZARD_RUN_ARGS[@]}"
      ;;
    mostrar) return 0 ;;
    reiniciar) return 10 ;;
    cancelar) printf 'Execução cancelada; nenhum provider foi iniciado.\n'; return 0 ;;
  esac
}

run_wizard() {
  require_profile_helper
  play_splash
  while true; do
    if wizard_once; then return 0; fi
    printf '\nReiniciando o assistente...\n' >&2
  done
}

if [ "$#" -eq 0 ]; then
  if [ -t 0 ] && [ -t 1 ]; then
    run_wizard
    exit 0
  fi
  usage
  printf '\nERROR: No options were provided and stdin/stdout are not interactive; use --wizard in a terminal or pass a complete command.\n' >&2
  exit 2
fi

if [ "${1:-}" = "provider" ]; then
  case "${2:-}" in
    list|test)
      resolve_core_cli
      RB_PROVIDER_CLI_NAME=rb-ralph core_cli_call "$@"
      exit $?
      ;;
    *) die "provider requires list or test" ;;
  esac
fi

if [ "${1:-}" = "profile" ]; then
  run_profile_command "$@"
  exit 0
fi

if [ "${1:-}" = "--wizard" ]; then
  [ "$#" -eq 1 ] || die "--wizard does not accept additional options; answer them interactively"
  run_wizard
  exit 0
fi

if [ "${1:-}" = "--login" ]; then
  [ "$#" -eq 1 ] || die "--login does not accept credentials or provider options on the command line; answer them interactively"
  resolve_core_cli
  core_cli_call auth login
  exit $?
fi

EXPANDED_ARGS=()
expand_profile_arguments "$@"
set -- "${EXPANDED_ARGS[@]}"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --project)
      [ "$#" -ge 2 ] || die "--project requires a path"
      PROJECT="$2"
      shift 2
      ;;
    --plan)
      [ "$#" -ge 2 ] || die "--plan requires an artifact ID or path"
      PLAN_SELECTOR="$2"
      shift 2
      ;;
    --artifacts-dir|--fragments-dir)
      [ "$#" -ge 2 ] || die "$1 requires a directory"
      ARTIFACTS_DIR_INPUT="$2"
      shift 2
      ;;
    --core-cli)
      [ "$#" -ge 2 ] || die "--core-cli requires a path"
      CORE_CLI_OPTION="$2"
      shift 2
      ;;
    --agent-cmd)
      [ "$#" -ge 2 ] || die "--agent-cmd requires a command"
      CLI_AGENT_CMD="$2"
      CLI_AGENT_CMD_SET=1
      shift 2
      ;;
    --manager-cmd)
      [ "$#" -ge 2 ] || die "--manager-cmd requires a command"
      CLI_MANAGER_CMD="$2"
      CLI_MANAGER_CMD_SET=1
      shift 2
      ;;
    --provider)
      [ "$#" -ge 2 ] || die "--provider requires a supported CLI or direct API provider"
      SHARED_PROVIDER="$2"
      SHARED_PROVIDER_SET=1
      shift 2
      ;;
    --agent-provider)
      [ "$#" -ge 2 ] || die "--agent-provider requires a supported CLI or direct API provider"
      CLI_AGENT_PROVIDER="$2"
      CLI_AGENT_PROVIDER_SET=1
      shift 2
      ;;
    --manager-provider)
      [ "$#" -ge 2 ] || die "--manager-provider requires a supported CLI or direct API provider"
      CLI_MANAGER_PROVIDER="$2"
      CLI_MANAGER_PROVIDER_SET=1
      shift 2
      ;;
    --model)
      [ "$#" -ge 2 ] && [ -n "$2" ] || die "--model requires a model ID"
      CLI_SHARED_MODEL="$2"
      CLI_SHARED_MODEL_SET=1
      shift 2
      ;;
    --agent-model)
      [ "$#" -ge 2 ] && [ -n "$2" ] || die "--agent-model requires a model ID"
      CLI_AGENT_MODEL="$2"
      CLI_AGENT_MODEL_SET=1
      shift 2
      ;;
    --manager-model)
      [ "$#" -ge 2 ] && [ -n "$2" ] || die "--manager-model requires a model ID"
      CLI_MANAGER_MODEL="$2"
      CLI_MANAGER_MODEL_SET=1
      shift 2
      ;;
    --effort)
      [ "$#" -ge 2 ] && [ -n "$2" ] || die "--effort requires a reasoning-effort level"
      CLI_SHARED_EFFORT="$2"
      CLI_SHARED_EFFORT_SET=1
      shift 2
      ;;
    --agent-effort)
      [ "$#" -ge 2 ] && [ -n "$2" ] || die "--agent-effort requires a reasoning-effort level"
      CLI_AGENT_EFFORT="$2"
      CLI_AGENT_EFFORT_SET=1
      shift 2
      ;;
    --manager-effort)
      [ "$#" -ge 2 ] && [ -n "$2" ] || die "--manager-effort requires a reasoning-effort level"
      CLI_MANAGER_EFFORT="$2"
      CLI_MANAGER_EFFORT_SET=1
      shift 2
      ;;
    --credential)
      [ "$#" -ge 2 ] && [ -n "$2" ] || die "--credential requires a saved credential ID or label"
      CLI_SHARED_CREDENTIAL="$2"
      CLI_SHARED_CREDENTIAL_SET=1
      shift 2
      ;;
    --agent-credential)
      [ "$#" -ge 2 ] && [ -n "$2" ] || die "--agent-credential requires a saved credential ID or label"
      CLI_AGENT_CREDENTIAL="$2"
      CLI_AGENT_CREDENTIAL_SET=1
      shift 2
      ;;
    --manager-credential)
      [ "$#" -ge 2 ] && [ -n "$2" ] || die "--manager-credential requires a saved credential ID or label"
      CLI_MANAGER_CREDENTIAL="$2"
      CLI_MANAGER_CREDENTIAL_SET=1
      shift 2
      ;;
    --max-attempts)
      [ "$#" -ge 2 ] || die "--max-attempts requires a number"
      MAX_ATTEMPTS="$2"
      shift 2
      ;;
    --max-total-attempts)
      [ "$#" -ge 2 ] || die "--max-total-attempts requires a number"
      MAX_TOTAL_ATTEMPTS="$2"
      shift 2
      ;;
    --max-strategy-resets)
      [ "$#" -ge 2 ] || die "--max-strategy-resets requires a number"
      MAX_STRATEGY_RESETS="$2"
      shift 2
      ;;
    --manager-retries)
      [ "$#" -ge 2 ] || die "--manager-retries requires a number"
      MAX_MANAGER_RETRIES="$2"
      shift 2
      ;;
    --manager-retry-wait)
      [ "$#" -ge 2 ] || die "--manager-retry-wait requires seconds"
      MANAGER_RETRY_WAIT="$2"
      shift 2
      ;;
    --agent-timeout)
      [ "$#" -ge 2 ] || die "--agent-timeout requires seconds"
      AGENT_TIMEOUT="$2"
      shift 2
      ;;
    --agent-idle-timeout)
      [ "$#" -ge 2 ] || die "--agent-idle-timeout requires seconds"
      AGENT_IDLE_TIMEOUT="$2"
      shift 2
      ;;
    --agent-first-output-timeout)
      [ "$#" -ge 2 ] || die "--agent-first-output-timeout requires seconds"
      AGENT_FIRST_OUTPUT_TIMEOUT="$2"
      shift 2
      ;;
    --manager-timeout)
      [ "$#" -ge 2 ] || die "--manager-timeout requires seconds"
      MANAGER_TIMEOUT="$2"
      shift 2
      ;;
    --manager-idle-timeout)
      [ "$#" -ge 2 ] || die "--manager-idle-timeout requires seconds"
      MANAGER_IDLE_TIMEOUT="$2"
      shift 2
      ;;
    --manager-first-output-timeout)
      [ "$#" -ge 2 ] || die "--manager-first-output-timeout requires seconds"
      MANAGER_FIRST_OUTPUT_TIMEOUT="$2"
      shift 2
      ;;
    --manager-review)
      [ "$#" -ge 2 ] || die "--manager-review requires delivery or code"
      MANAGER_REVIEW_MODE="$2"
      shift 2
      ;;
    --manager-audit)
      [ "$#" -ge 2 ] || die "--manager-audit requires exhaustive or legacy"
      MANAGER_AUDIT_MODE="$2"
      shift 2
      ;;
    --execution-unit)
      [ "$#" -ge 2 ] || die "--execution-unit requires task or phase"
      EXECUTION_UNIT="$2"
      shift 2
      ;;
    --validation-mode)
      [ "$#" -ge 2 ] || die "--validation-mode requires run or manager"
      VALIDATION_MODE="$2"
      shift 2
      ;;
    --validation-timeout)
      [ "$#" -ge 2 ] || die "--validation-timeout requires seconds"
      VALIDATION_TIMEOUT="$2"
      shift 2
      ;;
    --parallel)
      [ "$#" -ge 2 ] || die "--parallel requires a number"
      PARALLEL_LIMIT="$2"
      shift 2
      ;;
    --max-prompt-bytes)
      [ "$#" -ge 2 ] || die "--max-prompt-bytes requires a number"
      MAX_PROMPT_BYTES="$2"
      shift 2
      ;;
    --rate-limit-wait)
      [ "$#" -ge 2 ] || die "--rate-limit-wait requires seconds"
      RATE_LIMIT_WAIT="$2"
      shift 2
      ;;
    --max-limit-waits)
      [ "$#" -ge 2 ] || die "--max-limit-waits requires a number"
      MAX_RATE_LIMIT_WAITS="$2"
      shift 2
      ;;
    --max-limit-wait)
      [ "$#" -ge 2 ] || die "--max-limit-wait requires seconds"
      MAX_RATE_LIMIT_WAIT="$2"
      shift 2
      ;;
    --no-agent-context)
      AGENT_CONTEXT=0
      shift
      ;;
    --agent-context-bytes)
      [ "$#" -ge 2 ] || die "--agent-context-bytes requires a byte budget"
      case "$2" in ''|*[!0-9]*) die "--agent-context-bytes requires a non-negative integer" ;; esac
      AGENT_CONTEXT_BYTES="$2"
      shift 2
      ;;
    --isolation)
      [ "$#" -ge 2 ] || die "--isolation requires shared or worktree"
      ISOLATION="$2"
      shift 2
      ;;
    --memory-url)
      [ "$#" -ge 2 ] || die "--memory-url requires a Streamable HTTP MCP URL"
      MEMORY_MCP_URL="$2"
      shift 2
      ;;
    --memory-mode)
      [ "$#" -ge 2 ] || die "--memory-mode requires off, required, or best-effort"
      MEMORY_MODE="$2"
      shift 2
      ;;
    --memory-token-env)
      [ "$#" -ge 2 ] || die "--memory-token-env requires an environment variable name"
      MEMORY_TOKEN_ENV="$2"
      shift 2
      ;;
    --memory-cli)
      [ "$#" -ge 2 ] || die "--memory-cli requires a path"
      MEMORY_CLI="$2"
      shift 2
      ;;
    --pricing-file)
      [ "$#" -ge 2 ] || die "--pricing-file requires a JSON file"
      PRICING_FILE="$2"
      shift 2
      ;;
    --operations|--operational-contract)
      [ "$#" -ge 2 ] || die "$1 requires a path"
      OPERATIONAL_CONTRACT_OPTION="$2"
      shift 2
      ;;
    --final-audit)
      FINAL_AUDIT=1
      shift
      ;;
    --no-final-audit)
      FINAL_AUDIT=0
      shift
      ;;
    --yolo)
      CLI_PERMISSION_MODE="yolo"
      CLI_PERMISSION_MODE_SET=1
      shift
      ;;
    --protected)
      CLI_PERMISSION_MODE="protected"
      CLI_PERMISSION_MODE_SET=1
      shift
      ;;
    --splash)
      RB_RALPH_SPLASH_SHOWN=0 play_splash
      exit 0
      ;;
    --no-splash)
      SPLASH=0
      shift
      ;;
    --dashboard|--tui)
      DASHBOARD=1
      shift
      ;;
    --no-dashboard)
      DASHBOARD=0
      shift
      ;;
    --watch)
      WATCH_ONLY=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --list)
      LIST_ONLY=1
      shift
      ;;
    -V|--ver|--version)
      print_version
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "Unknown option: $1"
      ;;
  esac
done

[[ "$MAX_ATTEMPTS" =~ ^[1-9][0-9]*$ ]] || die "--max-attempts must be a positive integer"
[[ "$MAX_TOTAL_ATTEMPTS" =~ ^[0-9]+$ ]] || die "--max-total-attempts must be a non-negative integer"
[[ "$MAX_STRATEGY_RESETS" =~ ^[0-9]+$ ]] || die "--max-strategy-resets must be a non-negative integer"
[[ "$MAX_MANAGER_RETRIES" =~ ^[0-9]+$ ]] || die "--manager-retries must be a non-negative integer"
[[ "$MANAGER_RETRY_WAIT" =~ ^[0-9]+$ ]] || die "--manager-retry-wait must be a non-negative integer"
[[ "$MAX_INCOMPLETE_RETRIES" =~ ^[0-9]+$ ]] || die "RB_RALPH_MAX_INCOMPLETE_RETRIES must be a non-negative integer"
[[ "$AGENT_TIMEOUT" =~ ^[0-9]+$ ]] || die "--agent-timeout must be a non-negative integer"
[[ "$AGENT_IDLE_TIMEOUT" =~ ^[0-9]+$ ]] || die "--agent-idle-timeout must be a non-negative integer"
[[ "$AGENT_FIRST_OUTPUT_TIMEOUT" =~ ^[0-9]+$ ]] || die "--agent-first-output-timeout must be a non-negative integer"
[[ "$MANAGER_TIMEOUT" =~ ^[0-9]+$ ]] || die "--manager-timeout must be a non-negative integer"
[[ "$MANAGER_IDLE_TIMEOUT" =~ ^[0-9]+$ ]] || die "--manager-idle-timeout must be a non-negative integer"
[[ "$MANAGER_FIRST_OUTPUT_TIMEOUT" =~ ^[0-9]+$ ]] || die "--manager-first-output-timeout must be a non-negative integer"
[[ "$VALIDATION_TIMEOUT" =~ ^[0-9]+$ ]] || die "--validation-timeout must be a non-negative integer"
[[ "$PARALLEL_LIMIT" =~ ^[1-9][0-9]*$ ]] || die "--parallel must be a positive integer"
[[ "$MAX_PROMPT_BYTES" =~ ^[0-9]+$ ]] || die "--max-prompt-bytes must be a non-negative integer"
[[ "$RATE_LIMIT_WAIT" =~ ^[0-9]+$ ]] || die "--rate-limit-wait must be a non-negative integer"
[[ "$MAX_RATE_LIMIT_WAITS" =~ ^[0-9]+$ ]] || die "--max-limit-waits must be a non-negative integer"
[[ "$MAX_RATE_LIMIT_WAIT" =~ ^[0-9]+$ ]] || die "--max-limit-wait must be a non-negative integer"
[[ "$CONTEXT_SOFT_COMMAND_LIMIT" =~ ^[0-9]+$ ]] || die "RB_RALPH_CONTEXT_SOFT_COMMAND_LIMIT must be a non-negative integer"
[[ "$CONTEXT_SOFT_OUTPUT_BYTES" =~ ^[0-9]+$ ]] || die "RB_RALPH_CONTEXT_SOFT_OUTPUT_BYTES must be a non-negative integer"
[[ "$CONTEXT_HARD_COMMAND_LIMIT" =~ ^[0-9]+$ ]] || die "RB_RALPH_CONTEXT_HARD_COMMAND_LIMIT must be a non-negative integer"
[[ "$CONTEXT_HARD_OUTPUT_BYTES" =~ ^[0-9]+$ ]] || die "RB_RALPH_CONTEXT_HARD_OUTPUT_BYTES must be a non-negative integer"
case "$FINAL_AUDIT" in
  0|1) ;;
  *) die "RB_RALPH_FINAL_AUDIT must be 0 or 1" ;;
esac
case "$SPLASH" in
  0|1) ;;
  *) die "RB_RALPH_SPLASH must be 0 or 1" ;;
esac
case "$VALIDATION_MODE" in
  run|manager) ;;
  *) die "--validation-mode must be run or manager" ;;
esac
case "$MANAGER_REVIEW_MODE" in
  delivery|code) ;;
  *) die "--manager-review must be delivery or code" ;;
esac
case "$MANAGER_AUDIT_MODE" in
  exhaustive|legacy) ;;
  *) die "--manager-audit must be exhaustive or legacy" ;;
esac
case "$EXECUTION_UNIT" in
  task|phase) ;;
  *) die "--execution-unit must be task or phase" ;;
esac
case "$ISOLATION" in
  shared|worktree) ;;
  *) die "--isolation must be shared or worktree" ;;
esac
if [ "$CLI_PERMISSION_MODE_SET" -eq 1 ]; then
  PERMISSION_MODE="$CLI_PERMISSION_MODE"
elif [ -n "$ENV_PERMISSION_MODE" ]; then
  PERMISSION_MODE="$ENV_PERMISSION_MODE"
fi
case "$PERMISSION_MODE" in
  yolo|protected) ;;
  *) die "RB Ralph permission mode must be yolo or protected" ;;
esac
if [ -z "$MEMORY_MODE" ]; then
  if [ -n "$MEMORY_MCP_URL" ]; then MEMORY_MODE="required"; else MEMORY_MODE="off"; fi
fi
case "$MEMORY_MODE" in
  off|required|best-effort) ;;
  *) die "--memory-mode must be off, required, or best-effort" ;;
esac
if [ "$SPLASH" -eq 1 ] && [ "$LIST_ONLY" -eq 0 ] && [ "$DRY_RUN" -eq 0 ]; then
  play_splash
fi

if [ "$WATCH_ONLY" -eq 1 ]; then
  [ -d "$PROJECT" ] || die "Project directory does not exist: $PROJECT"
  [ -x "$DASHBOARD_CLI" ] || die "RB Ralph dashboard not found: $DASHBOARD_CLI; reinstall the complete package"
  exec "$DASHBOARD_CLI" --project "$PROJECT"
fi
if [ -n "$PRICING_FILE" ]; then
  if [[ "$PRICING_FILE" != /* ]]; then PRICING_FILE="$INVOCATION_DIR/$PRICING_FILE"; fi
  [ -f "$PRICING_FILE" ] || die "Pricing file does not exist: $PRICING_FILE"
  node -e 'JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"))' "$PRICING_FILE" \
    || die "Pricing file is not valid JSON: $PRICING_FILE"
fi
resolve_core_cli
if [ "$MEMORY_MODE" != "off" ]; then
  [ -n "$MEMORY_MCP_URL" ] || die "--memory-url is required when memory mode is enabled"
  [[ "$MEMORY_TOKEN_ENV" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "--memory-token-env must be a valid environment variable name"
  if [ -z "${!MEMORY_TOKEN_ENV:-}" ]; then
    memory_failure "token environment variable $MEMORY_TOKEN_ENV is empty"
    MEMORY_MODE="off"
  fi
  if [[ "$MEMORY_CLI" == *.js ]]; then
    [ -f "$MEMORY_CLI" ] || { memory_failure "RB Memory CLI not found: $MEMORY_CLI"; MEMORY_MODE="off"; }
  elif [[ "$MEMORY_CLI" == */* ]]; then
    [ -x "$MEMORY_CLI" ] || { memory_failure "RB Memory CLI is not executable: $MEMORY_CLI"; MEMORY_MODE="off"; }
  else
    command -v "$MEMORY_CLI" >/dev/null 2>&1 || { memory_failure "RB Memory CLI was not found on PATH: $MEMORY_CLI"; MEMORY_MODE="off"; }
  fi
fi
[ -d "$PROJECT" ] || die "Project directory does not exist: $PROJECT"
PROJECT="$(cd "$PROJECT" && pwd -P)"
resolve_artifacts_directory
if [ "$ISOLATION" = "worktree" ]; then
  git -C "$PROJECT" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "worktree isolation requires a Git repository"
  git -C "$PROJECT" rev-parse --verify HEAD >/dev/null 2>&1 || die "worktree isolation requires an initial commit"
fi

if [ -f "$ARTIFACTS_DIR/rb-manifest.json" ]; then
  if ! RESOLVED="$(core_cli_call tree resolve "$PROJECT" --artifacts-dir "$ARTIFACTS_DIR" --kind execution-plan --status ready --format tsv)"; then
    die "Artifact discovery failed in $ARTIFACTS_RELATIVE; no provider was started"
  fi
else
  [ -f "$FRAGMENT_DISCOVERY_HELPER" ] \
    || die "Manifest-less fragment discovery helper not found; reinstall the complete RB Ralph package"
  DISCOVERY_TEMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/rb-ralph-fragments.XXXXXX")"
  trap cleanup_discovery_temp EXIT INT TERM
  if ! RESOLVED="$(node "$FRAGMENT_DISCOVERY_HELPER" discover "$PROJECT" "$ARTIFACTS_DIR" "$DISCOVERY_TEMP_ROOT")"; then
    cleanup_discovery_temp
    die "Compatible fragment discovery failed in $ARTIFACTS_RELATIVE; no provider was started"
  fi
fi

PLAN_IDS=()
PLAN_PATHS=()
PLAN_HASHES=()
PLAN_CANONICAL_PATHS=()
PLAN_SOURCE_FORMATS=()
while IFS= read -r tsv_row; do
  IFS="$TSV_SEPARATOR" read -r id kind status contract path sha256 canonical_path source_format \
    <<< "${tsv_row//$'\t'/$TSV_SEPARATOR}"
  case "$id" in
    \#*|id|"") continue ;;
  esac
  [ "$kind" = "execution-plan" ] || continue
  [ "$status" = "ready" ] || continue
  [ "$contract" = "rb-execution/v1" ] || die "Unsupported execution contract for $id: $contract"
  if [ -n "${canonical_path:-}" ]; then
    [ -f "$canonical_path" ] || die "Imported canonical plan is missing for $id"
    core_cli_call contract inspect "$canonical_path" --format tsv >/dev/null \
      || die "Imported plan $path is not a valid rb-execution/v1 contract; no provider was started"
  else
    path="$(physical_artifact_path "$path")"
  fi
  PLAN_IDS+=("$id")
  PLAN_PATHS+=("$path")
  PLAN_HASHES+=("$sha256")
  PLAN_CANONICAL_PATHS+=("${canonical_path:-}")
  PLAN_SOURCE_FORMATS+=("${source_format:-rb-manifest/v1}")
done <<< "$RESOLVED"

if [ "$LIST_ONLY" -eq 1 ]; then
  printf 'artifact_id\tpath\tsha256\n'
  index=0
  while [ "$index" -lt "${#PLAN_IDS[@]}" ]; do
    printf '%s\t%s\t%s\n' "${PLAN_IDS[$index]}" "${PLAN_PATHS[$index]}" "${PLAN_HASHES[$index]}"
    index=$((index + 1))
  done
  cleanup_discovery_temp
  exit 0
fi

[ "${#PLAN_IDS[@]}" -gt 0 ] || die "No ready rb-execution/v1 plans were found"

SELECTED=-1
if [ -n "$PLAN_SELECTOR" ]; then
  index=0
  while [ "$index" -lt "${#PLAN_IDS[@]}" ]; do
    if [ "${PLAN_IDS[$index]}" = "$PLAN_SELECTOR" ] || [ "${PLAN_PATHS[$index]}" = "$PLAN_SELECTOR" ]; then
      SELECTED="$index"
      break
    fi
    index=$((index + 1))
  done
  [ "$SELECTED" -ge 0 ] || die "Ready plan not found: $PLAN_SELECTOR"
elif [ "${#PLAN_IDS[@]}" -eq 1 ]; then
  SELECTED=0
else
  printf 'Multiple ready plans found; select one with --plan:\n' >&2
  index=0
  while [ "$index" -lt "${#PLAN_IDS[@]}" ]; do
    printf '  %s\t%s\n' "${PLAN_IDS[$index]}" "${PLAN_PATHS[$index]}" >&2
    index=$((index + 1))
  done
  exit 1
fi

PLAN_ID="${PLAN_IDS[$SELECTED]}"
PLAN_PATH="${PLAN_PATHS[$SELECTED]}"
PLAN_HASH="${PLAN_HASHES[$SELECTED]}"
PLAN_SOURCE_FORMAT="${PLAN_SOURCE_FORMATS[$SELECTED]}"
PLAN_SOURCE_ABSOLUTE="$PROJECT/$PLAN_PATH"
PLAN_ABSOLUTE="${PLAN_CANONICAL_PATHS[$SELECTED]}"
[ -n "$PLAN_ABSOLUTE" ] || PLAN_ABSOLUTE="$PLAN_SOURCE_ABSOLUTE"

if [ "$FINAL_AUDIT" -eq 1 ]; then
  [ -f "$OPERATIONAL_VERIFIER" ] || die "RB Ralph operational verifier not found: $OPERATIONAL_VERIFIER; reinstall the complete package"
  operational_candidate=""
  operational_source=""
  if [ -n "$OPERATIONAL_CONTRACT_OPTION" ]; then
    operational_candidate="$OPERATIONAL_CONTRACT_OPTION"
    operational_source="--operations"
  elif [ -n "$OPERATIONAL_CONTRACT_ENV" ]; then
    operational_candidate="$OPERATIONAL_CONTRACT_ENV"
    operational_source="RB_RALPH_OPERATIONAL_CONTRACT"
  elif [ -f "$(dirname "$PLAN_SOURCE_ABSOLUTE")/OPERATIONS.json" ]; then
    operational_candidate="$(dirname "$PLAN_SOURCE_ABSOLUTE")/OPERATIONS.json"
    operational_source="plan directory"
  elif [ -f "$ARTIFACTS_DIR/OPERATIONS.json" ]; then
    operational_candidate="$ARTIFACTS_DIR/OPERATIONS.json"
    operational_source="project"
  elif [ -f "$ARTIFACTS_DIR/init/OPERATIONS.json" ]; then
    operational_candidate="$ARTIFACTS_DIR/init/OPERATIONS.json"
    operational_source="project initialization"
  elif [ -f "$ARTIFACTS_DIR/context/OPERATIONS.json" ]; then
    operational_candidate="$ARTIFACTS_DIR/context/OPERATIONS.json"
    operational_source="project context"
  fi
  if [ -n "$operational_candidate" ]; then
    if [[ "$operational_candidate" != /* ]]; then operational_candidate="$PROJECT/$operational_candidate"; fi
    [ -f "$operational_candidate" ] || die "Operational contract selected by $operational_source does not exist: $operational_candidate"
    OPERATIONAL_CONTRACT="$(cd "$(dirname "$operational_candidate")" && pwd -P)/$(basename "$operational_candidate")"
    # rb-operational/v1 is owned by the packaged RB Harness validator.  The
    # runner only executes a contract that this authority accepted; its clean
    # room executor is not a second schema implementation.
    core_cli_call operations validate "$OPERATIONAL_CONTRACT" >/dev/null \
      || die "Operational contract is invalid: $OPERATIONAL_CONTRACT"
    log "operational-contract=${OPERATIONAL_CONTRACT#"$PROJECT/"} source=$operational_source"
    operational_hash="$(node -e 'const fs=require("node:fs"),crypto=require("node:crypto"); process.stdout.write(crypto.createHash("sha256").update(fs.readFileSync(process.argv[1])).digest("hex"))' "$OPERATIONAL_CONTRACT")"
    OPERATIONAL_FINGERPRINT="$RB_RALPH_VERSION:contract:$operational_hash"
  else
    log "operational-contract=not-declared; final acceptance requires explicit rb-operational/v1 authority"
    OPERATIONAL_FINGERPRINT="$RB_RALPH_VERSION:operational-contract-required"
  fi
fi

if ! PHASES="$(core_cli_call contract inspect "$PLAN_ABSOLUTE" --format tsv)"; then
  die "Execution contract inspection failed; no provider was started"
fi

log "plan=$PLAN_ID path=$PLAN_PATH sha256=$PLAN_HASH artifacts-dir=$ARTIFACTS_RELATIVE source-format=$PLAN_SOURCE_FORMAT"

if [ "$DRY_RUN" -eq 1 ]; then
  while IFS= read -r tsv_row; do
    IFS="$TSV_SEPARATOR" read -r phase_id number task_count pending_count depends_on title \
      <<< "${tsv_row//$'\t'/$TSV_SEPARATOR}"
    [ "$phase_id" = "phase_id" ] && continue
    if [ "$pending_count" -eq 0 ]; then
      phase_status="document-complete"
    else
      phase_status="pending"
    fi
    printf '%s\tphase=%s\ttasks=%s\tpending=%s\tdepends=%s\ttitle=%s\n' \
      "$phase_status" "$phase_id" "$task_count" "$pending_count" "${depends_on:-none}" "$title"
  done <<< "$PHASES"
  if [ "$FINAL_AUDIT" -eq 1 ]; then
    printf 'pending\tphase=%s\ttasks=1\tpending=1\tdepends=all\ttitle=Independent operational acceptance\tcontract=%s\n' \
      "$FINAL_PHASE_ID" "${OPERATIONAL_CONTRACT#"$PROJECT/"}"
  fi
  cleanup_discovery_temp
  exit 0
fi

if [ "$FINAL_AUDIT" -eq 1 ]; then
  PHASES+=$'\n'"$FINAL_PHASE_ID"$'\t999\t1\t1\t\tIndependent operational acceptance'
fi

configure_roles
[ -z "$DISCOVERY_TEMP_ROOT" ] || ACTIVE_TEMP_ROOTS+=("$DISCOVERY_TEMP_ROOT")
[ -f "$EVIDENCE_HELPER" ] || die "RB Ralph evidence helper not found: $EVIDENCE_HELPER; reinstall the complete package instead of copying only bin/rb-ralph"
[ -f "$PROCESS_SUPERVISOR" ] || die "RB Ralph process supervisor not found: $PROCESS_SUPERVISOR; reinstall the complete package instead of copying only bin/rb-ralph"
[ -f "$EVIDENCE_INDEX_HELPER" ] || die "RB Ralph evidence-index helper not found: $EVIDENCE_INDEX_HELPER; reinstall the complete package"
[ -f "$VALIDATION_CACHE_HELPER" ] || die "RB Ralph validation-cache helper not found: $VALIDATION_CACHE_HELPER; reinstall the complete package"
[ -f "$EXECUTION_IDENTITY_HELPER" ] || die "RB Ralph execution-identity helper not found: $EXECUTION_IDENTITY_HELPER; reinstall the complete package"
[ -f "$MANAGER_AUDIT_HELPER" ] || die "RB Ralph manager-audit helper not found: $MANAGER_AUDIT_HELPER; reinstall the complete package"
[ -f "$CONTEXT_EFFICIENCY_HELPER" ] || die "RB Ralph context-efficiency helper not found: $CONTEXT_EFFICIENCY_HELPER; reinstall the complete package"
[ -f "$CONTROL_PLANE_HELPER" ] || die "RB Ralph control-plane helper not found: $CONTROL_PLANE_HELPER; reinstall the complete package instead of copying only bin/rb-ralph"
[ -f "$EXECUTOR_COMPLETION_HELPER" ] || die "RB Ralph executor-completion helper not found: $EXECUTOR_COMPLETION_HELPER; reinstall the complete package"
[ -f "$EVIDENCE_SANITIZER" ] || die "RB Ralph evidence sanitizer not found: $EVIDENCE_SANITIZER; reinstall the complete package"
[ -f "$EVIDENCE_PROVENANCE_HELPER" ] || die "RB Ralph evidence provenance helper not found: $EVIDENCE_PROVENANCE_HELPER; reinstall the complete package"
[ -f "$RELEASE_IDENTITY_HELPER" ] && [ -f "$RELEASE_IDENTITY_FILE" ] \
  || die "RB Ralph release identity metadata is missing; reinstall the complete package"
node "$RELEASE_IDENTITY_HELPER" "$VERSION_FILE" "$RELEASE_IDENTITY_FILE" >/dev/null \
  || die "RB Ralph release identity metadata is incompatible with this runtime"
if [ -t 1 ] && [ "$DASHBOARD" -eq 0 ]; then
  print_brand
  printf '\n'
fi

RUN_ID="${PLAN_ID}-${PLAN_HASH:0:12}"
STATE_DIR="$PROJECT/.rb/runs/$RUN_ID"
EVENTS_FILE="$STATE_DIR/events.tsv"
FINDINGS_FILE="$STATE_DIR/findings.tsv"
OPERATIONAL_ACCEPTED_FILE="$STATE_DIR/operational-accepted.txt"
LOCK_DIR="$STATE_DIR/.lock"
mkdir -p "$STATE_DIR/prompts" "$STATE_DIR/logs" "$STATE_DIR/phases" "$STATE_DIR/evidence" "$STATE_DIR/memory/checkpoints"
acquire_run_lock
trap cleanup_runtime EXIT INT TERM

[ ! -f "$PROJECT/.rb/runs/AUTHORITY-COMPROMISED" ] \
  || die "Project authority is marked compromised and Ralph cannot execute until an operator restores it"
[ ! -f "$STATE_DIR/AUTHORITY-COMPROMISED" ] \
  || die "Run authority is marked compromised and cannot be resumed safely: $RUN_ID"

if [ ! -f "$STATE_DIR/run.tsv" ]; then
  printf 'run_id\tartifact_id\tplan_path\tplan_sha256\tcontract\n' > "$STATE_DIR/run.tsv"
  printf '%s\t%s\t%s\t%s\trb-execution/v1\n' "$RUN_ID" "$PLAN_ID" "$PLAN_PATH" "$PLAN_HASH" >> "$STATE_DIR/run.tsv"
fi
if [ ! -f "$EVENTS_FILE" ]; then
  printf 'timestamp\tphase_id\tattempt\tstatus\treason\n' > "$EVENTS_FILE"
fi
if [ ! -f "$FINDINGS_FILE" ]; then
  printf 'finding_id\tphase_id\topened_attempt\tstatus\treason\topened_evidence_sha256\tresolved_attempt\tresolved_evidence_sha256\tfinding_key\tcriteria\tlatest_reason\tlatest_evidence_sha256\tlast_seen_attempt\n' > "$FINDINGS_FILE"
fi
CURRENT_PRODUCT_SEAL="$STATE_DIR/evidence/resume-product-state.json"
node "$EVIDENCE_HELPER" seal-snapshot "$PROJECT" "$CURRENT_PRODUCT_SEAL" \
  || die "Could not seal current product state for resume identity"
CURRENT_PRODUCT_DIGEST="$(node "$EVIDENCE_HELPER" seal-digest "$PROJECT" "$CURRENT_PRODUCT_SEAL")" \
  || die "Could not digest current product state for resume identity"
EXECUTION_IDENTITY_FILE="$STATE_DIR/evidence/execution-identity.json"
# Opt-in names keep environmental proof bounded. Values are hashed by the
# helper and never persisted in cleartext; model/provider settings are telemetry
# provenance and intentionally do not invalidate deterministic evidence.
CURRENT_EXECUTION_IDENTITY="$(node "$EXECUTION_IDENTITY_HELPER" external "$EXECUTION_IDENTITY_FILE" "$RB_RALPH_VERSION" "${RB_RALPH_EVIDENCE_ENV:-}" "bash,node,npm,python,python3,go,cargo,java")" \
  || die "Could not establish deterministic execution identity"
CURRENT_OPERATIONAL_EXECUTION_IDENTITY=""
if [ -n "$OPERATIONAL_CONTRACT" ]; then
  CURRENT_OPERATIONAL_EXECUTION_IDENTITY="$(node "$EXECUTION_IDENTITY_HELPER" operational \
    "$STATE_DIR/evidence/operational-execution-identity.json" "$EXECUTION_IDENTITY_FILE" "$OPERATIONAL_CONTRACT")" \
    || die "Could not establish operational execution identity"
fi

rerun_rbf_regressions() {
  local regression_row regression_phase regression_kind regression_value regression_rc=0
  printf '\n[RBT-FINAL] RBF changed product state; rerunning all declared deterministic phase validations.\n' >> "$VALIDATION_LOG"
  while IFS= read -r regression_row; do
    IFS="$TSV_SEPARATOR" read -r regression_phase regression_kind regression_value \
      <<< "${regression_row//$'\t'/$TSV_SEPARATOR}"
    [ "$regression_phase" = "task_id" ] && continue
    [ "$regression_kind" = "command" ] || continue
    validation_commands=$((validation_commands + 1))
    printf '\n[RBF-regression:%s] command: %s\n' "$regression_phase" "$regression_value" >> "$VALIDATION_LOG"
    regression_rc=0
    if [ "$VALIDATION_TIMEOUT" -gt 0 ] && command -v timeout >/dev/null 2>&1; then
      (cd "$PROJECT" && timeout --foreground "${VALIDATION_TIMEOUT}s" bash -lc "$regression_value") \
        >> "$VALIDATION_LOG" 2>&1 || regression_rc=$?
    else
      (cd "$PROJECT" && bash -lc "$regression_value") >> "$VALIDATION_LOG" 2>&1 || regression_rc=$?
    fi
    printf '[RBF-regression:%s] exit=%s\n' "$regression_phase" "$regression_rc" >> "$VALIDATION_LOG"
    [ "$regression_rc" -eq 0 ] || validation_failures=$((validation_failures + 1))
  done <<< "$(core_cli_call contract validations "$PLAN_ABSOLUTE" --format tsv)"
}
node "$MANAGER_AUDIT_HELPER" replay "$FINDINGS_FILE" "$STATE_DIR/logs" "$STATE_DIR/prompts" >/dev/null \
  || die "Could not migrate and reconcile the cumulative finding ledger"

[ -f "$TELEMETRY_HELPER" ] || die "RB Ralph telemetry helper not found: $TELEMETRY_HELPER; reinstall the complete package"
[ -f "$USAGE_HELPER" ] || die "RB Ralph usage helper not found: $USAGE_HELPER; reinstall the complete package"
dashboard_state_init
start_dashboard

MEMORY_CONTEXT_FILE="$STATE_DIR/memory/bootstrap.json"
if [ "$MEMORY_MODE" != "off" ]; then
  [ -f "$ARTIFACTS_DIR/rb-manifest.json" ] \
    || die "RB Memory integration requires rb-manifest.json in the selected artifact directory"
  MEMORY_PROJECT_ID="$(node -e 'const m=JSON.parse(require("node:fs").readFileSync(process.argv[1],"utf8")); process.stdout.write(m.project.id)' "$ARTIFACTS_DIR/rb-manifest.json")"
  MEMORY_PROJECT_NAME="$(node -e 'const m=JSON.parse(require("node:fs").readFileSync(process.argv[1],"utf8")); process.stdout.write(m.project.name)' "$ARTIFACTS_DIR/rb-manifest.json")"
  sync_memory_bootstrap
fi

while IFS= read -r tsv_row; do
  IFS="$TSV_SEPARATOR" read -r phase_id number task_count pending_count depends_on title \
    <<< "${tsv_row//$'\t'/$TSV_SEPARATOR}"
  [ "$phase_id" = "phase_id" ] && continue
  if [ "$pending_count" -eq 0 ]; then
    log "$phase_id skipped: all tasks are checked in the execution document"
    continue
  fi

  prior_status="$(last_phase_status "$phase_id")"
  if [ "$prior_status" = "COMPLETE" ]; then
    PHASE_ACCEPTED_FILE="$STATE_DIR/evidence/$phase_id-accepted.json"
    if ! node -e '
      const fs=require("node:fs"); const [file,product,execution,operational,operationalExecution]=process.argv.slice(1);
      try { const value=JSON.parse(fs.readFileSync(file,"utf8"));
        process.exit(value.productDigest===product && value.executionDigest===execution
          && (!operational || (value.operationalFingerprint===operational
            && value.operationalExecutionDigest===operationalExecution)) ? 0 : 1); } catch { process.exit(1); }
    ' "$PHASE_ACCEPTED_FILE" "$CURRENT_PRODUCT_DIGEST" "$CURRENT_EXECUTION_IDENTITY" \
      "$(if [ "$phase_id" = "$FINAL_PHASE_ID" ]; then printf '%s' "$OPERATIONAL_FINGERPRINT"; fi)" \
      "$(if [ "$phase_id" = "$FINAL_PHASE_ID" ]; then printf '%s' "$CURRENT_OPERATIONAL_EXECUTION_IDENTITY"; fi)"; then
      log "$phase_id previous acceptance is stale for current product, execution, or operational authority; auditing again"
    else
      dashboard_set_phase "$phase_id" complete "resumed from accepted evidence"
      sync_memory_checkpoint \
        "$STATE_DIR/memory/checkpoints/$phase_id.json" \
        "$STATE_DIR/memory/checkpoints/$phase_id-result.json" \
        "$phase_id" "$title" "$(last_phase_reason "$phase_id")" ""
      log "$phase_id resumed as complete"
      continue
    fi
  fi

  PHASE_FILE="$STATE_DIR/phases/$phase_id.txt"
  if [ "$phase_id" = "$FINAL_PHASE_ID" ]; then
    if [ -z "$OPERATIONAL_CONTRACT" ]; then
      reason="explicit rb-operational/v1 contract is required; dynamic RBF cannot manufacture an acceptance boundary"
      record_event "$phase_id" 0 "BLOCKED" "$reason"
      dashboard_set_phase "$phase_id" blocked "$reason"
      die "$phase_id blocked: $reason"
    fi
    {
      printf '%s\n' \
        '# Phase RBF — Independent operational acceptance' \
        '' \
        'This is a runtime-only RB Ralph phase. It does not modify PHASES.md.' \
        '' \
        '## Objective' \
        '' \
        'Prove that the delivered product works from a real consumer boundary in a disposable clean environment, then correct any integration, packaging, startup, configuration, documentation, or usability defect found.' \
        '' \
        '## Product-neutral rules' \
        '' \
        '- First identify the actual product shape from the repository and documentation: desktop, mobile, CLI, service, API, web, library, plugin, package, firmware, data job, or another kind.' \
        '- Do not assume HTTP, a browser, npm, containers, Linux, or any particular language or framework.' \
        '- Exercise documented consumer entrypoints and real boundaries. Internal mocks alone are not operational proof.' \
        '- Use a disposable copy or equivalent clean-room isolation. Do not rely on existing build outputs, dependencies, running processes, local state, or undeclared secrets.' \
        '- Follow the documented setup/build/install/start/use workflow exactly as a new user would.' \
        '- For a desktop/mobile UI, use the platform-appropriate build/package plus real UI automation, launch/process evidence, screenshots, accessibility tree, or another honest observable mechanism available to the project.' \
        '- For a CLI, execute the installed/built command and inspect exit status and output. For a library, compile and run a minimal consumer. For a service, probe its actual protocol. For a package/plugin, install and load it in a representative host.' \
        '- Never invent successful manual or visual validation. State what is automated, what evidence exists, and what remains genuinely manual.' \
        '- Clean up every process and temporary resource created by verification.' \
        '- Fix defects in product code, automation, packaging, configuration examples, or documentation when the proof fails; add regression coverage for the escaped defect.' \
        '' \
        '## Acceptance criteria' \
        '' \
        '- A clean consumer can follow the documented workflow without undocumented repair.' \
        '- The primary user-visible capability crosses its real integration boundary successfully.' \
        '- Produced artifacts start/load/run on every platform claimed by the current scenario or documentation.' \
        '- Failures are reported accurately and no secret is copied into evidence or prompts.'
      if [ -n "$OPERATIONAL_CONTRACT" ]; then
        printf '%s\n' '' "## Executable contract" '' \
          "The deterministic rb-operational/v1 contract is: ${OPERATIONAL_CONTRACT#"$PROJECT/"}" \
          'Run it, inspect its complete output, and fix the implementation if any scenario fails.'
      fi
    } > "$PHASE_FILE"
    VALIDATIONS=$'task_id\tkind\tvalue'
    TASKS=$'task_id\tdone\tparallel\tdepends_on\ttitle\nRBT-FINAL\tfalse\tfalse\t\tClean-room product acceptance'
  else
    core_cli_call contract extract "$PLAN_ABSOLUTE" --phase "$phase_id" > "$PHASE_FILE"
    VALIDATIONS="$(core_cli_call contract validations "$PLAN_ABSOLUTE" --phase "$phase_id" --format tsv)"
    TASKS="$(core_cli_call contract tasks "$PLAN_ABSOLUTE" --phase "$phase_id" --format tsv)"
    TASK_DETAILS_FILE="$STATE_DIR/phases/$phase_id-tasks.json"
    VALIDATION_DETAILS_FILE="$STATE_DIR/phases/$phase_id-validations.json"
    core_cli_call contract tasks "$PLAN_ABSOLUTE" --phase "$phase_id" --format json > "$TASK_DETAILS_FILE"
    core_cli_call contract validations "$PLAN_ABSOLUTE" --phase "$phase_id" --format json > "$VALIDATION_DETAILS_FILE"
  fi
  HUMAN_VALIDATION_SUMMARY="$(
    while IFS= read -r validation_row; do
      IFS="$TSV_SEPARATOR" read -r validation_task validation_kind validation_value \
        <<< "${validation_row//$'\t'/$TSV_SEPARATOR}"
      [ "$validation_kind" = "human" ] || continue
      printf '%s: %s; ' "$validation_task" "$validation_value"
    done <<< "$VALIDATIONS"
  )"
  if [ -n "$HUMAN_VALIDATION_SUMMARY" ]; then
    human_reason="external human evidence required before execution: $HUMAN_VALIDATION_SUMMARY"
    record_event "$phase_id" 0 "PAUSED_HUMAN" "$human_reason"
    dashboard_set_phase "$phase_id" paused "$human_reason" "preflight"
    dashboard_finish paused
    wait_dashboard
    printf 'PAUSED: %s\n' "$human_reason" >&2
    exit 2
  fi
  configure_pending_tasks "*"
  completed=0
  attempt="$(next_phase_attempt "$phase_id")"
  previous_attempt=$((attempt - 1))
  LAST_FEEDBACK="$(last_phase_retry_reason "$phase_id")"
  LAST_AGENT_LOG=""
  LAST_VALIDATION_LOG=""
  LAST_CHANGED_PATHS=""
  if [ -n "$LAST_FEEDBACK" ] && [ "$previous_attempt" -gt 0 ]; then
    [ ! -f "$STATE_DIR/logs/$phase_id-attempt-$previous_attempt-agent.log" ] \
      || LAST_AGENT_LOG=".rb/runs/$RUN_ID/logs/$phase_id-attempt-$previous_attempt-agent.log"
    [ ! -f "$STATE_DIR/logs/$phase_id-attempt-$previous_attempt-validation.log" ] \
      || LAST_VALIDATION_LOG=".rb/runs/$RUN_ID/logs/$phase_id-attempt-$previous_attempt-validation.log"
    [ ! -f "$STATE_DIR/evidence/$phase_id-attempt-$previous_attempt-changes.json" ] \
      || LAST_CHANGED_PATHS=".rb/runs/$RUN_ID/evidence/$phase_id-attempt-$previous_attempt-changes.json"
  fi
  LAST_ATTEMPT_FAILURE=""
  RECOVERY_NOTE=""
  stalled_attempts=0
  strategy_resets=0
  same_feedback_count=0
  last_finding_batch=""
  if [ "$previous_attempt" -gt 0 ] && [ -f "$STATE_DIR/logs/$phase_id-attempt-$previous_attempt-manager-audit.json" ]; then
    last_finding_batch="$(manager_finding_batch_fingerprint "$STATE_DIR/logs/$phase_id-attempt-$previous_attempt-manager-audit.json")"
  fi
  phase_run_attempts=0
  rate_limit_waits=0
  incomplete_retries=0

  while :; do
    if [ "$MAX_TOTAL_ATTEMPTS" -gt 0 ] && [ "$phase_run_attempts" -ge "$MAX_TOTAL_ATTEMPTS" ]; then
      pause_reason="limite de segurança de $MAX_TOTAL_ATTEMPTS tentativa(s) atingido nesta execução; retome o mesmo comando para continuar a partir do feedback persistido: ${LAST_ATTEMPT_FAILURE:-nenhum feedback disponível}"
      record_event "$phase_id" "$previous_attempt" "PAUSED" "$pause_reason"
      dashboard_set_phase "$phase_id" paused "$pause_reason" "$(attempt_display "$previous_attempt" "$stalled_attempts")"
      dashboard_finish paused
      wait_dashboard
      printf 'PAUSED: %s\n' "$pause_reason" >&2
      exit 2
    fi
    phase_run_attempts=$((phase_run_attempts + 1))
    dashboard_set_phase "$phase_id" running \
      "executor is implementing the phase · idle timeout ${AGENT_IDLE_TIMEOUT}s" \
      "$(attempt_display "$attempt" "$stalled_attempts")"
    dashboard_reset_gates "$phase_id"
    dashboard_gate "$phase_id" 0 run "G0 · executor is implementing · idle timeout ${AGENT_IDLE_TIMEOUT}s"
    AGENT_PROMPT="$STATE_DIR/prompts/$phase_id-attempt-$attempt-agent.txt"
    MANAGER_PROMPT="$STATE_DIR/prompts/$phase_id-attempt-$attempt-manager.txt"
    AGENT_LOG="$STATE_DIR/logs/$phase_id-attempt-$attempt-agent.log"
    VALIDATION_LOG_CANONICAL="$STATE_DIR/logs/$phase_id-attempt-$attempt-validation.log"
    VALIDATION_LOG="$(mktemp "${TMPDIR:-/tmp}/rb-ralph-validation-output.XXXXXX")"
    MANAGER_LOG="$STATE_DIR/logs/$phase_id-attempt-$attempt-manager.log"
    BEFORE_SNAPSHOT="$STATE_DIR/evidence/$phase_id-attempt-$attempt-before.json"
    AUTHORITY_BEFORE_SNAPSHOT="$STATE_DIR/evidence/$phase_id-attempt-$attempt-write-authority-before.json"
    AUTHORITY_CHANGED_PATHS="$STATE_DIR/evidence/$phase_id-attempt-$attempt-write-authority-changes.json"
    CHANGED_PATHS_FILE="$STATE_DIR/evidence/$phase_id-attempt-$attempt-changes.json"
    CONTROL_SNAPSHOT="$(mktemp "${TMPDIR:-/tmp}/rb-ralph-control-before.XXXXXX")"
    CONTROL_DIFF="$(mktemp "${TMPDIR:-/tmp}/rb-ralph-control-diff.XXXXXX")"
    CONTROL_RECEIPT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/rb-ralph-control-receipts.XXXXXX")"
    ACTIVE_TEMP_ROOTS+=("$CONTROL_RECEIPT_DIR")

    # A provider-availability retry or interrupted task call reuses the logical
    # attempt number. Remove only the current task-call outputs before taking
    # the immutable control-plane snapshot; invoke_agent republishes them
    # atomically from its out-of-tree capture directory.
    reset_task_call_outputs
    node "$EVIDENCE_HELPER" snapshot "$PROJECT" "$BEFORE_SNAPSHOT" \
      || die "$phase_id could not capture pre-agent project evidence"
    node "$EVIDENCE_HELPER" seal-snapshot "$PROJECT" "$AUTHORITY_BEFORE_SNAPSHOT" \
      || die "$phase_id could not capture complete pre-agent write-authority evidence"
    node "$CONTROL_PLANE_HELPER" snapshot "$STATE_DIR" "$CONTROL_SNAPSHOT" \
      || die "$phase_id could not protect orchestrator control-plane evidence"

    agent_rc=0
    authority_violation=0
    INTEGRATION_AUTHORITY_VIOLATION=0
    ATTEMPT_TEMP_ROOT=""
    ATTEMPT_WORKTREES=()
    WORKTREE_PATCH_ARGS=()
    if [ "$use_parallel" -eq 1 ]; then
      log "$phase_id attempt $attempt (run $(run_attempt_display "$phase_run_attempts")): ${#PENDING_TASK_IDS[@]} independent task agents (limit=$PARALLEL_LIMIT)"
      : > "$AGENT_LOG"
      batch_pids=()
      all_task_logs=()
      if [ "$ISOLATION" = "worktree" ]; then
        SNAPSHOT_COMMIT="$(git_snapshot_commit)"
        ATTEMPT_TEMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/rb-ralph-worktrees.XXXXXX")"
        ACTIVE_TEMP_ROOTS+=("$ATTEMPT_TEMP_ROOT")
        log "$phase_id isolation snapshot=$SNAPSHOT_COMMIT"
      fi
      for task_id in "${PENDING_TASK_IDS[@]+"${PENDING_TASK_IDS[@]}"}"; do
        TASK_FILE="$STATE_DIR/phases/$phase_id-$task_id.txt"
        TASK_PROMPT="$STATE_DIR/prompts/$phase_id-$task_id-attempt-$attempt-agent.txt"
        TASK_LOG="$STATE_DIR/logs/$phase_id-$task_id-attempt-$attempt-agent.log"
        TASK_EXECUTION_ROOT="$PROJECT"
        if [ "$ISOLATION" = "worktree" ]; then
          TASK_EXECUTION_ROOT="$ATTEMPT_TEMP_ROOT/task-$task_id"
          create_execution_worktree "$SNAPSHOT_COMMIT" "$TASK_EXECUTION_ROOT"
          ATTEMPT_WORKTREES+=("$TASK_EXECUTION_ROOT")
          WORKTREE_PATCH_ARGS+=("$task_id" "$TASK_EXECUTION_ROOT")
        fi
        core_cli_call contract extract "$PLAN_ABSOLUTE" --task "$task_id" > "$TASK_FILE"
        record_control_receipt "$TASK_FILE"
        write_agent_prompt "$TASK_PROMPT" "$TASK_FILE" "$task_id" "$TASK_EXECUTION_ROOT"
        record_control_receipt "$TASK_PROMPT"
        ensure_prompt_budget "$TASK_PROMPT" "$phase_id/$task_id agent"
        invoke_agent "$TASK_PROMPT" "$TASK_LOG" "$task_id" "$TASK_EXECUTION_ROOT" &
        batch_pids+=("$!")
        all_task_logs+=("$TASK_LOG")
        if [ "${#batch_pids[@]}" -ge "$PARALLEL_LIMIT" ]; then
          for pid in "${batch_pids[@]+"${batch_pids[@]}"}"; do
            if wait "$pid"; then
              :
            else
              wait_rc=$?
              if [ "$wait_rc" -eq 75 ]; then agent_rc=75; elif [ "$agent_rc" -eq 0 ]; then agent_rc="$wait_rc"; fi
            fi
          done
          batch_pids=()
        fi
      done
      for pid in "${batch_pids[@]+"${batch_pids[@]}"}"; do
        if wait "$pid"; then
          :
        else
          wait_rc=$?
          if [ "$wait_rc" -eq 75 ]; then agent_rc=75; elif [ "$agent_rc" -eq 0 ]; then agent_rc="$wait_rc"; fi
        fi
      done
      for task_log in "${all_task_logs[@]+"${all_task_logs[@]}"}"; do
        printf '\n--- %s ---\n' "$(basename "$task_log")" >> "$AGENT_LOG"
        cat "$task_log" >> "$AGENT_LOG"
      done
      record_control_receipt "$AGENT_LOG"
    elif [ "$EXECUTION_UNIT" = "task" ] && [ "${#PENDING_TASK_IDS[@]}" -gt 0 ]; then
      log "$phase_id attempt $attempt (run $(run_attempt_display "$phase_run_attempts")): ${#PENDING_TASK_IDS[@]} fresh sequential task agent(s)"
      : > "$AGENT_LOG"
      for task_id in "${PENDING_TASK_IDS[@]+"${PENDING_TASK_IDS[@]}"}"; do
        TASK_FILE="$STATE_DIR/phases/$phase_id-$task_id.txt"
        TASK_PROMPT="$STATE_DIR/prompts/$phase_id-$task_id-attempt-$attempt-agent.txt"
        TASK_LOG="$STATE_DIR/logs/$phase_id-$task_id-attempt-$attempt-agent.log"
        if [ "$phase_id" = "$FINAL_PHASE_ID" ]; then
          cp -- "$PHASE_FILE" "$TASK_FILE"
        else
          core_cli_call contract extract "$PLAN_ABSOLUTE" --task "$task_id" > "$TASK_FILE"
        fi
        record_control_receipt "$TASK_FILE"
        write_agent_prompt "$TASK_PROMPT" "$TASK_FILE" "$task_id" "$PROJECT"
        record_control_receipt "$TASK_PROMPT"
        ensure_prompt_budget "$TASK_PROMPT" "$phase_id/$task_id agent"
        dashboard_set_phase "$phase_id" running \
          "G0 · fresh executor for task $task_id · first output ${AGENT_FIRST_OUTPUT_TIMEOUT}s" \
          "$(attempt_display "$attempt" "$stalled_attempts")"
        task_rc=0
        TASK_BEFORE_SNAPSHOT="$STATE_DIR/evidence/$phase_id-$task_id-attempt-$attempt-write-boundary-before.json"
        TASK_CHANGED_PATHS="$(mktemp "${TMPDIR:-/tmp}/rb-ralph-task-changes.XXXXXX")"
        TASK_AUTHORITY_REPORT="$(mktemp "${TMPDIR:-/tmp}/rb-ralph-task-authority.XXXXXX")"
        node "$EVIDENCE_HELPER" seal-snapshot "$PROJECT" "$TASK_BEFORE_SNAPSHOT" \
          || die "$phase_id/$task_id could not capture task write-boundary evidence"
        record_control_receipt "$TASK_BEFORE_SNAPSHOT"
        invoke_agent "$TASK_PROMPT" "$TASK_LOG" "$task_id" "$PROJECT" || task_rc=$?
        node "$EVIDENCE_HELPER" seal-diff "$PROJECT" "$TASK_BEFORE_SNAPSHOT" "$TASK_CHANGED_PATHS" \
          || die "$phase_id/$task_id could not compare task write-boundary evidence"
        task_authority_rc=0
        if [ "$phase_id" = "$FINAL_PHASE_ID" ]; then
          node "$VALIDATION_CACHE_HELPER" protect "$TASK_CHANGED_PATHS" "$ARTIFACTS_RELATIVE" \
            > "$TASK_AUTHORITY_REPORT" || task_authority_rc=$?
        else
          node "$VALIDATION_CACHE_HELPER" authorize "$TASK_DETAILS_FILE" "$TASK_CHANGED_PATHS" \
            "$ARTIFACTS_RELATIVE" "$task_id" > "$TASK_AUTHORITY_REPORT" || task_authority_rc=$?
        fi
        rm -f -- "$TASK_CHANGED_PATHS"
        if [ "$task_authority_rc" -eq 3 ]; then
          task_rc=1
          authority_violation=1
          printf '\nRB_RALPH_WRITE_AUTHORITY_VIOLATION: task %s changed a protected or out-of-Scope path\n' "$task_id" >> "$TASK_LOG"
          cat "$TASK_AUTHORITY_REPORT" >> "$TASK_LOG"
        elif [ "$task_authority_rc" -ne 0 ]; then
          rm -f -- "$TASK_AUTHORITY_REPORT"
          die "$phase_id/$task_id could not verify task write authority"
        fi
        rm -f -- "$TASK_AUTHORITY_REPORT"
        record_control_receipt "$TASK_LOG"
        printf '\n--- %s ---\n' "$(basename "$TASK_LOG")" >> "$AGENT_LOG"
        cat "$TASK_LOG" >> "$AGENT_LOG"
        if [ "$task_rc" -ne 0 ]; then
          agent_rc="$task_rc"
          break
        fi
      done
      record_control_receipt "$AGENT_LOG"
    else
      write_agent_prompt "$AGENT_PROMPT" "$PHASE_FILE" "" "$PROJECT"
      record_control_receipt "$AGENT_PROMPT"
      ensure_prompt_budget "$AGENT_PROMPT" "$phase_id agent"
      log "$phase_id attempt $attempt (run $(run_attempt_display "$phase_run_attempts")): legacy sequential phase agent"
      invoke_agent "$AGENT_PROMPT" "$AGENT_LOG" "" "$PROJECT" || agent_rc=$?
    fi

    control_plane_rc=0
    node "$CONTROL_PLANE_HELPER" verify "$STATE_DIR" "$CONTROL_SNAPSHOT" "$CONTROL_RECEIPT_DIR" "$CONTROL_DIFF" \
      || control_plane_rc=$?
    rm -f -- "$CONTROL_SNAPSHOT"
    rm -rf -- "$CONTROL_RECEIPT_DIR"
    CONTROL_RECEIPT_DIR=""
    if [ "$control_plane_rc" -eq 3 ]; then
      printf '\nRB_RALPH_CONTROL_PLANE_VIOLATION: executor changed orchestrator-owned canonical state\n' >> "$AGENT_LOG"
      cat "$CONTROL_DIFF" >> "$AGENT_LOG"
      record_event "$phase_id" "$attempt" "CONTROL_PLANE_VIOLATION" \
        "executor changed or introduced unowned .rb/runs artifacts; run sealed as compromised"
      mark_authority_compromised "executor changed or introduced unowned control-plane artifacts during $phase_id attempt $attempt"
      rm -f -- "$CONTROL_DIFF"
      die "$phase_id executor violated orchestrator control-plane ownership; run cannot continue safely"
    elif [ "$control_plane_rc" -ne 0 ]; then
      rm -f -- "$CONTROL_DIFF"
      die "$phase_id could not verify orchestrator control-plane integrity"
    fi
    rm -f -- "$CONTROL_DIFF"
    [ ! -f "$PROJECT/.rb/runs/AUTHORITY-COMPROMISED" ] \
      || die "$phase_id provider introduced or encountered a project authority-compromise marker"
    if [ "$use_parallel" -eq 1 ] && [ "$ISOLATION" = "worktree" ]; then
      PRIMARY_ISOLATION_DIFF="$(mktemp "${TMPDIR:-/tmp}/rb-ralph-primary-isolation-diff.XXXXXX")"
      node "$EVIDENCE_HELPER" seal-diff "$PROJECT" "$AUTHORITY_BEFORE_SNAPSHOT" "$PRIMARY_ISOLATION_DIFF" \
        || die "$phase_id could not verify the primary tree during isolated execution"
      primary_isolation_changes="$(evidence_change_count "$PRIMARY_ISOLATION_DIFF")"
      if [ "$primary_isolation_changes" -ne 0 ]; then
        cp -- "$PRIMARY_ISOLATION_DIFF" "$STATE_DIR/evidence/$phase_id-attempt-$attempt-primary-isolation-violation.json"
        rm -f -- "$PRIMARY_ISOLATION_DIFF"
        record_event "$phase_id" "$attempt" "WRITE_AUTHORITY_VIOLATION" \
          "isolated task provider changed $primary_isolation_changes primary-tree path(s) outside patch integration"
        mark_authority_compromised "isolated executor changed the primary tree outside patch integration during $phase_id attempt $attempt"
        die "$phase_id isolated executor bypassed its worktree authority; primary integration was not started"
      fi
      rm -f -- "$PRIMARY_ISOLATION_DIFF"
    fi
    record_context_compaction_signal "$AGENT_LOG" executor "$phase_id" "$attempt"

    if provider_rate_limited "$AGENT_LOG" "$agent_rc"; then
      rate_limit_waits=$((rate_limit_waits + 1))
      if [ "$rate_limit_waits" -gt "$MAX_RATE_LIMIT_WAITS" ]; then
        record_event "$phase_id" "$attempt" "RATE_LIMIT_EXHAUSTED" "maximum provider waits exceeded"
        die "$phase_id exceeded --max-limit-waits=$MAX_RATE_LIMIT_WAITS"
      fi
      wait_seconds="$(provider_wait_seconds "$AGENT_LOG")"
      record_event "$phase_id" "$attempt" "RATE_LIMIT" "agent wait ${wait_seconds}s ($rate_limit_waits/$MAX_RATE_LIMIT_WAITS)"
      dashboard_gate "$phase_id" 0 pending "provider limit · waiting ${wait_seconds}s before retry"
      log "$phase_id provider limit: waiting ${wait_seconds}s without consuming attempt $attempt"
      mv "$AGENT_LOG" "$STATE_DIR/logs/$phase_id-attempt-$attempt-rate-limit-$rate_limit_waits-agent.log"
      rate_telemetry="$USAGE_DIR/$(basename "${AGENT_LOG%.log}").usage.json"
      if [ -f "$rate_telemetry" ]; then
        mv "$rate_telemetry" "$USAGE_DIR/$phase_id-attempt-$attempt-rate-limit-$rate_limit_waits-agent.usage.json"
      fi
      if [ -n "$ATTEMPT_TEMP_ROOT" ]; then
        cleanup_attempt_worktrees "$ATTEMPT_TEMP_ROOT" \
          "${ATTEMPT_WORKTREES[@]+"${ATTEMPT_WORKTREES[@]}"}"
      fi
      sleep "$wait_seconds"
      phase_run_attempts=$((phase_run_attempts - 1))
      continue
    fi

    if grep -Fq 'RB_RALPH_TIMEOUT_KIND: first-output' "$AGENT_LOG"; then
      incomplete_retries=$((incomplete_retries + 1))
      first_output_reason="executor produced no provider output within ${AGENT_FIRST_OUTPUT_TIMEOUT}s; startup/inference evidence preserved without manager review"
      record_event "$phase_id" "$attempt" "EXECUTOR_FIRST_OUTPUT_TIMEOUT" \
        "$first_output_reason ($incomplete_retries/$MAX_INCOMPLETE_RETRIES)"
      mv "$AGENT_LOG" "$STATE_DIR/logs/$phase_id-attempt-$attempt-first-output-$incomplete_retries-agent.log"
      if [ -n "$ATTEMPT_TEMP_ROOT" ]; then
        cleanup_attempt_worktrees "$ATTEMPT_TEMP_ROOT" \
          "${ATTEMPT_WORKTREES[@]+"${ATTEMPT_WORKTREES[@]}"}"
      fi
      if [ "$incomplete_retries" -gt "$MAX_INCOMPLETE_RETRIES" ]; then
        pause_reason="executor first-output circuit breaker after $incomplete_retries provider call(s): $first_output_reason"
        record_event "$phase_id" "$attempt" "PAUSED" "$pause_reason"
        dashboard_set_phase "$phase_id" paused "$pause_reason" "$(attempt_display "$attempt" "$stalled_attempts")"
        dashboard_finish paused
        wait_dashboard
        printf 'PAUSED: %s\n' "$pause_reason" >&2
        exit 2
      fi
      dashboard_gate "$phase_id" 0 pending \
        "G0 · first-output timeout; retrying provider without manager or implementation attempt"
      log "$phase_id first-output timeout: retry $incomplete_retries/$MAX_INCOMPLETE_RETRIES without consuming attempt $attempt"
      phase_run_attempts=$((phase_run_attempts - 1))
      continue
    fi

    if [ "$use_parallel" -eq 1 ] && [ "$ISOLATION" = "worktree" ]; then
      PATCH_DIR="$STATE_DIR/patches/$phase_id-attempt-$attempt"
      if ! integrate_worktree_changes "$SNAPSHOT_COMMIT" "$ATTEMPT_TEMP_ROOT" "$PATCH_DIR" \
        "${WORKTREE_PATCH_ARGS[@]+"${WORKTREE_PATCH_ARGS[@]}"}"; then
        agent_rc=1
        log "$phase_id isolated task patch integration failed; primary working tree unchanged"
      else
        log "$phase_id isolated task patches integrated into primary working tree"
      fi
      if [ "$INTEGRATION_AUTHORITY_VIOLATION" -eq 1 ]; then authority_violation=1; fi
      ATTEMPT_WORKTREES+=("$ATTEMPT_TEMP_ROOT/integration")
      cleanup_attempt_worktrees "$ATTEMPT_TEMP_ROOT" \
        "${ATTEMPT_WORKTREES[@]+"${ATTEMPT_WORKTREES[@]}"}"
    fi

    if [ "$agent_rc" -eq 0 ]; then
      dashboard_gate "$phase_id" 0 pass "G1 · capturing changed-code evidence"
    else
      dashboard_gate "$phase_id" 0 fail "G1 · capturing evidence after executor failure"
    fi
    dashboard_gate "$phase_id" 1 run "G1 · capturing changed-code evidence"
    node "$EVIDENCE_HELPER" diff "$PROJECT" "$BEFORE_SNAPSHOT" "$CHANGED_PATHS_FILE" \
      || die "$phase_id could not capture changed-path evidence"
    node "$EVIDENCE_HELPER" seal-diff "$PROJECT" "$AUTHORITY_BEFORE_SNAPSHOT" "$AUTHORITY_CHANGED_PATHS" \
      || die "$phase_id could not capture complete write-authority evidence"
    WRITE_AUTHORITY_REPORT="$STATE_DIR/evidence/$phase_id-attempt-$attempt-write-authority.json"
    write_authority_rc=0
    if [ "$EXECUTION_UNIT" = "task" ] && [ "$phase_id" != "$FINAL_PHASE_ID" ]; then
      pending_task_csv="$(IFS=,; printf '%s' "${PENDING_TASK_IDS[*]}")"
      node "$VALIDATION_CACHE_HELPER" authorize "$TASK_DETAILS_FILE" "$AUTHORITY_CHANGED_PATHS" \
        "$ARTIFACTS_RELATIVE" "$pending_task_csv" > "$WRITE_AUTHORITY_REPORT" || write_authority_rc=$?
    else
      node "$VALIDATION_CACHE_HELPER" protect "$AUTHORITY_CHANGED_PATHS" "$ARTIFACTS_RELATIVE" \
        > "$WRITE_AUTHORITY_REPORT" || write_authority_rc=$?
    fi
    if [ "$write_authority_rc" -eq 3 ] || [ "$authority_violation" -eq 1 ]; then
      record_event "$phase_id" "$attempt" "WRITE_AUTHORITY_VIOLATION" \
        "executor changed a protected authority artifact or a path outside selected task Scope"
      dashboard_gate "$phase_id" 1 fail "G1 · write-authority boundary rejected executor changes"
      mark_authority_compromised "executor violated protected artifacts or task Scope during $phase_id attempt $attempt"
      die "$phase_id executor violated the validated write authority; G2/G3 were not started"
    elif [ "$write_authority_rc" -ne 0 ]; then
      die "$phase_id could not verify the validated write authority"
    fi
    change_count="$(evidence_change_count "$CHANGED_PATHS_FILE")"
    if grep -Fq 'RB_RALPH_PROCESS_STATUS: CONTEXT_LIMIT_PAUSE' "$AGENT_LOG"; then
      context_limit_kind="$(sed -n 's/^RB_RALPH_CONTEXT_LIMIT_KIND:[[:space:]]*//p' "$AGENT_LOG" | tail -n 1)"
      context_limit_observed="$(sed -n 's/^RB_RALPH_CONTEXT_LIMIT_OBSERVED:[[:space:]]*//p' "$AGENT_LOG" | tail -n 1)"
      context_limit_configured="$(sed -n 's/^RB_RALPH_CONTEXT_LIMIT_CONFIGURED:[[:space:]]*//p' "$AGENT_LOG" | tail -n 1)"
      pause_reason="limite duro explícito de contexto atingido (${context_limit_kind:-unknown}: ${context_limit_observed:-?}/${context_limit_configured:-?}); alterações em $change_count caminho(s) e evidência foram preservadas; retome com um limite ajustado ou uma tarefa menor"
      record_event "$phase_id" "$attempt" "PAUSED_CONTEXT_LIMIT" "$pause_reason"
      dashboard_gate "$phase_id" 1 pass "G1 · partial changed-code evidence preserved"
      dashboard_set_phase "$phase_id" paused "$pause_reason" "$(attempt_display "$attempt" "$stalled_attempts")"
      refresh_usage_summary
      dashboard_finish paused
      wait_dashboard
      printf 'PAUSED: %s\n' "$pause_reason" >&2
      exit 2
    fi
    EXECUTOR_COMPLETION_FILE="$STATE_DIR/evidence/$phase_id-attempt-$attempt-executor-completion.json"
    node "$EXECUTOR_COMPLETION_HELPER" classify "$AGENT_LOG" "$agent_rc" "$change_count" \
      "$EXECUTOR_COMPLETION_FILE" || die "$phase_id could not classify executor completion"
    record_control_receipt "$EXECUTOR_COMPLETION_FILE"
    executor_completion_status="$(node -e 'const r=require(process.argv[1]);process.stdout.write(r.status)' "$EXECUTOR_COMPLETION_FILE")"
    if [ "$executor_completion_status" = "incomplete" ]; then
      incomplete_retries=$((incomplete_retries + 1))
      incomplete_reason="$(node -e 'const r=require(process.argv[1]);process.stdout.write(r.reason)' "$EXECUTOR_COMPLETION_FILE")"
      record_event "$phase_id" "$attempt" "EXECUTOR_INCOMPLETE" \
        "$incomplete_reason ($incomplete_retries/$MAX_INCOMPLETE_RETRIES); manager not invoked"
      mv "$AGENT_LOG" "$STATE_DIR/logs/$phase_id-attempt-$attempt-incomplete-$incomplete_retries-agent.log"
      if [ "$incomplete_retries" -gt "$MAX_INCOMPLETE_RETRIES" ]; then
        pause_reason="executor completion circuit breaker after $incomplete_retries incomplete provider turn(s): $incomplete_reason"
        record_event "$phase_id" "$attempt" "PAUSED" "$pause_reason"
        dashboard_set_phase "$phase_id" paused "$pause_reason" "$(attempt_display "$attempt" "$stalled_attempts")"
        dashboard_finish paused
        wait_dashboard
        printf 'PAUSED: %s\n' "$pause_reason" >&2
        exit 2
      fi
      dashboard_gate "$phase_id" 0 pending \
        "G0 · incomplete provider turn; retrying executor without manager review"
      log "$phase_id incomplete executor turn: retry $incomplete_retries/$MAX_INCOMPLETE_RETRIES without consuming an implementation attempt"
      phase_run_attempts=$((phase_run_attempts - 1))
      continue
    fi
    incomplete_retries=0
    agent_timed_out=0
    agent_timeout_kind=""
    agent_timeout_limit=""
    agent_timeout_idle=""
    if grep -Fq 'RB_RALPH_PROCESS_STATUS: TIMEOUT' "$AGENT_LOG"; then
      agent_timed_out=1
      agent_timeout_kind="$(sed -n 's/^RB_RALPH_TIMEOUT_KIND:[[:space:]]*//p' "$AGENT_LOG" | tail -n 1)"
      agent_timeout_limit="$(sed -n 's/^RB_RALPH_TIMEOUT_LIMIT_SECONDS:[[:space:]]*//p' "$AGENT_LOG" | tail -n 1)"
      agent_timeout_idle="$(sed -n 's/^RB_RALPH_TIMEOUT_IDLE_SECONDS:[[:space:]]*//p' "$AGENT_LOG" | tail -n 1)"
      dashboard_gate "$phase_id" 0 fail \
        "G0 · executor timeout ${agent_timeout_kind:-unknown} after ${agent_timeout_limit:-?}s; manager will recover"
      log "$phase_id executor timeout: kind=${agent_timeout_kind:-unknown} limit=${agent_timeout_limit:-?}s idle=${agent_timeout_idle:-?}s; forwarding partial evidence to manager"
    fi
    dashboard_gate "$phase_id" 1 pass "G1 · changed-code evidence captured"
    refresh_usage_summary

    validation_failures=0
    validation_commands=0
    manual_validations=0
    validation_state_changed=0
    validation_mechanism_changed=0
    validation_mechanism_paths=""
    if [ "$phase_id" != "$FINAL_PHASE_ID" ]; then
      validation_mechanism_paths="$(node -e '
        const fs=require("node:fs"); const c=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
        const directories=new Set(["test","tests","spec","specs","fixture","fixtures","mock","mocks","snapshot","snapshots"]);
        const mechanism=/^(?:test|spec|fixture|mock|snapshot|validate|verify|check|config|package|requirements|pyproject|cargo|pom|gradle|makefile)(?:[._-]|$)/;
        const exact=new Set(["go.mod","go.sum","cargo.lock","package-lock.json","npm-shrinkwrap.json","yarn.lock","pnpm-lock.yaml","composer.lock","gemfile.lock","poetry.lock","pipfile.lock"]);
        const paths=["added","modified","deleted"].flatMap(k=>c[k]??[]).filter(p=>{
          const value=String(p).toLowerCase(); const parts=value.split("/"); const base=parts.at(-1);
          return exact.has(base) || base.endsWith(".lock") || mechanism.test(base) || parts.some(part=>directories.has(part));
        }); process.stdout.write(paths.sort().join(","));
      ' "$AUTHORITY_CHANGED_PATHS")"
      if [ -n "$validation_mechanism_paths" ]; then validation_mechanism_changed=1; fi
    fi
    VALIDATION_STATE_SNAPSHOT="$STATE_DIR/evidence/$phase_id-attempt-$attempt-validation-state-before.json"
    VALIDATION_STATE_DIFF="$STATE_DIR/evidence/$phase_id-attempt-$attempt-validation-state-diff.json"
    node "$EVIDENCE_HELPER" seal-snapshot "$PROJECT" "$VALIDATION_STATE_SNAPSHOT" \
      || die "$phase_id could not seal the product state used by G2"
    VALIDATION_STATE_DIGEST="$(node "$EVIDENCE_HELPER" seal-digest "$PROJECT" "$VALIDATION_STATE_SNAPSHOT")" \
      || die "$phase_id could not fingerprint the product state used by G2"
    dashboard_set_phase "$phase_id" running "G2 · running deterministic validations" "$(attempt_display "$attempt" "$stalled_attempts")"
    if [ "$phase_id" = "$FINAL_PHASE_ID" ] && [ -n "$OPERATIONAL_CONTRACT" ]; then
      dashboard_gate "$phase_id" 2 run "G2 · running clean-room operational contract"
    elif [ "$VALIDATION_MODE" = "run" ]; then
      dashboard_gate "$phase_id" 2 run "G2 · running deterministic validations"
    else
      dashboard_gate "$phase_id" 2 skip "G2 · validations delegated to manager"
    fi
    printf 'phase=%s attempt=%s mode=%s\nvalidation_state_digest=%s\nexecution_identity=%s\n' \
      "$phase_id" "$attempt" "$VALIDATION_MODE" "$VALIDATION_STATE_DIGEST" "$CURRENT_EXECUTION_IDENTITY" > "$VALIDATION_LOG"
    if [ "$validation_mechanism_changed" -eq 1 ]; then
      printf 'validation_mechanism_changed=1 paths=%s\n' "$validation_mechanism_paths" >> "$VALIDATION_LOG"
    fi
    if [ "$phase_id" = "$FINAL_PHASE_ID" ] && [ -n "$OPERATIONAL_CONTRACT" ]; then
      validation_commands=1
      printf '\n[RBT-FINAL] rb-operational/v1: %s\n' "${OPERATIONAL_CONTRACT#"$PROJECT/"}" >> "$VALIDATION_LOG"
      validation_rc=0
      OPERATIONAL_EXECUTION_IDENTITY_FILE="$STATE_DIR/evidence/$phase_id-attempt-$attempt-operational-execution-identity.json"
      OPERATIONAL_EXECUTION_IDENTITY="$(node "$EXECUTION_IDENTITY_HELPER" operational "$OPERATIONAL_EXECUTION_IDENTITY_FILE" "$EXECUTION_IDENTITY_FILE" "$OPERATIONAL_CONTRACT")" \
        || die "$phase_id could not establish operational execution identity"
      printf '[RBT-FINAL] operational_execution_identity=%s\n' "$OPERATIONAL_EXECUTION_IDENTITY" >> "$VALIDATION_LOG"
      RB_RALPH_OPERATIONAL_CORE="$CORE_CLI" node "$OPERATIONAL_VERIFIER" run "$OPERATIONAL_CONTRACT" "$PROJECT" >> "$VALIDATION_LOG" 2>&1 || validation_rc=$?
      printf '[RBT-FINAL] exit=%s\n' "$validation_rc" >> "$VALIDATION_LOG"
      if [ "$validation_rc" -ne 0 ]; then validation_failures=1; fi
      if [ "$(evidence_change_count "$CHANGED_PATHS_FILE")" -gt 0 ]; then
        rerun_rbf_regressions
      fi
    elif [ "$VALIDATION_MODE" = "run" ]; then
      VALIDATION_CACHE_FILE="$STATE_DIR/evidence/$phase_id-validation-cache.json"
      VALIDATION_SELECTION_FILE="$STATE_DIR/evidence/$phase_id-attempt-$attempt-validation-selection.tsv"
      validation_selection_mode="incremental"
      [ "$use_parallel" -eq 0 ] || validation_selection_mode="combined"
      node "$VALIDATION_CACHE_HELPER" select \
        "$TASK_DETAILS_FILE" "$VALIDATION_DETAILS_FILE" "$CHANGED_PATHS_FILE" "$VALIDATION_CACHE_FILE" "$VALIDATION_STATE_DIGEST" "$CURRENT_EXECUTION_IDENTITY" "$validation_selection_mode" \
        > "$VALIDATION_SELECTION_FILE" \
        || die "$phase_id could not select bounded incremental validations"
      validation_impact="$(awk -F '\t' '$1 == "meta" && $2 == "impact" { print $3; exit }' "$VALIDATION_SELECTION_FILE")"
      validation_impact_reason="$(awk -F '\t' '$1 == "meta" && $2 == "impact" { print $4; exit }' "$VALIDATION_SELECTION_FILE")"
      printf 'impact=%s reason=%s\n' "${validation_impact:-full}" "${validation_impact_reason:-unavailable}" >> "$VALIDATION_LOG"
      while IFS= read -r validation_row; do
        IFS="$TSV_SEPARATOR" read -r validation_task validation_kind validation_value validation_action validation_key validation_provenance \
          <<< "${validation_row//$'\t'/$TSV_SEPARATOR}"
        [ "$validation_task" = "meta" ] && continue
        case "$validation_kind" in
          command)
            validation_commands=$((validation_commands + 1))
            printf '\n[%s] command: %s\n' "$validation_task" "$validation_value" >> "$VALIDATION_LOG"
            if [ "$validation_action" = "reuse" ]; then
              validation_rc=0
              printf '[%s] exit=0 duration_seconds=0 reused_from=%s\n' \
                "$validation_task" "${validation_provenance:-validation-cache}" >> "$VALIDATION_LOG"
            else
              validation_rc=0
              validation_started="$(date +%s)"
              if [ "$VALIDATION_TIMEOUT" -gt 0 ] && command -v timeout >/dev/null 2>&1; then
                (cd "$PROJECT" && timeout --foreground "${VALIDATION_TIMEOUT}s" bash -lc "$validation_value") \
                  >> "$VALIDATION_LOG" 2>&1 || validation_rc=$?
              else
                (cd "$PROJECT" && bash -lc "$validation_value") >> "$VALIDATION_LOG" 2>&1 || validation_rc=$?
              fi
              validation_duration=$(( $(date +%s) - validation_started ))
              printf '[%s] exit=%s duration_seconds=%s\n' \
                "$validation_task" "$validation_rc" "$validation_duration" >> "$VALIDATION_LOG"
              node "$VALIDATION_CACHE_HELPER" record "$VALIDATION_CACHE_FILE" "$validation_key" \
                "$validation_task" "$validation_kind" "$validation_value" "$validation_rc" \
                "${VALIDATION_LOG_CANONICAL#"$PROJECT/"}" "$VALIDATION_STATE_DIGEST" "$CURRENT_EXECUTION_IDENTITY" \
                || die "$phase_id could not persist validation evidence"
            fi
            if [ "$validation_rc" -ne 0 ]; then
              validation_failures=$((validation_failures + 1))
            fi
            ;;
          manual)
            manual_validations=$((manual_validations + 1))
            printf '\n[%s] manual: %s\n' "$validation_task" "$validation_value" >> "$VALIDATION_LOG"
            ;;
          human)
            printf '\n[%s] human: %s\n' "$validation_task" "$validation_value" >> "$VALIDATION_LOG"
            ;;
        esac
      done < "$VALIDATION_SELECTION_FILE"
    else
      printf 'Deterministic commands delegated to manager by configuration.\n' >> "$VALIDATION_LOG"
    fi
    RB_RALPH_REDACT_CREDENTIALS="${AGENT_CREDENTIAL}${TSV_SEPARATOR}${MANAGER_CREDENTIAL}" \
      node "$EVIDENCE_SANITIZER" redact "$VALIDATION_LOG" "$VALIDATION_LOG_CANONICAL" \
        "${RB_RALPH_EVIDENCE_ENV:-},${MEMORY_TOKEN_ENV:-}" "$OPERATIONAL_CONTRACT"
    rm -f -- "$VALIDATION_LOG"
    VALIDATION_LOG="$VALIDATION_LOG_CANONICAL"
    record_control_receipt "$VALIDATION_LOG"
    node "$EVIDENCE_HELPER" seal-diff "$PROJECT" "$VALIDATION_STATE_SNAPSHOT" "$VALIDATION_STATE_DIFF" \
      || die "$phase_id could not verify product continuity across G2"
    validation_state_changes="$(evidence_change_count "$VALIDATION_STATE_DIFF")"
    if [ "$validation_state_changes" -ne 0 ]; then
      validation_state_changed=1
      validation_failures=$((validation_failures + 1))
      printf 'RB_RALPH_VALIDATION_STATE_VIOLATION: G2 changed %s product path(s); green output is not valid proof\n' \
        "$validation_state_changes" >> "$VALIDATION_LOG"
      cp -- "$VALIDATION_STATE_DIFF" "$STATE_DIR/evidence/$phase_id-attempt-$attempt-validation-state-violation.json"
    fi
    log "$phase_id validations: commands=$validation_commands failures=$validation_failures manual=$manual_validations mode=$VALIDATION_MODE"
    CURRENT_EVIDENCE_FINGERPRINT="$(evidence_fingerprint "$CHANGED_PATHS_FILE" "$VALIDATION_LOG" "$PROJECT")"
    EVIDENCE_INDEX_FILE="$STATE_DIR/evidence/$phase_id-attempt-$attempt-index.json"
    node "$EVIDENCE_INDEX_HELPER" "$CHANGED_PATHS_FILE" "$VALIDATION_LOG" "$AGENT_LOG" "$EVIDENCE_INDEX_FILE" \
      || die "$phase_id could not build the bounded evidence index"
    PHASE_PROVENANCE_FILE="$STATE_DIR/evidence/$phase_id-attempt-$attempt-provenance.json"
    validation_provenance_origin="validation-output"
    [ "$phase_id" != "$FINAL_PHASE_ID" ] || validation_provenance_origin="operational-verification-output"
    node "$EVIDENCE_PROVENANCE_HELPER" "$PHASE_PROVENANCE_FILE" \
      "${CHANGED_PATHS_FILE#"$PROJECT/"}" orchestrator-generated deterministic \
      "${AGENT_LOG#"$PROJECT/"}" provider-output provider-asserted \
      "${VALIDATION_LOG#"$PROJECT/"}" "$validation_provenance_origin" deterministic-process-output \
      "${EVIDENCE_INDEX_FILE#"$PROJECT/"}" orchestrator-generated deterministic
    record_control_receipt "$PHASE_PROVENANCE_FILE"
    if [ "$phase_id" = "$FINAL_PHASE_ID" ] && [ -n "$OPERATIONAL_CONTRACT" ]; then
      if [ "$validation_failures" -eq 0 ]; then
        dashboard_gate "$phase_id" 2 pass "G2 · clean-room operational contract passed"
      else
        dashboard_gate "$phase_id" 2 fail "G2 · clean-room operational contract failed"
      fi
    elif [ "$VALIDATION_MODE" = "run" ]; then
      if [ "$validation_failures" -eq 0 ]; then
        dashboard_gate "$phase_id" 2 pass "G2 · deterministic validations passed"
      else
        dashboard_gate "$phase_id" 2 fail "G2 · deterministic validation failed"
      fi
    fi

    {
      printf 'RB_RALPH_ROLE: technical-manager\n'
      printf 'PROJECT_ROOT: %s\nPLAN_PATH: %s\nPHASE_ID: %s\nATTEMPT: %s\n' \
        "$PROJECT" "$PLAN_PATH" "$phase_id" "$attempt"
      printf 'AGENT_EXIT_CODE: %s\nAGENT_LOG: %s\n' "$agent_rc" "${AGENT_LOG#"$PROJECT/"}"
      printf 'AGENT_TIMED_OUT: %s\nAGENT_TIMEOUT_KIND: %s\nAGENT_TIMEOUT_LIMIT_SECONDS: %s\nAGENT_TIMEOUT_IDLE_SECONDS: %s\n' \
        "$agent_timed_out" "${agent_timeout_kind:-none}" "${agent_timeout_limit:-0}" "${agent_timeout_idle:-0}"
      printf 'CHANGED_PATHS_FILE: %s\n' "${CHANGED_PATHS_FILE#"$PROJECT/"}"
      printf 'VALIDATION_MODE: %s\nVALIDATION_COMMANDS: %s\nVALIDATION_FAILURES: %s\n' \
        "$VALIDATION_MODE" "$validation_commands" "$validation_failures"
      printf 'VALIDATION_STATE_DIGEST: %s\nVALIDATION_STATE_CHANGED_DURING_G2: %s\n' \
        "$VALIDATION_STATE_DIGEST" "$validation_state_changed"
      printf 'VALIDATION_MECHANISM_CHANGED: %s\n' "$validation_mechanism_changed"
      printf 'MANUAL_VALIDATIONS: %s\nVALIDATION_LOG: %s\n\n' \
        "$manual_validations" "${VALIDATION_LOG#"$PROJECT/"}"
      printf 'EVIDENCE_INDEX: %s\n\n' "${EVIDENCE_INDEX_FILE#"$PROJECT/"}"
      printf 'EVIDENCE_FINGERPRINT: %s\n\n' "$CURRENT_EVIDENCE_FINGERPRINT"
      if [ "$phase_id" = "$FINAL_PHASE_ID" ]; then
        printf '%s\n' \
          'FINAL_OPERATIONAL_AUDIT: 1' \
          "OPERATIONAL_CONTRACT: ${OPERATIONAL_CONTRACT#"$PROJECT/"}" \
          '' \
          'This is independent product acceptance, not another source-code review.' \
          'Identify the product type and claimed platforms from repository evidence; do not assume a web application or any stack.' \
          'Independently repeat at least one representative end-to-end consumer workflow in a fresh disposable copy or equivalent isolated environment.' \
          'Do not accept the executor narrative or deterministic log without checking the actual product boundary yourself.' \
          'Do not reuse already-running services, prebuilt artifacts, installed dependencies, local application state, or undeclared credentials as proof.' \
          'For desktop/mobile software, require honest platform-appropriate launch/package/UI evidence; for CLI, library, service, plugin, package, or job, exercise its real consumer boundary.' \
          'If the operational workflow, documentation, packaging, configuration, startup, or integration is defective, return RETRY with the exact failing command/probe and observed output so the executor can repair it.' \
          'A missing external credential may be BLOCKED only when no credential-free documented scenario can prove the delivered behavior.' \
          ''
      elif [ "$VALIDATION_MODE" = "run" ]; then
        printf '%s\n' \
          'VALIDATION AUTHORITY: RB Ralph is the sole executor of every declared deterministic validation command for this phase.' \
          'Do not run, repeat, or independently re-create a command already represented in VALIDATION_LOG or EVIDENCE_INDEX, even for confirmation.' \
          'A reused successful row is authoritative only when its command text and the complete sealed product state (including test/config/dependency inputs) exactly match the cached proof. A changed validation mechanism always runs again; inspect its current source rather than treating exit zero as semantic proof.' \
          'Review source, contracts, changed boundaries, and the bounded evidence. If a genuinely missing check is required, return it once as an UNPROVEN finding for the executor/orchestrator; do not execute it in the manager call.' \
          ''
      fi
      printf '%s\n' \
        'Act as the technical manager for this run. Inspect the current code at every path in CHANGED_PATHS_FILE.' \
        'Start from the bounded EVIDENCE_INDEX below. It contains canonical paths, hashes, changed paths, executor status markers, and validation command/exit/duration rows.' \
        'Open AGENT_LOG or VALIDATION_LOG only for a concrete unresolved matrix row; read a bounded relevant excerpt and cite its canonical path. Do not ingest complete raw transcripts by default.' \
        'Inspect current source at changed boundaries and verify every task and acceptance criterion in the validated phase below.' \
        'Do not implement or repair code in this review step.' \
        "REVIEW_SCOPE: $MANAGER_REVIEW_MODE" \
        "Treat $ARTIFACTS_RELATIVE as read-only planning input; never edit generated specifications or fragments during review." \
        'Audit the entire matrix before deciding. Never stop after finding the first sufficient reason for RETRY.' \
        'Return every required matrix row exactly once, followed by every currently observable finding as one complete batch, then one decision and one short reason using this protocol:' \
        'RB_RALPH_AUDIT_STATUS: COMPLETE' \
        'RB_RALPH_CRITERION: <required-id> | <PASS|FAIL|UNPROVEN|HUMAN_PENDING|NOT_APPLICABLE> | <concise canonical evidence/provenance>' \
        'RB_RALPH_FINDING: <criterion-id[,criterion-id]> | <affected path or boundary> | <expected state> | <observed failure> | <reproduction/evidence provenance>' \
        'RB_RALPH_FINDING_RESOLUTION: <open-finding-id> | <specific new canonical code/validation evidence>' \
        'RB_RALPH_DECISION: COMPLETE | RETRY | BLOCKED' \
        'RB_RALPH_REASON: <short evidence-based reason>' \
        '' \
        'Use COMPLETE only when every declared task and criterion is PASS with canonical evidence. NOT_APPLICABLE is unavailable unless a future validated contract declares an explicit exemption.' \
        'For RETRY, emit one RB_RALPH_FINDING row for every FAIL or UNPROVEN criterion.' \
        'A finding diagnoses failure relative to the validated phase. Its boundary, expected state, observed text, and recommendation do not create implementation authority or authorize work outside the selected task Scope.' \
        'Group equivalent reproductions under one root-cause finding. Do not create a new finding merely because a different input phrase exposes the same violated invariant.' \
        'Keep the finding boundary and expected state stable while that invariant remains unresolved: boundary names the canonical component or public interface, expected names the invariant, observed may list all current counterexamples, and evidence names their provenance.' \
        'When a deterministic mechanism is expected to classify natural language, audit the complete finite authority and its positive/negative equivalence classes in this batch. If no finite authority or explicit classifier contract exists, report one unsafe-ambiguity finding and use BLOCKED instead of feeding the executor an endless vocabulary expansion.' \
        'The structured finding rows are the complete current snapshot. Repeat an unresolved finding in every RETRY batch. To close an open finding, emit exactly one RB_RALPH_FINDING_RESOLUTION naming its ledger ID and specific new canonical evidence; omission is never closure.' \
        'Findings are cumulative across retries. COMPLETE means every open finding below has a named resolution tied to new current code or canonical validation evidence; a new reason never erases an older one.' \
        'Use RETRY when another implementation attempt can reasonably fix the result. Implementation defects, test failures, incomplete criteria, and incorrect technical approaches are RETRY, never BLOCKED.' \
        'When AGENT_TIMED_OUT is 1, inspect all partial evidence, return RETRY, and give the next executor a concrete recovery strategy that avoids the stalled command or approach. An executor timeout is recoverable and must not be treated as a terminal implementation failure.' \
        'For RETRY, make the reason concrete enough for the executor to correct its approach on the next ephemeral call.' \
        'Use BLOCKED only when an external decision, missing authority, unavailable credential/provider, or unsafe ambiguity prevents implementation progress.' \
        ''
      # The final phase is independent product acceptance, not a source review:
      # its whole purpose is to exercise the real consumer boundary and refuse a
      # product that does not work. Narrowing it to "did the executor deliver
      # what the fragment asked" would remove the only gate that answers a
      # different question, so RBF always reviews at full depth.
      if [ "$MANAGER_REVIEW_MODE" = "code" ] || [ "$phase_id" = "$FINAL_PHASE_ID" ]; then
        printf '%s\n' \
          'REVIEW SCOPE — code: judge delivery against the fragment first, then audit the changed source itself.' \
          'Report every defect observable in the current evidence, including independent defects in criteria this phase did not name: incorrect logic at a changed boundary, a missing error path, an unhandled input class, a broken invariant, or a regression in behavior the phase was meant to preserve.' \
          'When a deterministic mechanism is expected to classify natural language, audit the complete finite authority and its positive/negative equivalence classes in this batch. If no finite authority or explicit classifier contract exists, report one unsafe-ambiguity finding and use BLOCKED instead of feeding the executor an endless vocabulary expansion.' \
          'A criterion that is technically satisfied by defective code is not PASS. Say what is wrong and why the delivered behavior does not hold.' \
          ''
      else
        printf '%s\n' \
          'REVIEW SCOPE — delivery: judge one question. Did the executor deliver what this fragment asked for?' \
          'For each task and acceptance criterion, confirm the declared change exists at the declared scope and the stated observable outcome is evidenced by the current source, the validation rows, or the bounded evidence index.' \
          'A criterion whose observable outcome is evidenced is PASS. Do not withhold PASS for style, naming, structure, test depth, performance, or any concern this fragment did not ask for.' \
          'Do not open findings for defects outside the declared criteria. If you notice one, it is not this phase; leave it to a later phase, a review workflow, or an operator decision.' \
          'FAIL or UNPROVEN belongs to a criterion the executor did not deliver or did not evidence — not to work delivered in a way you would have done differently.' \
          'This scope narrows your judgment only. It never approves past a deterministic gate: a non-zero executor exit, a failed validation command, or a finding reopened on unchanged evidence still forces RETRY, and that conversion is made by the orchestrator, not by you.' \
          ''
      fi
      printf '%s\n' \
        '--- CUMULATIVE OPEN FINDINGS ---'
      if [ -n "$(open_findings "$phase_id")" ]; then
        open_findings "$phase_id"
      else
        printf '%s\n' '(none)'
      fi
      printf '%s\n' '' \
        '--- CHANGED PATH SUMMARY ---'
      cat "$CHANGED_PATHS_FILE"
      # The reviewer used to be told to inspect PROJECT_ROOT itself, and did:
      # an observed audit spent 194k input tokens re-reading a tree the
      # orchestrator had already diffed. Same bytes, same moment, no round trip.
      if [ "${AGENT_CONTEXT:-1}" != "0" ]; then
        node "$AGENT_CONTEXT_HELPER" --mode manager \
          --root "$PROJECT" \
          --changes "$CHANGED_PATHS_FILE" \
          --max-bytes "${MANAGER_CONTEXT_BYTES:-65536}" 2>/dev/null || true
      fi
      printf '%s\n' '' \
        '--- BOUNDED CANONICAL EVIDENCE INDEX ---'
      cat "$EVIDENCE_INDEX_FILE"
      printf '%s\n' '' \
        '--- REQUIRED ACCEPTANCE MATRIX (one RB_RALPH_CRITERION row per ID) ---'
      node "$MANAGER_AUDIT_HELPER" expected "$PHASE_FILE"
      printf '%s\n' '' \
        '--- VALIDATED PHASE ---'
      cat "$PHASE_FILE"
    } > "$MANAGER_PROMPT"
    ensure_prompt_budget "$MANAGER_PROMPT" "$phase_id manager"

    manager_try=0
    manager_retry_feedback=""
    MANAGER_AUDIT_REPORT=""
    while :; do
      manager_try=$((manager_try + 1))
      if [ "$manager_try" -eq 1 ]; then
        ACTIVE_MANAGER_PROMPT="$MANAGER_PROMPT"
        ACTIVE_MANAGER_LOG="$MANAGER_LOG"
      else
        ACTIVE_MANAGER_PROMPT="$STATE_DIR/prompts/$phase_id-attempt-$attempt-manager-retry-$manager_try.txt"
        ACTIVE_MANAGER_LOG="$STATE_DIR/logs/$phase_id-attempt-$attempt-manager-retry-$manager_try.log"
        {
          cat "$MANAGER_PROMPT"
          printf '%s\n' '' '--- MANAGER RETRY ---' \
            "A chamada anterior do gerente não produziu uma decisão utilizável: $manager_retry_feedback" \
            'Revise a mesma evidência sem implementar alterações. Complete todas as linhas ausentes ou inválidas e devolva novamente a matriz e o lote estruturado completos, RB_RALPH_AUDIT_STATUS, RB_RALPH_DECISION e RB_RALPH_REASON.'
        } > "$ACTIVE_MANAGER_PROMPT"
        ensure_prompt_budget "$ACTIVE_MANAGER_PROMPT" "$phase_id manager retry $manager_try"
      fi

      log "$phase_id attempt $attempt: manager review $manager_try/$((MAX_MANAGER_RETRIES + 1))"
      dashboard_set_phase "$phase_id" running \
        "G3 · manager review $manager_try/$((MAX_MANAGER_RETRIES + 1)) · idle timeout ${MANAGER_IDLE_TIMEOUT}s" \
        "$(attempt_display "$attempt" "$stalled_attempts")"
      dashboard_gate "$phase_id" 3 run "G3 · technical manager is reviewing evidence"
      manager_rc=0
      MANAGER_TELEMETRY_FILE="$USAGE_DIR/$(basename "${ACTIVE_MANAGER_LOG%.log}").usage.json"
      MANAGER_CONTROL_SNAPSHOT="$(mktemp "${TMPDIR:-/tmp}/rb-ralph-manager-control-before.XXXXXX")"
      MANAGER_CONTROL_DIFF="$(mktemp "${TMPDIR:-/tmp}/rb-ralph-manager-control-diff.XXXXXX")"
      MANAGER_PRODUCT_SEAL="$STATE_DIR/evidence/$phase_id-attempt-$attempt-manager-$manager_try-product-seal.json"
      MANAGER_PRODUCT_DIFF="$(mktemp "${TMPDIR:-/tmp}/rb-ralph-manager-product-diff.XXXXXX")"
      CONTROL_RECEIPT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/rb-ralph-control-receipts.XXXXXX")"
      ACTIVE_TEMP_ROOTS+=("$CONTROL_RECEIPT_DIR")
      node "$EVIDENCE_HELPER" seal-snapshot "$PROJECT" "$MANAGER_PRODUCT_SEAL" \
        || die "$phase_id could not seal the G2 product state before manager review"
      node "$CONTROL_PLANE_HELPER" snapshot "$STATE_DIR" "$MANAGER_CONTROL_SNAPSHOT" \
        || die "$phase_id could not protect control-plane evidence before manager review"
      invoke_manager "$ACTIVE_MANAGER_PROMPT" "$ACTIVE_MANAGER_LOG" "$MANAGER_TELEMETRY_FILE" \
        || manager_rc=$?
      node "$EVIDENCE_HELPER" seal-diff "$PROJECT" "$MANAGER_PRODUCT_SEAL" "$MANAGER_PRODUCT_DIFF" \
        || die "$phase_id could not verify the sealed product state after manager review"
      manager_control_rc=0
      node "$CONTROL_PLANE_HELPER" verify "$STATE_DIR" "$MANAGER_CONTROL_SNAPSHOT" "$CONTROL_RECEIPT_DIR" "$MANAGER_CONTROL_DIFF" \
        || manager_control_rc=$?
      rm -f -- "$MANAGER_CONTROL_SNAPSHOT"
      rm -rf -- "$CONTROL_RECEIPT_DIR"
      CONTROL_RECEIPT_DIR=""
      if [ "$manager_control_rc" -eq 3 ]; then
        printf '\nRB_RALPH_CONTROL_PLANE_VIOLATION: manager changed orchestrator-owned canonical state\n' >> "$ACTIVE_MANAGER_LOG"
        cat "$MANAGER_CONTROL_DIFF" >> "$ACTIVE_MANAGER_LOG"
        record_event "$phase_id" "$attempt" "CONTROL_PLANE_VIOLATION" \
          "manager changed or introduced unowned .rb/runs artifacts; run sealed as compromised"
        mark_authority_compromised "manager changed or introduced unowned control-plane artifacts during $phase_id attempt $attempt"
        cp -- "$MANAGER_CONTROL_DIFF" "$STATE_DIR/evidence/$phase_id-attempt-$attempt-manager-$manager_try-control-plane-violation.json"
        rm -f -- "$MANAGER_CONTROL_DIFF" "$MANAGER_PRODUCT_DIFF"
        die "$phase_id manager violated orchestrator control-plane ownership; run cannot continue safely"
      elif [ "$manager_control_rc" -ne 0 ]; then
        rm -f -- "$MANAGER_CONTROL_DIFF" "$MANAGER_PRODUCT_DIFF"
        die "$phase_id could not verify control-plane integrity after manager review"
      fi
      rm -f -- "$MANAGER_CONTROL_DIFF"
      [ ! -f "$PROJECT/.rb/runs/AUTHORITY-COMPROMISED" ] \
        || die "$phase_id manager introduced or encountered a project authority-compromise marker"
      manager_product_change_count="$(evidence_change_count "$MANAGER_PRODUCT_DIFF")"
      if [ "$manager_product_change_count" -ne 0 ]; then
        cp -- "$MANAGER_PRODUCT_DIFF" "$STATE_DIR/evidence/$phase_id-attempt-$attempt-manager-$manager_try-product-violation.json"
        record_event "$phase_id" "$attempt" "MANAGER_STATE_VIOLATION" \
          "manager changed $manager_product_change_count product path(s) after G2; COMPLETE is forbidden"
        mark_authority_compromised "manager changed the sealed G2 product state during $phase_id attempt $attempt"
        rm -f -- "$MANAGER_PRODUCT_DIFF"
        die "$phase_id manager changed the sealed G2 product state; review cannot continue"
      fi
      rm -f -- "$MANAGER_PRODUCT_DIFF"
      record_context_compaction_signal "$ACTIVE_MANAGER_LOG" manager "$phase_id" "$attempt"
      refresh_usage_summary

      if grep -Fq 'RB_RALPH_PROCESS_STATUS: CONTEXT_LIMIT_PAUSE' "$ACTIVE_MANAGER_LOG"; then
        manager_limit_kind="$(sed -n 's/^RB_RALPH_CONTEXT_LIMIT_KIND:[[:space:]]*//p' "$ACTIVE_MANAGER_LOG" | tail -n 1)"
        manager_limit_observed="$(sed -n 's/^RB_RALPH_CONTEXT_LIMIT_OBSERVED:[[:space:]]*//p' "$ACTIVE_MANAGER_LOG" | tail -n 1)"
        manager_limit_configured="$(sed -n 's/^RB_RALPH_CONTEXT_LIMIT_CONFIGURED:[[:space:]]*//p' "$ACTIVE_MANAGER_LOG" | tail -n 1)"
        decision="PAUSED"
        reason="limite duro explícito de contexto do gerente atingido (${manager_limit_kind:-unknown}: ${manager_limit_observed:-?}/${manager_limit_configured:-?}); evidência do executor permanece preservada e o gerente pode ser retomado sem repetir implementação"
        break
      fi

      if provider_rate_limited "$ACTIVE_MANAGER_LOG" "$manager_rc"; then
        rate_limit_waits=$((rate_limit_waits + 1))
        if [ "$rate_limit_waits" -gt "$MAX_RATE_LIMIT_WAITS" ]; then
          reason="manager rate-limit waits exhausted; evidence remains resumable; log=${ACTIVE_MANAGER_LOG#"$PROJECT/"}"
          decision="PAUSED"
          break
        fi
        wait_seconds="$(provider_wait_seconds "$ACTIVE_MANAGER_LOG")"
        record_event "$phase_id" "$attempt" "MANAGER_RETRY" \
          "rate limit: aguardando ${wait_seconds}s para revisar a mesma evidência ($rate_limit_waits/${MAX_RATE_LIMIT_WAITS:-0})"
        dashboard_gate "$phase_id" 3 pending "manager provider limit · waiting ${wait_seconds}s; executor will not be repeated"
        log "$phase_id manager provider limit: waiting ${wait_seconds}s; preserving executor evidence"
        mv "$ACTIVE_MANAGER_LOG" "$STATE_DIR/logs/$phase_id-attempt-$attempt-manager-rate-limit-$rate_limit_waits.log"
        if [ -f "$MANAGER_TELEMETRY_FILE" ]; then
          mv "$MANAGER_TELEMETRY_FILE" "$USAGE_DIR/$phase_id-attempt-$attempt-manager-rate-limit-$rate_limit_waits.usage.json"
        fi
        sleep "$wait_seconds"
        manager_try=$((manager_try - 1))
        continue
      fi

      decision=""
      reason=""
      if [ "$manager_rc" -eq 0 ]; then
        MANAGER_AUDIT_REPORT="${ACTIVE_MANAGER_LOG%.log}-audit.json"
        if [ "$MANAGER_AUDIT_MODE" = "exhaustive" ]; then
          manager_audit_command=(node "$MANAGER_AUDIT_HELPER" validate "$PHASE_FILE" "$ACTIVE_MANAGER_LOG")
        else
          manager_audit_command=(node "$MANAGER_AUDIT_HELPER" validate-legacy "$ACTIVE_MANAGER_LOG")
        fi
        if ! "${manager_audit_command[@]}" > "$MANAGER_AUDIT_REPORT"; then
          manager_retry_feedback="invalid canonical manager audit: $(node -e 'const r=JSON.parse(require("node:fs").readFileSync(process.argv[1],"utf8"));process.stdout.write((r.issues??[]).join("; "))' "$MANAGER_AUDIT_REPORT"); log=${ACTIVE_MANAGER_LOG#"$PROJECT/"}"
        else
          decision="$(node -e 'const r=JSON.parse(require("node:fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(r.decision??"")' "$MANAGER_AUDIT_REPORT")"
          reason="$(node -e 'const r=JSON.parse(require("node:fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(r.reason??"")' "$MANAGER_AUDIT_REPORT")"
        fi
      fi

      if [ "$manager_rc" -ne 0 ]; then
        decision=""
        reason="$(manager_failure_summary "$ACTIVE_MANAGER_LOG" "$manager_rc" "${MANAGER_PROVIDER:-custom}" "$MANAGER_MODEL")"
        if manager_failure_is_terminal "$ACTIVE_MANAGER_LOG"; then
          decision="BLOCKED"
          reason="bloqueio externo do gerente; o executor não será repetido: $reason"
          break
        fi
        manager_retry_feedback="$reason"
      elif [ -z "$decision" ]; then
        [ -n "$manager_retry_feedback" ] || \
          manager_retry_feedback="resposta inválida: faltou RB_RALPH_DECISION válido; log=${ACTIVE_MANAGER_LOG#"$PROJECT/"}"
      elif [ -z "$reason" ]; then
        manager_retry_feedback="resposta inválida: faltou RB_RALPH_REASON; log=${ACTIVE_MANAGER_LOG#"$PROJECT/"}"
        decision=""
      else
        if [ "$agent_timed_out" -eq 1 ]; then
          original_decision="$decision"
          decision="RETRY"
          reason="executor sofreu timeout ${agent_timeout_kind:-configurado} de ${agent_timeout_limit:-?}s; retomar da evidência parcial com abordagem diferente; revisão do gerente ($original_decision): $reason"
        elif [ "$decision" = "COMPLETE" ] && [ "$agent_rc" -ne 0 ]; then
          decision="RETRY"
          reason="implementation agent or isolated integration exited with $agent_rc; $reason"
        elif [ "$decision" = "COMPLETE" ] && [ "$validation_failures" -gt 0 ]; then
          decision="RETRY"
          reason="deterministic validation failed ($validation_failures command(s)); $reason"
        elif [ "$decision" = "COMPLETE" ] && [ "$validation_mechanism_changed" -eq 1 ]; then
          decision="RETRY"
          reason="validation mechanism changed at ${validation_mechanism_paths}; fresh green output is recorded but cannot complete in the same attempt without a subsequent independent review; $reason"
        fi
        if [ "$decision" = "COMPLETE" ]; then
          node "$MANAGER_AUDIT_HELPER" reconcile "$FINDINGS_FILE" "$MANAGER_AUDIT_REPORT" \
            "$phase_id" "$attempt" "$CURRENT_EVIDENCE_FINGERPRINT" >/dev/null \
            || die "$phase_id could not reconcile canonical finding lifecycle"
          if [ -n "$(open_findings "$phase_id")" ]; then
            decision="RETRY"
            reason="manager omitted an open finding without a specific new-evidence RB_RALPH_FINDING_RESOLUTION; $reason"
          fi
        fi
        break
      fi

      if [ "$manager_try" -gt "$MAX_MANAGER_RETRIES" ]; then
        decision="PAUSED"
        reason="circuit breaker do gerente após $manager_try chamada(s) sobre a mesma evidência: $manager_retry_feedback"
        break
      fi
      record_event "$phase_id" "$attempt" "MANAGER_RETRY" \
        "$manager_retry_feedback; repetindo somente o gerente ($manager_try/$MAX_MANAGER_RETRIES)"
      dashboard_gate "$phase_id" 3 pending \
        "G3 · manager retry; executor evidence preserved"
      if manager_failure_is_transient "$ACTIVE_MANAGER_LOG"; then
        sleep "$MANAGER_RETRY_WAIT"
      elif [ "$manager_rc" -ne 0 ] || [ -z "$decision" ]; then
        sleep "$MANAGER_RETRY_WAIT"
      fi
    done
    MANAGER_LOG="$ACTIVE_MANAGER_LOG"

    case "$decision" in
      COMPLETE)
        dashboard_gate "$phase_id" 3 pass "G3 · phase accepted by technical manager"
        record_event "$phase_id" "$attempt" "COMPLETE" "$reason"
        dashboard_refresh_findings
        if [ "$phase_id" = "$FINAL_PHASE_ID" ]; then
          printf '%s\n' "$OPERATIONAL_FINGERPRINT" > "$OPERATIONAL_ACCEPTED_FILE"
        fi
        node -e '
          const fs=require("node:fs"); const [file,product,execution,operational,operationalExecution]=process.argv.slice(1);
          const value={contract:"rb-ralph-phase-evidence/v1",productDigest:product,executionDigest:execution};
          if (operational) { value.operationalFingerprint=operational; value.operationalExecutionDigest=operationalExecution; }
          fs.writeFileSync(file, JSON.stringify(value,null,2)+"\n", {mode:0o600});
        ' "$STATE_DIR/evidence/$phase_id-accepted.json" "$VALIDATION_STATE_DIGEST" "$CURRENT_EXECUTION_IDENTITY" \
          "$(if [ "$phase_id" = "$FINAL_PHASE_ID" ]; then printf '%s' "$OPERATIONAL_FINGERPRINT"; fi)" \
          "$(if [ "$phase_id" = "$FINAL_PHASE_ID" ]; then printf '%s' "$OPERATIONAL_EXECUTION_IDENTITY"; fi)"
        sync_memory_checkpoint \
          "$STATE_DIR/memory/checkpoints/$phase_id.json" \
          "$STATE_DIR/memory/checkpoints/$phase_id-result.json" \
          "$phase_id" "$title" "$reason" "${VALIDATION_LOG#"$PROJECT/"}"
        log "$phase_id complete: $reason"
        dashboard_set_phase "$phase_id" complete "phase accepted by technical manager" "$(attempt_display "$attempt" "$stalled_attempts")"
        completed=1
        break
        ;;
      BLOCKED)
        dashboard_gate "$phase_id" 3 fail "G3 · manager reported an external blocker"
        record_event "$phase_id" "$attempt" "BLOCKED" "$reason"
        dashboard_set_phase "$phase_id" blocked "$reason" "$(attempt_display "$attempt" "$stalled_attempts")"
        die "$phase_id blocked by manager: $reason"
        ;;
      PAUSED)
        dashboard_gate "$phase_id" 3 fail "G3 · manager recovery circuit breaker"
        record_event "$phase_id" "$attempt" "PAUSED" "$reason"
        dashboard_set_phase "$phase_id" paused "$reason" "$(attempt_display "$attempt" "$stalled_attempts")"
        dashboard_finish paused
        wait_dashboard
        printf 'PAUSED: %s\n' "$reason" >&2
        exit 2
        ;;
      RETRY)
        previous_feedback="$LAST_FEEDBACK"
        current_finding_batch="$(manager_finding_batch_fingerprint "$MANAGER_AUDIT_REPORT")"
        change_count="$(evidence_change_count "$CHANGED_PATHS_FILE")"
        if [ -n "$current_finding_batch" ] && [ "$current_finding_batch" = "$last_finding_batch" ]; then
          same_feedback_count=$((same_feedback_count + 1))
        elif [ -z "$current_finding_batch" ] && [ -n "$previous_feedback" ] && [ "$reason" = "$previous_feedback" ]; then
          same_feedback_count=$((same_feedback_count + 1))
        else
          same_feedback_count=0
        fi
        if [ "$change_count" -gt 0 ] && [ "$same_feedback_count" -eq 0 ]; then
          stalled_attempts=0
          RECOVERY_NOTE=""
          progress_note="mudanças observadas em $change_count caminho(s) e novo feedback técnico"
        else
          stalled_attempts=$((stalled_attempts + 1))
          if [ "$change_count" -eq 0 ] && [ "$same_feedback_count" -gt 0 ]; then
            progress_note="nenhuma mudança no código e o mesmo feedback se repetiu"
          elif [ "$change_count" -eq 0 ]; then
            progress_note="nenhuma mudança no código foi observada"
          else
            progress_note="o feedback técnico se repetiu apesar de mudanças em $change_count caminho(s)"
          fi
        fi
        dashboard_gate "$phase_id" 3 fail "G3 · manager requested another implementation attempt"
        record_event "$phase_id" "$attempt" "RETRY" "$reason"
        record_manager_findings "$phase_id" "$attempt" "$MANAGER_AUDIT_REPORT" \
          "$CURRENT_EVIDENCE_FINGERPRINT" "$reason"
        localize_retry_tasks "$MANAGER_AUDIT_REPORT"
        dashboard_refresh_findings
        log "$phase_id retry requested: $reason ($progress_note; stalled=$stalled_attempts/$MAX_ATTEMPTS)"
        dashboard_set_phase "$phase_id" retry "$reason · $progress_note" "$(attempt_display "$attempt" "$stalled_attempts")"
        LAST_FEEDBACK="$reason"
        LAST_AGENT_LOG="${AGENT_LOG#"$PROJECT/"}"
        LAST_VALIDATION_LOG="${VALIDATION_LOG#"$PROJECT/"}"
        LAST_CHANGED_PATHS="${CHANGED_PATHS_FILE#"$PROJECT/"}"
        LAST_ATTEMPT_FAILURE="$reason"
        last_finding_batch="$current_finding_batch"
        previous_attempt="$attempt"

        if [ "$stalled_attempts" -ge "$MAX_ATTEMPTS" ]; then
          strategy_resets=$((strategy_resets + 1))
          if [ "$strategy_resets" -gt "$MAX_STRATEGY_RESETS" ]; then
            pause_reason="circuit breaker: sem progresso comprovável após $MAX_ATTEMPTS tentativa(s) consecutiva(s) e $MAX_STRATEGY_RESETS recuperação(ões); última análise: $reason"
            record_event "$phase_id" "$attempt" "PAUSED" "$pause_reason"
            dashboard_set_phase "$phase_id" paused "$pause_reason" "$(attempt_display "$attempt" "$stalled_attempts")"
            dashboard_finish paused
            wait_dashboard
            printf 'PAUSED: %s\n' "$pause_reason" >&2
            exit 2
          fi
          RECOVERY_NOTE="recuperação $strategy_resets/$MAX_STRATEGY_RESETS acionada pelo circuit breaker: $progress_note. Não repita a abordagem anterior."
          record_event "$phase_id" "$attempt" "STRATEGY_RESET" "$RECOVERY_NOTE"
          log "$phase_id strategy recovery $strategy_resets/$MAX_STRATEGY_RESETS: $RECOVERY_NOTE"
          stalled_attempts=0
          same_feedback_count=0
        fi
        attempt=$((attempt + 1))
        continue
        ;;
      *)
        manager_error="circuit breaker interno: gerente terminou sem decisão válida após as retentativas isoladas; log=${MANAGER_LOG#"$PROJECT/"}"
        dashboard_gate "$phase_id" 3 fail "G3 · manager retry circuit breaker"
        record_event "$phase_id" "$attempt" "BLOCKED" "$manager_error"
        dashboard_set_phase "$phase_id" blocked "$manager_error" "$(attempt_display "$attempt" "$stalled_attempts")"
        die "$phase_id blocked: $manager_error"
        ;;
    esac
  done
  [ "$completed" -eq 1 ] || die "$phase_id left the recovery loop without an accepted decision"
done <<< "$PHASES"

dashboard_finish complete
wait_dashboard
log "run complete: all pending phases were accepted"

log "run complete: $RUN_ID"
